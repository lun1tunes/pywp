        "asxy_ti3_a": (tan_dip * sin_inc * cos_azm - cos_inc) / 2.0,
        "asz_i": -sin_inc * cos_inc,
        "asz_a": tan_dip * sin_inc * cos_inc * sin_azm,
        "mbxy_ti1_a": -(cos_inc * sin_azm) / mtot_cos_dip,
