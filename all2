                        "background-color: rgba(34, 197, 94, 0.14); "
                        "font-weight: 600;"
                    ] * len(row)
                return [""] * len(row)

            table_payload = raw_df.style.apply(_highlight_edit_rows, axis=1)
        else:
            table_payload = raw_df
        st.dataframe(
            table_payload,
            width="stretch",
            hide_index=True,
