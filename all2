          0 1px 2px rgba(255,255,255,0.95),
          0 0 7px rgba(255,255,255,0.72);
        backdrop-filter: blur(2px);
      }

      .edit-delta-label:hover {
        background: rgba(255,255,255,0.28);
      }

      .edit-delta-label.is-dragging {
        cursor: grabbing;
        background: rgba(255,255,255,0.34);
      }

      .edit-delta-label .edit-delta-head {
        display: block;
        margin-bottom: 3px;
        color: rgba(15,23,42,0.86);
        font-family:
          Inter,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;
        font-size: 11px;
        font-weight: 700;
      }

      .edit-delta-label .edit-delta-row {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        white-space: nowrap;
      }

      .edit-delta-label .edit-delta-total {
        margin-top: 3px;
        padding-top: 3px;
        border-top: 1px solid rgba(15,23,42,0.12);
