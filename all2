                )
            previous_anchor_xyz = ptc_pad_state.pad_anchor_defaults(
                st.session_state,
                pad=selected_pad,
                anchor_mode=previous_anchor_mode,
            )
            next_anchor_xyz = ptc_pad_state.pad_anchor_defaults(
                st.session_state,
                pad=selected_pad,
                anchor_mode=anchor_mode,
            )
            current_anchor_xyz = (
