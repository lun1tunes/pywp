        function mergedRawBounds(boundsItems) {
          const items = Array.isArray(boundsItems) ? boundsItems : [boundsItems];
          let minX = Number.POSITIVE_INFINITY;
          let minY = Number.POSITIVE_INFINITY;
          let minZ = Number.POSITIVE_INFINITY;
          let maxX = Number.NEGATIVE_INFINITY;
          let maxY = Number.NEGATIVE_INFINITY;
          let maxZ = Number.NEGATIVE_INFINITY;
          let hasBounds = false;
          items.forEach((rawBounds) => {
            const bounds = normalizedRawBounds(rawBounds);
            if (!bounds) {
              return;
            }
            minX = Math.min(minX, Number(bounds.min[0]));
            minY = Math.min(minY, Number(bounds.min[1]));
            minZ = Math.min(minZ, Number(bounds.min[2]));
            maxX = Math.max(maxX, Number(bounds.max[0]));
            maxY = Math.max(maxY, Number(bounds.max[1]));
            maxZ = Math.max(maxZ, Number(bounds.max[2]));
            hasBounds = true;
          });
          if (!hasBounds) {
            return null;
          }
          return {
            min: [minX, minY, minZ],
            max: [maxX, maxY, maxZ],
          };
        }

        function activeEditWellFocusBounds() {
          const wellIndices = Array.from(selectedEditWellIndices || [])
            .filter((index) => Number.isInteger(index) && index >= 0);
          if (
            wellIndices.length === 0 &&
            Number.isInteger(selectedEditWellIndex) &&
            selectedEditWellIndex >= 0
          ) {
            wellIndices.push(selectedEditWellIndex);
          }
          return mergedRawBounds(
            wellIndices
              .map((index) => editWellTargetFocusBounds(index))
              .filter(Boolean),
          );
        }

        function editPadFocusBounds(index) {
          const padIndex = Number(index);
          if (!isValidEditPadIndex(padIndex)) {
            return null;
          }
          const padPoints = [
            editPadCurrentAnchors[padIndex],
            ...(editPadCurrentPoints[padIndex] || []),
          ].filter((point) =>
            Array.isArray(point) &&
            point.length >= 3 &&
            point.every((value) => Number.isFinite(Number(value))),
          );
          if (padPoints.length === 0) {
            return null;
          }
          const xs = padPoints.map((point) => Number(point[0]));
          const ys = padPoints.map((point) => Number(point[1]));
          const zs = padPoints.map((point) => Number(point[2]));
          const minX = Math.min(...xs);
          const maxX = Math.max(...xs);
          const minY = Math.min(...ys);
          const maxY = Math.max(...ys);
          const minZ = Math.min(...zs);
          const maxZ = Math.max(...zs);
          const radius = Math.max(
            Math.max(maxX - minX, maxY - minY, maxZ - minZ) * 0.12,
            maxSpan * 0.035,
            40.0,
          );
          return {
            min: [minX - radius, minY - radius, minZ - radius],
            max: [maxX + radius, maxY + radius, maxZ + radius],
          };
        }

        function ensureMiniMapContainsRawBounds(rawBounds) {
          if (!miniMapState.expanded) {
            return;
          }
          const normalizedBounds = normalizedRawBounds(rawBounds);
          if (!normalizedBounds) {
            return;
          }
          const rect = miniMapState.rect.width > 0
            ? miniMapState.rect
            : miniMapCanvasRect();
          if (!rect.width || !rect.height) {
            return;
          }
          const displayBounds = transformedBounds(normalizedBounds);
          const aspect = Math.max(rect.width / Math.max(rect.height, 1), 0.01);
          let viewHeight = Math.max(miniMapState.baseSpan / miniMapState.zoom, 1.0);
          let viewWidth = viewHeight * aspect;
          const worldPadding = Math.max(miniMapWorldPerPixel() * 24.0, 12.0);
          const requiredWidth = Math.max(
            displayBounds.max.x - displayBounds.min.x + worldPadding * 2.0,
            1.0,
          );
          const requiredHeight = Math.max(
            displayBounds.max.y - displayBounds.min.y + worldPadding * 2.0,
            1.0,
          );
          const requiredViewHeight = Math.max(requiredHeight, requiredWidth / aspect, 1.0);
          if (requiredViewHeight > viewHeight + 1e-6) {
            viewHeight = requiredViewHeight;
            viewWidth = viewHeight * aspect;
            miniMapState.baseSpan = Math.max(viewHeight * miniMapState.zoom, 1.0);
          }
          let centerX = miniMapState.target.x;
          let centerY = miniMapState.target.y;
          const halfWidth = viewWidth * 0.5;
          const halfHeight = viewHeight * 0.5;
          let left = centerX - halfWidth;
          let right = centerX + halfWidth;
          let bottom = centerY - halfHeight;
          let top = centerY + halfHeight;
          if (displayBounds.min.x < left + worldPadding) {
            centerX = displayBounds.min.x - worldPadding + halfWidth;
            left = centerX - halfWidth;
            right = centerX + halfWidth;
          }
          if (displayBounds.max.x > right - worldPadding) {
            centerX = displayBounds.max.x + worldPadding - halfWidth;
          }
          if (displayBounds.min.y < bottom + worldPadding) {
            centerY = displayBounds.min.y - worldPadding + halfHeight;
            bottom = centerY - halfHeight;
            top = centerY + halfHeight;
          }
          if (displayBounds.max.y > top - worldPadding) {
            centerY = displayBounds.max.y + worldPadding - halfHeight;
          }
          miniMapState.target.set(
            centerX,
            centerY,
            (displayBounds.min.z + displayBounds.max.z) * 0.5,
          );
          miniMapState.maxSpan = Math.max(
            miniMapState.maxSpan,
            displayBounds.max.x - displayBounds.min.x,
            displayBounds.max.y - displayBounds.min.y,
            displayBounds.max.z - displayBounds.min.z,
            1.0,
          );
        }

        function keepMiniMapOnActiveEditSelection() {
          if (!editModeActive) {
            return;
          }
          if (Number.isInteger(selectedEditPadIndex)) {
            ensureMiniMapContainsRawBounds(editPadFocusBounds(selectedEditPadIndex));
            return;
          }
          if (
            !Number.isInteger(selectedEditWellIndex) &&
            selectedEditWellIndices.size === 0
          ) {
            return;
          }
          ensureMiniMapContainsRawBounds(activeEditWellFocusBounds());
        }

        function updateMiniMapCamera(rect) {
          const safeRect = rect || miniMapCanvasRect();
          const aspect = Math.max(safeRect.width / Math.max(safeRect.height, 1), 0.01);
          const viewHeight = Math.max(miniMapState.baseSpan / miniMapState.zoom, 1.0);
          const viewWidth = viewHeight * aspect;
          miniMapCamera.left = -viewWidth * 0.5;
          miniMapCamera.right = viewWidth * 0.5;
          miniMapCamera.top = viewHeight * 0.5;
          miniMapCamera.bottom = -viewHeight * 0.5;
          miniMapCamera.near = 0.1;
          miniMapCamera.far = Math.max(miniMapState.maxSpan * 24.0, 5000.0);
          miniMapCamera.position.set(
            miniMapState.target.x,
            miniMapState.target.y,
            miniMapState.target.z + Math.max(miniMapState.maxSpan * 8.0, 1000.0),
          );
          miniMapCamera.lookAt(miniMapState.target);
          miniMapCamera.updateProjectionMatrix();
        }

        function isPointerInMiniMap(event) {
          if (!miniMapState.expanded) {
            return false;
          }
          const rect = miniMapCanvasRect();
          const canvasRect = renderer.domElement.getBoundingClientRect();
          const localX = Number(event.clientX || 0) - canvasRect.left;
          const localY = Number(event.clientY || 0) - canvasRect.top;
          const top = rect.canvasHeight - rect.y - rect.height;
          return (
            localX >= rect.x &&
            localX <= rect.x + rect.width &&
            localY >= top &&
            localY <= top + rect.height
          );
        }

        function miniMapWorldPerPixel() {
          const rect = miniMapState.rect.width > 0
            ? miniMapState.rect
            : miniMapCanvasRect();
          const viewHeight = Math.max(miniMapState.baseSpan / miniMapState.zoom, 1.0);
          return viewHeight / Math.max(rect.height, 1.0);
        }

        function miniMapWorldAtEvent(event) {
          const rect = miniMapCanvasRect();
          const canvasRect = renderer.domElement.getBoundingClientRect();
          const localX = Number(event.clientX || 0) - canvasRect.left;
          const localY = Number(event.clientY || 0) - canvasRect.top;
          const top = rect.canvasHeight - rect.y - rect.height;
          const normalizedX = (localX - rect.x) / Math.max(rect.width, 1.0) - 0.5;
          const normalizedY = 0.5 - (localY - top) / Math.max(rect.height, 1.0);
          const viewHeight = Math.max(miniMapState.baseSpan / miniMapState.zoom, 1.0);
          const viewWidth = viewHeight * (rect.width / Math.max(rect.height, 1.0));
          return new THREE.Vector3(
            miniMapState.target.x + normalizedX * viewWidth,
            miniMapState.target.y + normalizedY * viewHeight,
            miniMapState.target.z,
          );
        }

        function miniMapLocalAtEvent(event, rect) {
          const safeRect = rect || miniMapCanvasRect();
          const canvasRect = renderer.domElement.getBoundingClientRect();
          return {
            x: Number(event.clientX || 0) - canvasRect.left - safeRect.x,
            y:
              Number(event.clientY || 0) -
              canvasRect.top -
              (safeRect.canvasHeight - safeRect.y - safeRect.height),
          };
        }

        function miniMapLocalFromDisplayPoint(displayPosition, rect) {
          const safeRect = rect || miniMapCanvasRect();
          const aspect = Math.max(safeRect.width / Math.max(safeRect.height, 1), 0.01);
          const viewHeight = Math.max(miniMapState.baseSpan / miniMapState.zoom, 1.0);
          const viewWidth = viewHeight * aspect;
          const leftWorld = miniMapState.target.x - viewWidth * 0.5;
          const topWorld = miniMapState.target.y + viewHeight * 0.5;
          return {
            x: ((displayPosition.x - leftWorld) / viewWidth) * safeRect.width,
            y: ((topWorld - displayPosition.y) / viewHeight) * safeRect.height,
          };
        }

        function miniMapRulerRawPointAtEvent(event) {
          const worldPoint = miniMapWorldAtEvent(event);
          const rawPoint = dataPointFromDisplay(worldPoint);
          return {
            x: dataNumber(rawPoint[0], 0),
            y: dataNumber(rawPoint[1], 0),
          };
        }

        function miniMapRulerDisplayPoint(rawPoint) {
          return displayPoint([
            dataNumber(rawPoint && rawPoint.x, sceneOrigin.x),
            dataNumber(rawPoint && rawPoint.y, sceneOrigin.y),
            sceneOrigin.z,
          ]);
        }

        function miniMapRulerCurrentEndRaw() {
          if (
            miniMapRulerState.phase === "measuring" &&
            miniMapRulerState.previewRaw
          ) {
            return miniMapRulerState.previewRaw;
          }
          return miniMapRulerState.endRaw;
        }

        function miniMapRulerDistanceMeters(startRaw, endRaw) {
          if (!startRaw || !endRaw) {
            return 0.0;
          }
          return Math.hypot(
            dataNumber(endRaw.x, 0) - dataNumber(startRaw.x, 0),
            dataNumber(endRaw.y, 0) - dataNumber(startRaw.y, 0),
          );
        }

        function formatMiniMapDistanceMeters(distanceMeters) {
          const safeDistance = Math.max(Number(distanceMeters) || 0, 0);
          const rounded =
            safeDistance >= 1000.0
              ? Math.round(safeDistance)
              : Math.round(safeDistance * 10.0) / 10.0;
          const text =
            Math.abs(rounded - Math.round(rounded)) < 0.05
              ? String(Math.round(rounded))
              : rounded.toFixed(1);
          return `${text} м`;
        }

        function resetMiniMapRulerMeasurement() {
          miniMapRulerState.phase = "idle";
          miniMapRulerState.startRaw = null;
          miniMapRulerState.endRaw = null;
          miniMapRulerState.previewRaw = null;
        }

        function syncMiniMapRulerButton() {
          if (!miniMapRulerBtn) {
            return;
          }
          miniMapRulerBtn.classList.toggle("is-active", Boolean(miniMapRulerState.enabled));
          miniMapRulerBtn.setAttribute(
            "aria-pressed",
            miniMapRulerState.enabled ? "true" : "false",
          );
        }

        function setMiniMapRulerEnabled(enabled) {
          miniMapRulerState.enabled = Boolean(enabled);
          if (!miniMapRulerState.enabled) {
            resetMiniMapRulerMeasurement();
          }
          syncMiniMapRulerButton();
        }

        function updateMiniMapRulerOverlay() {
          if (
            !miniMapRulerLayer ||
            !miniMapRulerLine ||
            !miniMapRulerStart ||
            !miniMapRulerEnd ||
            !miniMapRulerLabel
          ) {
            return;
          }
          const overlayVisible =
            miniMapState.expanded && Boolean(miniMapRulerState.enabled);
          miniMapRulerLayer.classList.toggle("is-visible", overlayVisible);
          if (!overlayVisible) {
            miniMapRulerLine.style.display = "none";
            miniMapRulerStart.style.display = "none";
            miniMapRulerEnd.style.display = "none";
            miniMapRulerLabel.style.display = "none";
            miniMapRulerLayer.style.left = "";
            miniMapRulerLayer.style.top = "";
            miniMapRulerLayer.style.width = "";
            miniMapRulerLayer.style.height = "";
            return;
          }
          const rect = miniMapState.rect.width > 0
            ? miniMapState.rect
            : miniMapCanvasRect();
          miniMapRulerLayer.style.left = `${Math.round(rect.x)}px`;
          miniMapRulerLayer.style.top = `${Math.round(rect.canvasHeight - rect.y - rect.height)}px`;
          miniMapRulerLayer.style.width = `${Math.round(rect.width)}px`;
          miniMapRulerLayer.style.height = `${Math.round(rect.height)}px`;
          const startRaw = miniMapRulerState.startRaw;
          const endRaw = miniMapRulerCurrentEndRaw();
          if (!startRaw || !endRaw) {
            miniMapRulerLine.style.display = "none";
            miniMapRulerStart.style.display = "none";
            miniMapRulerEnd.style.display = "none";
            miniMapRulerLabel.style.display = "none";
            return;
          }
          const startLocal = miniMapLocalFromDisplayPoint(
            miniMapRulerDisplayPoint(startRaw),
            rect,
          );
          const endLocal = miniMapLocalFromDisplayPoint(
            miniMapRulerDisplayPoint(endRaw),
            rect,
          );
          if (
            !Number.isFinite(startLocal.x) ||
            !Number.isFinite(startLocal.y) ||
            !Number.isFinite(endLocal.x) ||
            !Number.isFinite(endLocal.y)
          ) {
            miniMapRulerLine.style.display = "none";
            miniMapRulerStart.style.display = "none";
            miniMapRulerEnd.style.display = "none";
            miniMapRulerLabel.style.display = "none";
            return;
          }
          const dx = endLocal.x - startLocal.x;
          const dy = endLocal.y - startLocal.y;
          const length = Math.hypot(dx, dy);
          const angleDeg = Math.atan2(dy, dx) * 180.0 / Math.PI;
          const distanceMeters = miniMapRulerDistanceMeters(startRaw, endRaw);
          miniMapRulerStart.style.display = "block";
          miniMapRulerStart.style.left = `${startLocal.x}px`;
          miniMapRulerStart.style.top = `${startLocal.y}px`;
          miniMapRulerEnd.style.display = "block";
          miniMapRulerEnd.style.left = `${endLocal.x}px`;
          miniMapRulerEnd.style.top = `${endLocal.y}px`;
          miniMapRulerLine.style.display = "block";
          miniMapRulerLine.style.left = `${startLocal.x}px`;
          miniMapRulerLine.style.top = `${startLocal.y}px`;
          miniMapRulerLine.style.width = `${length}px`;
          miniMapRulerLine.style.transform =
            `translate(0, -50%) rotate(${angleDeg}deg)`;
          miniMapRulerLabel.textContent = formatMiniMapDistanceMeters(distanceMeters);
          miniMapRulerLabel.style.display = "block";
          const normalX = length > 0.000001 ? -dy / length : 0.0;
          const normalY = length > 0.000001 ? dx / length : -1.0;
          const labelWidth = Math.max(Number(miniMapRulerLabel.offsetWidth) || 0, 1);
          const labelHeight = Math.max(Number(miniMapRulerLabel.offsetHeight) || 0, 1);
          const labelCenterX = (startLocal.x + endLocal.x) * 0.5 + normalX * 16.0;
          const labelCenterY = (startLocal.y + endLocal.y) * 0.5 + normalY * 16.0;
          const labelLeft = clampValue(
            labelCenterX,
            labelWidth * 0.5 + 4.0,
            Math.max(rect.width - labelWidth * 0.5 - 4.0, labelWidth * 0.5 + 4.0),
          );
          const labelTop = clampValue(
            labelCenterY,
            labelHeight * 0.5 + 4.0,
            Math.max(rect.height - labelHeight * 0.5 - 4.0, labelHeight * 0.5 + 4.0),
          );
          miniMapRulerLabel.style.left = `${labelLeft}px`;
          miniMapRulerLabel.style.top = `${labelTop}px`;
        }

        let bounds = transformedBounds(payload.bounds || {});
        let minBound = bounds.min;
        let maxBound = bounds.max;
        let center = new THREE.Vector3()
          .addVectors(minBound, maxBound)
          .multiplyScalar(0.5);
        let span = new THREE.Vector3().subVectors(maxBound, minBound);
        let maxSpan = Math.max(span.x, span.y, span.z, 1);
        let worldMarkerSize = Math.max(maxSpan * 0.008, 9.0);
        let axisLength = Math.max(maxSpan * 0.18, 40.0);

        function recomputeSceneMetrics(options) {
          sceneOrigin = rawBoundsCenter(payload.bounds || {});
          bounds = transformedBounds(payload.bounds || {});
          minBound = bounds.min;
          maxBound = bounds.max;
          center = new THREE.Vector3()
            .addVectors(minBound, maxBound)
            .multiplyScalar(0.5);
          span = new THREE.Vector3().subVectors(maxBound, minBound);
          maxSpan = Math.max(span.x, span.y, span.z, 1);
          worldMarkerSize = Math.max(maxSpan * 0.008, 9.0);
          axisLength = Math.max(maxSpan * 0.18, 40.0);
          if (!options || options.resetMiniMap !== false) {
            fitMiniMapToRawBounds(payload.bounds || {});
          }
        }

        recomputeSceneMetrics();

        function addMiniMapLabel(text, position, extraClassName, options) {
          if (!miniMapLabelLayer) {
            return null;
          }
          const labelRole = String((options && options.role) || "label");
          const element = document.createElement("div");
          element.className = String(extraClassName || "").trim();
          if (options && options.useHtml) {
            element.innerHTML = String(text || "");
          } else {
            element.textContent = String(text || "");
          }
          element.style.color = String((options && options.color) || "#0f172a");
          miniMapLabelLayer.appendChild(element);
          const labelItem = {
            element: element,
            position: position.clone(),
            offsetX: Number((options && options.offsetX) || 0),
            offsetY: Number((options && options.offsetY) || 0),
            role: labelRole,
            text: String(text || ""),
            visible: true,
          };
          miniMapLabels.push(labelItem);
          return labelItem;
        }

        function addSceneLabel(text, position, color, extraClassName, options) {
          const labelRole = String((options && options.role) || "label");
          const roleClassNames = [];
          if (
            labelRole === "well_label" ||
            labelRole === "pilot_point_label" ||
            labelRole === "reference_label" ||
            labelRole === "reference_label_optional"
          ) {
            roleClassNames.push("well-name-label");
          }
          if (labelRole === "reference_label" || labelRole === "reference_label_optional") {
            roleClassNames.push("reference-well-label");
          }
          const element = document.createElement("div");
          element.className =
            `scene-label ${roleClassNames.join(" ")} ${String(extraClassName || "").trim()}`.trim();
          element.textContent = String(text || "");
          element.style.color = String(color || "#0f172a");
          labelLayerElement.appendChild(element);
          const labelItem = {
            element: element,
            position: position.clone(),
            offsetX: Number((options && options.offsetX) || 0),
            offsetY: Number((options && options.offsetY) || 0),
            role: labelRole,
            text: String(text || ""),
            visible: true,
          };
          sceneLabels.push(labelItem);
          const shouldMirrorToMiniMap =
            miniMapLabelLayer &&
            (
              labelRole === "well_label" ||
              labelRole === "reference_label" ||
              labelRole === "reference_label_optional" ||
              labelRole === "edit_pad_label"
            );
          if (shouldMirrorToMiniMap) {
            const miniMapLabel = addMiniMapLabel(
              text,
              position,
              labelRole === "edit_pad_label"
                ? "minimap-edit-delta-label"
                : "minimap-well-label",
              {
                role: labelRole,
                useHtml: labelRole === "edit_pad_label",
                color: color,
                offsetX:
                  labelRole === "well_label"
                    ? 0
                    : Number((options && options.offsetX) || 0),
                offsetY:
                  labelRole === "well_label"
                    ? 0
                    : Number((options && options.offsetY) || 0),
              },
            );
            if (miniMapLabel) {
              miniMapLabel.sourceLabel = labelItem;
            }
          }
          return labelItem;
        }

        const axisOverlayDefinitions = [
          {
            key: "x",
            label: "X / East",
            color: "#16A34A",
            vector: new THREE.Vector3(1, 0, 0),
          },
          {
            key: "y",
            label: "Y / North",
            color: "#2563EB",
            vector: new THREE.Vector3(0, 1, 0),
          },
          {
            key: "z",
            label: "Z",
            color: "#DC2626",
            vector: new THREE.Vector3(0, 0, -1),
          },
        ];

        function updateAxesGizmo() {
          if (!axesGizmoElement) {
            return;
          }
          const width = Math.max(axesGizmoElement.clientWidth || 136, 136);
          const height = Math.max(axesGizmoElement.clientHeight || 118, 118);
          const centerX = 58;
          const centerY = 42;
          const radius = Math.min(width, height) * 0.34;
          const inverseCameraQuaternion = camera.quaternion.clone().invert();
          const axisItems = axisOverlayDefinitions.map((item) => {
            const projected = item.vector
              .clone()
              .applyQuaternion(inverseCameraQuaternion)
              .normalize();
            return {
              label: item.label,
              color: item.color,
              x: centerX + projected.x * radius,
              y: centerY - projected.y * radius,
              z: projected.z,
            };
          });
          axisItems.sort((left, right) => left.z - right.z);
          const lines = axisItems
            .map(
              (item) =>
                `<line class="axes-gizmo-line" x1="${centerX.toFixed(1)}" y1="${centerY.toFixed(1)}" x2="${item.x.toFixed(1)}" y2="${item.y.toFixed(1)}" stroke="${item.color}" opacity="${(item.z > 0 ? 1.0 : 0.72).toFixed(2)}"></line>`,
            )
            .join("");
          const labels = axisItems
            .map((item) => {
              const dx = item.x - centerX;
              const dy = item.y - centerY;
              const labelX = item.x + (Math.abs(dx) < 4 ? 0 : Math.sign(dx) * 7);
              const labelY = item.y + (Math.abs(dy) < 4 ? 0 : Math.sign(dy) * 7);
              const textAnchor =
                Math.abs(dx) < 6 ? "middle" : dx > 0 ? "start" : "end";
              return `<text class="axes-gizmo-label" x="${labelX.toFixed(1)}" y="${labelY.toFixed(1)}" fill="${item.color}" text-anchor="${textAnchor}">${item.label}</text>`;
            })
            .join("");
          axesGizmoElement.innerHTML =
            `<svg viewBox="0 0 ${width} ${height}" aria-hidden="true">` +
            `<circle class="axes-gizmo-center" cx="${centerX.toFixed(1)}" cy="${centerY.toFixed(1)}" r="3.2"></circle>` +
            lines +
            labels +
            `</svg>`;
        }

        const worldAxisRaycaster = new THREE.Raycaster();
        const worldAxisPointer = new THREE.Vector2();
        const worldAxisPlane = new THREE.Plane(new THREE.Vector3(0, 0, 1), 0);
        const worldAxisHitPoint = new THREE.Vector3();

        function worldAxisPlaneIntersectionRaw(ndcX, ndcY, rawZ) {
          const planeDisplayZ =
            ((Number(rawZ) - Number(sceneOrigin.z || 0)) * Z_DISPLAY_SIGN) /
            Math.max(worldAxisZScaleFactor(), 1.0);
          worldAxisPlane.constant = -planeDisplayZ;
          worldAxisPointer.set(Number(ndcX) || 0, Number(ndcY) || 0);
          worldAxisRaycaster.setFromCamera(worldAxisPointer, camera);
          if (!worldAxisRaycaster.ray.intersectPlane(worldAxisPlane, worldAxisHitPoint)) {
            return null;
          }
          const rawPoint = dataPointFromDisplay(worldAxisHitPoint);
          return [Number(rawPoint[0]) || 0, Number(rawPoint[1]) || 0, Number(rawZ) || 0];
        }

        function worldAxisNiceStep(rawValue) {
          const safeValue = Math.max(Number(rawValue) || 0, 0.000001);
          const exponent = Math.floor(Math.log10(safeValue));
          const base = Math.pow(10, exponent);
          const scaled = safeValue / base;
          if (scaled <= 1.0) {
            return 1.0 * base;
          }
          if (scaled <= 2.0) {
            return 2.0 * base;
          }
          if (scaled <= 5.0) {
            return 5.0 * base;
          }
          return 10.0 * base;
        }

        function worldAxisZScaleLabel() {
          return `1:${formatViewerZScaleFactor(worldAxisZScaleFactor())}`;
        }

        function worldAxisDisplayZ(rawZValue) {
          return (
            (Number(rawZValue) || 0) *
            Z_DISPLAY_SIGN /
            Math.max(worldAxisZScaleFactor(), 1.0)
          );
        }

        function formatWorldAxisValue(value, step) {
          const safeStep = Math.max(Math.abs(Number(step) || 0), 0.000001);
          const decimals =
            safeStep >= 10.0 ? 0 :
            safeStep >= 1.0 ? 1 :
            safeStep >= 0.1 ? 2 :
            3;
          return Number(value || 0).toFixed(decimals);
        }

        function formatWorldAxisDistance(rawDistance) {
          const safeDistance = Math.abs(Number(rawDistance) || 0);
          const decimals =
            safeDistance >= 100.0 ? 0 :
            safeDistance >= 10.0 ? 1 :
            safeDistance >= 1.0 ? 2 :
            3;
          return `${String(Number(safeDistance.toFixed(decimals))).replace(".", ",")} м`;
        }

        function worldAxisSubdivisionForPixelSpan(pixelSpan) {
          const safeSpan = Math.max(Number(pixelSpan) || 0, 0);
          if (safeSpan >= 560.0) {
            return 10;
          }
          if (safeSpan >= 300.0) {
            return 5;
          }
          if (safeSpan >= 150.0) {
            return 2;
          }
          return 1;
        }

        function worldAxisAdaptiveMajorStep(
          unitsPerPixel,
          coverageStep,
          targetPixelSpan,
          minRawStep,
          scaleFactor,
        ) {
          const safeUnitsPerPixel = Math.max(Number(unitsPerPixel) || 0, 0.000001);
          const safeCoverageStep = Math.max(Number(coverageStep) || 0, 0.000001);
          const safePixelSpan = Math.max(Number(targetPixelSpan) || 0, 1.0);
          const safeMinRawStep = Math.max(Number(minRawStep) || 0, 0.000001);
          const safeScaleFactor = Math.max(Number(scaleFactor) || 1.0, 1.0);
          const desiredRawStep = Math.max(
            safeUnitsPerPixel * safePixelSpan * safeScaleFactor,
            safeMinRawStep,
          );
          return Math.min(safeCoverageStep, worldAxisNiceStep(desiredRawStep));
        }

        function worldAxisAdaptiveZMajorStep(
          unitsPerPixel,
          coverageStep,
          targetPixelSpan,
          minRawStep,
          scaleFactor,
        ) {
          const safeUnitsPerPixel = Math.max(Number(unitsPerPixel) || 0, 0.000001);
          const safeCoverageStep = Math.max(Number(coverageStep) || 0, 0.000001);
          const safePixelSpan = Math.max(Number(targetPixelSpan) || 0, 1.0);
          const safeMinRawStep = Math.max(Number(minRawStep) || 0, 0.000001);
          const safeScaleFactor = Math.max(Number(scaleFactor) || 1.0, 1.0);
          const desiredRawStep = Math.max(
            safeUnitsPerPixel * safePixelSpan * safeScaleFactor,
            safeMinRawStep,
          );
          const allowedSteps = [10000.0, 5000.0, 2000.0, 1000.0, 500.0, 100.0, 50.0];
          let coarsestWithinCoverage = 0.0;
          let selectedStep = 0.0;
          allowedSteps.forEach((step) => {
            if (step > safeCoverageStep + 1e-6) {
              return;
            }
            if (coarsestWithinCoverage <= 0.0) {
              coarsestWithinCoverage = step;
            }
            if (step + 1e-6 >= desiredRawStep) {
              selectedStep = step;
            }
          });
          if (selectedStep > 0.0) {
            return selectedStep;
          }
          if (coarsestWithinCoverage > 0.0) {
            return coarsestWithinCoverage;
          }
          return Math.min(safeCoverageStep, worldAxisNiceStep(desiredRawStep));
        }

        function clearWorldAxisGeometry() {
          while (worldAxisOverlay.group.children.length > 0) {
            const child =
              worldAxisOverlay.group.children[worldAxisOverlay.group.children.length - 1];
            if (!child) {
              continue;
            }
            worldAxisOverlay.group.remove(child);
            if (child.geometry && typeof child.geometry.dispose === "function") {
              child.geometry.dispose();
            }
            if (child.material) {
              if (Array.isArray(child.material)) {
                child.material.forEach((material) => {
                  if (material && typeof material.dispose === "function") {
                    material.dispose();
                  }
                });
              } else if (typeof child.material.dispose === "function") {
                child.material.dispose();
              }
            }
          }
        }

        function normalizedRawBounds(rawBounds) {
          if (!rawBounds || typeof rawBounds !== "object") {
            return null;
          }
          const rawMin = Array.isArray(rawBounds.min) ? rawBounds.min : null;
          const rawMax = Array.isArray(rawBounds.max) ? rawBounds.max : null;
          if (!rawMin || !rawMax || rawMin.length < 3 || rawMax.length < 3) {
            return null;
          }
          const minX = dataNumber(rawMin[0], 0);
          const minY = dataNumber(rawMin[1], 0);
          const minZ = dataNumber(rawMin[2], 0);
          const maxX = dataNumber(rawMax[0], minX);
          const maxY = dataNumber(rawMax[1], minY);
          const maxZ = dataNumber(rawMax[2], minZ);
          return {
            min: [
              Math.min(minX, maxX),
              Math.min(minY, maxY),
              Math.min(minZ, maxZ),
            ],
            max: [
              Math.max(minX, maxX),
              Math.max(minY, maxY),
              Math.max(minZ, maxZ),
            ],
          };
        }

        function worldAxisDefaultPadFocusId() {
          return worldAxisPadFocusIds.length > 0
            ? String(worldAxisPadFocusIds[0] || "")
            : "";
        }

        function worldAxisPadFocusIdForFocusId(focusId) {
          const normalizedId = String(focusId || "").trim();
          if (!normalizedId) {
            return "";
          }
          if (worldAxisFocusPadById.has(normalizedId)) {
            return String(worldAxisFocusPadById.get(normalizedId) || "");
          }
          return normalizedId.startsWith("pad::") ? normalizedId : "";
        }

        function worldAxisRawBoundsForPadFocusId(focusId) {
          const normalizedFocusId = String(focusId || "").trim();
          if (!normalizedFocusId) {
            return null;
          }
          return normalizedRawBounds(focusTargets[normalizedFocusId]);
        }

        function worldAxisCurrentRawBounds() {
          return (
            worldAxisRawBoundsForPadFocusId(worldAxisOverlay.activePadFocusId) ||
            normalizedRawBounds(payload.bounds) || {
              min: [0.0, 0.0, 0.0],
              max: [1000.0, 1000.0, 1000.0],
            }
          );
        }

        function worldAxisPlaneRawZ(rawBounds) {
          const bounds = normalizedRawBounds(rawBounds) || worldAxisCurrentRawBounds();
          const rawMax = Array.isArray(bounds.max) ? bounds.max : [0, 0, 0];
          const deepestRawZ = dataNumber(rawMax[2], 0);
          const roundStep = Math.max(Number(WORLD_AXIS_PLANE_Z_ROUND_STEP) || 100.0, 1.0);
          const roundedRawZ = Math.ceil(deepestRawZ / roundStep) * roundStep;
          if (!Number.isFinite(roundedRawZ)) {
            return 0.0;
          }
          return roundedRawZ <= deepestRawZ + 1e-6
            ? roundedRawZ + roundStep
            : roundedRawZ;
        }

        function worldAxisTopRawZ(rawBounds) {
          const bounds = normalizedRawBounds(rawBounds) || worldAxisCurrentRawBounds();
          const rawMin = Array.isArray(bounds.min) ? bounds.min : [0, 0, 0];
          const shallowestRawZ = dataNumber(rawMin[2], 0);
          const roundStep = Math.max(Number(WORLD_AXIS_PLANE_Z_ROUND_STEP) || 100.0, 1.0);
          const roundedRawZ = Math.floor(shallowestRawZ / roundStep) * roundStep;
          if (!Number.isFinite(roundedRawZ)) {
            return 0.0;
          }
          return Math.min(roundedRawZ, 0.0);
        }

        function worldAxisRawLevelMatches(leftRawZ, rightRawZ) {
          return Math.abs((Number(leftRawZ) || 0) - (Number(rightRawZ) || 0)) <= 1e-6;
        }

        function worldAxisMajorRawZValues(planeRawZ, topRawZ, zStep) {
          const values = [];
          const safeStep = Math.max(Number(zStep) || 0, 0.000001);
          const safeTopRawZ = Math.min(Number(topRawZ) || 0, 0.0);
          const bottomRawZ =
            Math.floor(Math.max(Number(planeRawZ) || 0, 0.0) / safeStep) * safeStep;
          for (let rawZ = bottomRawZ; rawZ >= safeTopRawZ; rawZ -= safeStep) {
            values.push(rawZ);
          }
          if (!values.some((rawZ) => worldAxisRawLevelMatches(rawZ, 0.0))) {
            values.push(0.0);
          }
          if (!values.some((rawZ) => worldAxisRawLevelMatches(rawZ, safeTopRawZ))) {
            values.push(safeTopRawZ);
          }
          values.sort((leftRawZ, rightRawZ) => rightRawZ - leftRawZ);
          return values;
        }

        function worldAxisMinorTickSpecs(planeRawZ, topRawZ, zStep, zMinorSubdivision) {
          const specs = [];
          const safeStep = Math.max(Number(zStep) || 0, 0.000001);
          const safeSubdivision = Math.max(Math.round(Number(zMinorSubdivision) || 1), 1);
          const tickStep = safeStep / safeSubdivision;
          const safeTopRawZ = Math.min(Number(topRawZ) || 0, 0.0);
          const bottomRawZ =
            Math.floor(Math.max(Number(planeRawZ) || 0, 0.0) / tickStep) * tickStep;
          for (let rawZ = bottomRawZ; rawZ >= safeTopRawZ; rawZ -= tickStep) {
            const major =
              Math.abs(
                rawZ - Math.round(rawZ / safeStep) * safeStep,
              ) <= 1e-6;
            specs.push({
              rawZ: rawZ,
              major: major,
            });
          }
          if (!specs.some((item) => worldAxisRawLevelMatches(item.rawZ, 0.0))) {
            specs.push({
              rawZ: 0.0,
              major: true,
            });
          }
          if (!specs.some((item) => worldAxisRawLevelMatches(item.rawZ, safeTopRawZ))) {
            specs.push({
              rawZ: safeTopRawZ,
              major:
                Math.abs(
                  safeTopRawZ - Math.round(safeTopRawZ / safeStep) * safeStep,
                ) <= 1e-6,
            });
          }
          specs.sort((leftItem, rightItem) => rightItem.rawZ - leftItem.rawZ);
          return specs;
        }

        function worldAxisBaseAnchorForBounds(rawBounds) {
          const bounds = normalizedRawBounds(rawBounds) || worldAxisCurrentRawBounds();
          return {
            x: (dataNumber(bounds.min[0], 0) + dataNumber(bounds.max[0], 0)) * 0.5,
            y: (dataNumber(bounds.min[1], 0) + dataNumber(bounds.max[1], 0)) * 0.5,
          };
        }

        function worldAxisResolvedAnchorRaw(xyStep, xTickCount, yTickCount) {
          const centeredX =
            dataNumber(worldAxisOverlay.baseAnchorRaw.x, 0) +
            dataNumber(worldAxisOverlay.dragOffsetRaw.x, 0);
          const centeredY =
            dataNumber(worldAxisOverlay.baseAnchorRaw.y, 0) +
            dataNumber(worldAxisOverlay.dragOffsetRaw.y, 0);
          if (
            !Number.isFinite(Number(xyStep)) ||
            !Number.isFinite(Number(xTickCount)) ||
            !Number.isFinite(Number(yTickCount))
          ) {
            return {
              x: centeredX,
              y: centeredY,
            };
          }
          return {
            x: centeredX - (Number(xyStep) * Number(xTickCount)) * 0.5,
            y: centeredY - (Number(xyStep) * Number(yTickCount)) * 0.5,
          };
        }

        function setWorldAxisActivePadFocus(focusId, options) {
          const padFocusId =
            worldAxisPadFocusIdForFocusId(focusId) || worldAxisDefaultPadFocusId();
          const activeBounds =
            worldAxisRawBoundsForPadFocusId(padFocusId) || normalizedRawBounds(payload.bounds);
          worldAxisOverlay.activePadFocusId = activeBounds ? padFocusId : "";
          worldAxisOverlay.activeBoundsRaw = activeBounds;
          worldAxisOverlay.baseAnchorRaw = worldAxisBaseAnchorForBounds(activeBounds);
          if (!options || options.resetOffset !== false) {
            worldAxisOverlay.dragOffsetRaw = { x: 0.0, y: 0.0 };
          }
          worldAxisOverlay.anchorRaw = worldAxisResolvedAnchorRaw();
          worldAxisOverlay.signature = "";
        }

        function syncWorldAxisActivePadFocus(options) {
          const currentBounds = worldAxisRawBoundsForPadFocusId(worldAxisOverlay.activePadFocusId);
          if (currentBounds && (!options || options.resetOffset !== true)) {
            worldAxisOverlay.activeBoundsRaw = currentBounds;
            worldAxisOverlay.baseAnchorRaw = worldAxisBaseAnchorForBounds(currentBounds);
            worldAxisOverlay.anchorRaw = worldAxisResolvedAnchorRaw();
            return;
          }
          setWorldAxisActivePadFocus(worldAxisOverlay.activePadFocusId, options);
        }

        function ensureWorldAxisLabels(count) {
          while (worldAxisOverlay.labels.length < count) {
            worldAxisOverlay.labels.push(
              addSceneLabel(
                "",
                new THREE.Vector3(0, 0, 0),
                "#5b6472",
                "world-axis-label",
                { role: "world_axis_overlay", offsetX: 0, offsetY: 0 },
              ),
            );
          }
          while (worldAxisOverlay.labels.length > count) {
            const item = worldAxisOverlay.labels.pop();
            if (!item) {
              continue;
            }
            item.visible = false;
            if (item.element && item.element.parentNode) {
              item.element.parentNode.removeChild(item.element);
            }
            const itemIndex = sceneLabels.indexOf(item);
            if (itemIndex >= 0) {
              sceneLabels.splice(itemIndex, 1);
            }
          }
        }

        function worldAxisDepthRangeRaw() {
          const rawBounds = worldAxisCurrentRawBounds();
          const planeZ = worldAxisPlaneRawZ(rawBounds);
          const topZ = worldAxisTopRawZ(rawBounds);
          return Math.max(planeZ - Math.min(topZ, planeZ), 0.0);
        }

        function worldAxisViewMetrics() {
          syncWorldAxisActivePadFocus({ resetOffset: false });
          const planeRawZ = worldAxisPlaneRawZ(worldAxisCurrentRawBounds());
          const anchorRaw = worldAxisResolvedAnchorRaw();
          worldAxisOverlay.anchorRaw = anchorRaw;
          const anchorDisplay = displayPoint([
            anchorRaw.x,
            anchorRaw.y,
            planeRawZ,
          ]);
          const unitsPerPixel = worldUnitsPerPixelAt(anchorDisplay);
          if (!Number.isFinite(unitsPerPixel) || unitsPerPixel <= 0.0) {
            const fallbackSpan = Math.max(maxSpan * 0.65, 100.0);
            return {
              anchorRaw: {
                x: anchorRaw.x,
                y: anchorRaw.y,
              },
              unitsPerPixel: fallbackSpan / Math.max(renderer.domElement.clientHeight || 1, 1),
            };
          }
          return {
            anchorRaw: {
              x: anchorRaw.x,
              y: anchorRaw.y,
            },
            unitsPerPixel: unitsPerPixel,
          };
        }

        function pushWorldAxisSegment(positions, start, end) {
          positions.push(
            Number(start[0]) || 0,
            Number(start[1]) || 0,
            Number(start[2]) || 0,
            Number(end[0]) || 0,
            Number(end[1]) || 0,
            Number(end[2]) || 0,
          );
        }

        function createWorldAxisLineSegments(positions, color, opacity, renderOrder) {
          const geometry = new THREE.BufferGeometry();
          geometry.setAttribute(
            "position",
            new THREE.Float32BufferAttribute(new Float32Array(positions), 3),
          );
          const material = new THREE.LineBasicMaterial({
            color: color,
            transparent: true,
            opacity: opacity,
            depthTest: false,
            depthWrite: false,
          });
          const lineSegments = new THREE.LineSegments(geometry, material);
          lineSegments.renderOrder = renderOrder;
          return lineSegments;
        }

        function buildWorldAxisLabelSpecs(
          planeRawZ,
          topRawZ,
          xyStep,
          zStep,
          xTickCount,
          yTickCount,
          zMajorRawValues,
          showXyStepLabels,
        ) {
          const xDirection = 1.0;
          const yDirection = 1.0;
          const xMax = xyStep * xTickCount * xDirection;
          const yMax = xyStep * yTickCount * yDirection;
          const zMax = Math.max(Number(planeRawZ) - Number(topRawZ), 0.0);
          const zScaleFactor = worldAxisZScaleFactor();
          const labelSpecs = [];
          for (let xIndex = 0; xIndex <= xTickCount; xIndex += 1) {
            const xValue = xyStep * xIndex * xDirection;
            labelSpecs.push({
              text: formatWorldAxisValue(
                worldAxisOverlay.anchorRaw.x + xValue,
                xyStep,
              ),
              color: "#5b6472",
              localPosition: new THREE.Vector3(xValue, yMax, 0),
              offsetX: 0,
              offsetY: -12,
            });
          }
          labelSpecs.push({
            text: formatWorldAxisValue(
              worldAxisOverlay.anchorRaw.y,
              xyStep,
            ),
            color: "#5b6472",
            localPosition: new THREE.Vector3(0, 0, 0),
            offsetX: -14,
            offsetY: 0,
          });
          labelSpecs.push({
            text: formatWorldAxisValue(
              planeRawZ,
              zStep,
            ),
            color: "#5b6472",
            localPosition: new THREE.Vector3(0, 0, 0),
            offsetX: 12,
            offsetY: 0,
          });
          for (let yIndex = 1; yIndex <= yTickCount; yIndex += 1) {
            const yValue = xyStep * yIndex * yDirection;
            labelSpecs.push({
              text: formatWorldAxisValue(
                worldAxisOverlay.anchorRaw.y + yValue,
                xyStep,
              ),
              color: "#5b6472",
              localPosition: new THREE.Vector3(0, yValue, 0),
              offsetX: -10,
              offsetY: 0,
            });
          }
          if (showXyStepLabels) {
            const xyStepLabel = formatWorldAxisDistance(xyStep);
            for (let xIndex = 0; xIndex < xTickCount; xIndex += 1) {
              const xMid = xyStep * (xIndex + 0.5) * xDirection;
              labelSpecs.push({
                text: xyStepLabel,
                color: "#6b7ea6",
                localPosition: new THREE.Vector3(xMid, yMax, 0),
                offsetX: 0,
                offsetY: 12,
              });
            }
            for (let yIndex = 0; yIndex < yTickCount; yIndex += 1) {
              const yMid = xyStep * (yIndex + 0.5) * yDirection;
              labelSpecs.push({
                text: xyStepLabel,
                color: "#6b7ea6",
                localPosition: new THREE.Vector3(0, yMid, 0),
                offsetX: 12,
                offsetY: 0,
              });
            }
          }
          const zLabelEvery = Math.max(
            1,
            Math.ceil(
              zMajorRawValues.length /
              Math.max(Math.floor(Math.abs(worldAxisDisplayZ(-zMax)) / 54.0), 3),
            ),
          );
          const pushZAxisCoordinateLabels = (
            axisLocalX,
            axisLocalY,
            coordinateOffsetX,
            coordinateOffsetY,
            includeBaseLabel,
          ) => {
            if (includeBaseLabel) {
              labelSpecs.push({
                text: formatWorldAxisValue(
                  planeRawZ,
                  zStep,
                ),
                color: "#5b6472",
                localPosition: new THREE.Vector3(axisLocalX, axisLocalY, 0),
                offsetX: coordinateOffsetX,
                offsetY: coordinateOffsetY,
              });
            }
            zMajorRawValues.forEach((rawZValue, zIndex) => {
              const isTop = worldAxisRawLevelMatches(rawZValue, topRawZ);
              const isZero = worldAxisRawLevelMatches(rawZValue, 0.0);
              if (
                !isTop &&
                !isZero &&
                zIndex !== zMajorRawValues.length - 1 &&
                zIndex % zLabelEvery !== 0
              ) {
                return;
              }
              const distanceFromPlane = Number(planeRawZ) - Number(rawZValue);
              if (distanceFromPlane <= 0.0) {
                return;
              }
              labelSpecs.push({
                text: formatWorldAxisValue(
                  rawZValue,
                  zStep,
                ),
                color: "#5b6472",
                localPosition: new THREE.Vector3(
                  axisLocalX,
                  axisLocalY,
                  worldAxisDisplayZ(-distanceFromPlane),
                ),
                offsetX: coordinateOffsetX,
                offsetY: coordinateOffsetY,
              });
            });
          };
          pushZAxisCoordinateLabels(0, 0, 10, 0, false);
          pushZAxisCoordinateLabels(xMax, yMax, 10, 0, true);
          pushZAxisCoordinateLabels(0, yMax, 14, 0, true);
          const pushZAxisTitleLabel = (axisLocalX, axisLocalY, offsetX, offsetY) => {
            labelSpecs.push({
              text: "Z",
              color: "#6b7280",
              localPosition: new THREE.Vector3(
                axisLocalX,
                axisLocalY,
                worldAxisDisplayZ(-zMax),
              ),
              offsetX: offsetX,
              offsetY: offsetY - 10,
            });
          };
          labelSpecs.push({
            text: "X",
            color: "#6b7280",
            localPosition: new THREE.Vector3(xMax, yMax, 0),
            offsetX: 10,
            offsetY: -2,
          });
          labelSpecs.push({
            text: "Y",
            color: "#6b7280",
            localPosition: new THREE.Vector3(0, yMax, 0),
            offsetX: -2,
            offsetY: 12,
          });
          pushZAxisTitleLabel(0, 0, 8, 0);
          pushZAxisTitleLabel(xMax, yMax, 8, 0);
          pushZAxisTitleLabel(0, yMax, 16, 0);
          return labelSpecs;
        }

        function rebuildWorldAxisGeometry() {
          const metrics = worldAxisViewMetrics();
          const activeBounds = worldAxisCurrentRawBounds();
          const planeRawZ = worldAxisPlaneRawZ(activeBounds);
          const topRawZ = worldAxisTopRawZ(activeBounds);
          const xDirection = 1.0;
          const yDirection = 1.0;
          const xSpanRaw = Math.max(
            dataNumber(activeBounds.max[0], 0) - dataNumber(activeBounds.min[0], 0),
            1.0,
          );
          const ySpanRaw = Math.max(
            dataNumber(activeBounds.max[1], 0) - dataNumber(activeBounds.min[1], 0),
            1.0,
          );
          const xyCoverageStep = worldAxisNiceStep(
            Math.max(xSpanRaw, ySpanRaw, 40.0) / WORLD_AXIS_GRID_SQUARES_PER_SIDE,
          );
          const xyCoverageExtentRaw =
            xyCoverageStep * WORLD_AXIS_GRID_SQUARES_PER_SIDE;
          const xyStep = worldAxisAdaptiveMajorStep(
            metrics.unitsPerPixel,
            xyCoverageStep,
            132.0,
            100.0,
            1.0,
          );
          const xTickCount = Math.max(
            1,
            Math.round(
              xyCoverageExtentRaw /
                Math.max(Number(xyStep) || 0.000001, 0.000001),
            ),
          );
          const yTickCount = Math.max(
            1,
            Math.round(
              xyCoverageExtentRaw /
                Math.max(Number(xyStep) || 0.000001, 0.000001),
            ),
          );
          const zCoverageStep = worldAxisNiceStep(
            Math.max(worldAxisDepthRangeRaw() / 5.0, 1000.0)
          );
          const zStep = worldAxisAdaptiveZMajorStep(
            metrics.unitsPerPixel,
            zCoverageStep,
            132.0,
            50.0,
            worldAxisZScaleFactor(),
          );
          const zLength = Math.max(Number(planeRawZ) - Number(topRawZ), 0.0);
          const zDisplayLength = Math.abs(worldAxisDisplayZ(-zLength));
          const approxZPixelLength =
            zDisplayLength / Math.max(Number(metrics.unitsPerPixel) || 0.000001, 0.000001);
          const xyMajorPixelSpan =
            xyStep / Math.max(Number(metrics.unitsPerPixel) || 0.000001, 0.000001);
          const zMajorPixelSpan =
            Math.abs(worldAxisDisplayZ(-zStep)) /
            Math.max(Number(metrics.unitsPerPixel) || 0.000001, 0.000001);
          const xyMinorSubdivision = worldAxisSubdivisionForPixelSpan(xyMajorPixelSpan);
          const zMinorSubdivision = worldAxisSubdivisionForPixelSpan(zMajorPixelSpan);
          const xyTickStep = xyStep / xyMinorSubdivision;
          const showXyStepLabels = xyMajorPixelSpan >= 86.0;
          const xMin = Math.min(0.0, xyStep * xTickCount * xDirection);
          const xMax = Math.max(0.0, xyStep * xTickCount * xDirection);
          const yMin = Math.min(0.0, xyStep * yTickCount * yDirection);
          const yMax = Math.max(0.0, xyStep * yTickCount * yDirection);
          const signature = [
            xyStep.toFixed(6),
            zStep.toFixed(6),
            xTickCount,
            yTickCount,
            xyMinorSubdivision,
            zMinorSubdivision,
            showXyStepLabels ? 1 : 0,
            worldAxisZScaleFactor().toFixed(3),
            planeRawZ.toFixed(3),
            topRawZ.toFixed(3),
            dataNumber(activeBounds.min[0], 0).toFixed(3),
            dataNumber(activeBounds.min[1], 0).toFixed(3),
            dataNumber(activeBounds.min[2], 0).toFixed(3),
            dataNumber(activeBounds.max[0], 0).toFixed(3),
            dataNumber(activeBounds.max[1], 0).toFixed(3),
            dataNumber(activeBounds.max[2], 0).toFixed(3),
          ].join("|");
          const gridAnchorRaw = worldAxisResolvedAnchorRaw(
            xyStep,
            xTickCount,
            yTickCount,
          );
          worldAxisOverlay.anchorRaw = {
            x: Number(gridAnchorRaw.x) || 0,
            y: Number(gridAnchorRaw.y) || 0,
          };
          if (worldAxisOverlay.signature === signature) {
            updateWorldAxisLabelsPosition();
            return;
          }
          const zMajorRawValues = worldAxisMajorRawZValues(planeRawZ, topRawZ, zStep);
          const zTickSpecs = worldAxisMinorTickSpecs(
            planeRawZ,
            topRawZ,
            zStep,
            zMinorSubdivision,
          );
          const labelSpecs = buildWorldAxisLabelSpecs(
            planeRawZ,
            topRawZ,
            xyStep,
            zStep,
            xTickCount,
            yTickCount,
            zMajorRawValues,
            showXyStepLabels,
          );
          worldAxisOverlay.signature = signature;
          clearWorldAxisGeometry();

          const gridPositions = [];
          const minorGridPositions = [];
          for (let xIndex = 0; xIndex <= xTickCount; xIndex += 1) {
            const xValue = xyStep * xIndex * xDirection;
            pushWorldAxisSegment(
              gridPositions,
              [xValue, yMin, 0],
              [xValue, yMax, 0],
            );
          }
          for (let yIndex = 0; yIndex <= yTickCount; yIndex += 1) {
            const yValue = xyStep * yIndex * yDirection;
            pushWorldAxisSegment(
              gridPositions,
              [xMin, yValue, 0],
              [xMax, yValue, 0],
            );
          }
          for (let xIndex = 0; xIndex <= xTickCount; xIndex += 1) {
            const xValue = xyStep * xIndex * xDirection;
            pushWorldAxisSegment(
              gridPositions,
              [xValue, yMax, 0],
              [xValue, yMax, worldAxisDisplayZ(-zLength)],
            );
          }
          for (let yIndex = 0; yIndex <= yTickCount; yIndex += 1) {
            const yValue = xyStep * yIndex * yDirection;
            pushWorldAxisSegment(
              gridPositions,
              [0, yValue, 0],
              [0, yValue, worldAxisDisplayZ(-zLength)],
            );
          }
          zTickSpecs.forEach((tickSpec) => {
            if (tickSpec.major) {
              return;
            }
            if (
              Number(tickSpec.rawZ) < 0.0 &&
              !worldAxisRawLevelMatches(tickSpec.rawZ, 0.0)
            ) {
              return;
            }
            const distanceFromPlane = Number(planeRawZ) - Number(tickSpec.rawZ);
            if (distanceFromPlane <= 0.0) {
              return;
            }
            const zValue = worldAxisDisplayZ(-distanceFromPlane);
            pushWorldAxisSegment(
              minorGridPositions,
              [xMin, yMax, zValue],
              [xMax, yMax, zValue],
            );
            pushWorldAxisSegment(
              minorGridPositions,
              [0, yMin, zValue],
              [0, yMax, zValue],
            );
          });
          zMajorRawValues.forEach((rawZValue) => {
            if (
              Number(rawZValue) < 0.0 &&
              !worldAxisRawLevelMatches(rawZValue, 0.0)
            ) {
              return;
            }
            const distanceFromPlane = Number(planeRawZ) - Number(rawZValue);
            if (distanceFromPlane <= 0.0) {
              return;
            }
            const zValue = worldAxisDisplayZ(-distanceFromPlane);
            pushWorldAxisSegment(
              gridPositions,
              [xMin, yMax, zValue],
              [xMax, yMax, zValue],
            );
            pushWorldAxisSegment(
              gridPositions,
              [0, yMin, zValue],
              [0, yMax, zValue],
            );
          });

          const axisPositions = [];
          pushWorldAxisSegment(axisPositions, [xMin, yMax, 0], [xMax, yMax, 0]);
          pushWorldAxisSegment(axisPositions, [0, yMin, 0], [0, yMax, 0]);
          pushWorldAxisSegment(
            axisPositions,
            [0, 0, 0],
            [0, 0, worldAxisDisplayZ(-zLength)],
          );
          pushWorldAxisSegment(
            axisPositions,
            [xMax, yMax, 0],
            [xMax, yMax, worldAxisDisplayZ(-zLength)],
          );
          pushWorldAxisSegment(
            axisPositions,
            [0, yMax, 0],
            [0, yMax, worldAxisDisplayZ(-zLength)],
          );
          const xyTickMinorHalf = Math.max(Math.min(xyStep * 0.03, 9.0), 3.0);
          const xyTickMajorHalf = xyTickMinorHalf * 1.6;
          for (
            let xTickIndex = 1;
            xTickIndex <= xTickCount * xyMinorSubdivision;
            xTickIndex += 1
          ) {
            const xValue = xyTickStep * xTickIndex * xDirection;
            const tickHalf =
              xTickIndex % xyMinorSubdivision === 0
                ? xyTickMajorHalf
                : xyTickMinorHalf;
            pushWorldAxisSegment(
              axisPositions,
              [xValue, yMax - tickHalf, 0],
              [xValue, yMax + tickHalf, 0],
            );
          }
          for (
            let yTickIndex = 1;
            yTickIndex <= yTickCount * xyMinorSubdivision;
            yTickIndex += 1
          ) {
            const yValue = xyTickStep * yTickIndex * yDirection;
            const tickHalf =
              yTickIndex % xyMinorSubdivision === 0
                ? xyTickMajorHalf
                : xyTickMinorHalf;
            pushWorldAxisSegment(
              axisPositions,
              [-tickHalf, yValue, 0],
              [tickHalf, yValue, 0],
            );
          }
          const zTickMinorHalf = Math.max(Math.min(xyStep * 0.06, 8.0), 2.5);
          const zTickMajorHalf = zTickMinorHalf * 1.6;
          zTickSpecs.forEach((tickSpec) => {
            const distanceFromPlane = Number(planeRawZ) - Number(tickSpec.rawZ);
            if (distanceFromPlane <= 0.0) {
              return;
            }
            const zTickHalf = tickSpec.major ? zTickMajorHalf : zTickMinorHalf;
            pushWorldAxisSegment(
              axisPositions,
              [-zTickHalf, 0, worldAxisDisplayZ(-distanceFromPlane)],
              [zTickHalf, 0, worldAxisDisplayZ(-distanceFromPlane)],
            );
            pushWorldAxisSegment(
              axisPositions,
              [xMax - zTickHalf, yMax, worldAxisDisplayZ(-distanceFromPlane)],
              [xMax + zTickHalf, yMax, worldAxisDisplayZ(-distanceFromPlane)],
            );
            pushWorldAxisSegment(
              axisPositions,
              [0, yMax - zTickHalf, worldAxisDisplayZ(-distanceFromPlane)],
              [0, yMax + zTickHalf, worldAxisDisplayZ(-distanceFromPlane)],
            );
          });

          if (minorGridPositions.length > 0) {
            worldAxisOverlay.group.add(
              createWorldAxisLineSegments(minorGridPositions, "#9aa3af", 0.12, 1.4),
            );
          }
          worldAxisOverlay.group.add(
            createWorldAxisLineSegments(gridPositions, "#9aa3af", 0.24, 2.0),
          );
          worldAxisOverlay.group.add(
            createWorldAxisLineSegments(axisPositions, "#6b7280", 0.58, 2.2),
