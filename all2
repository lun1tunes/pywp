from __future__ import annotations

from collections.abc import Iterable, Mapping

import numpy as np

__all__ = [
    "WT_THREE_MAX_HOVER_POINTS_PER_REFERENCE_TRACE",
    "WT_THREE_MAX_HOVER_POINTS_PER_TRACE",
