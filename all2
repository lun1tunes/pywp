            if edit_applied_note:
                message = f"{message} {edit_applied_note}"
            st.success(message)
            st.toast(
                f"Длина ГС обновлена для {len(edit_applied)} скважин.",
                icon=":material/straighten:",
            )
        elif edit_applied_source == "raw_records_table":
