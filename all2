    normalized_kind = _normalize_reference_fund_kind(st.session_state.get(key))
    st.session_state[key] = normalized_kind
    return str(
        st.radio(
            "Тип фонда",
            options=_REFERENCE_FUND_OPTIONS,
            key=key,
            format_func=_reference_fund_label,
            horizontal=True,
            label_visibility="collapsed",
        )
    )


