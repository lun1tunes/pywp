      #edit-save-btn:hover {
        background: #16a34a;
      }

      #edit-save-btn.is-pending,
      #edit-save-btn:disabled {
        cursor: wait;
        opacity: 0.82;
      }

      #edit-save-btn.is-error {
        border-color: #dc2626;
        background: #ef4444;
        box-shadow: 0 6px 18px rgba(220,38,38,0.22);
      }

      #edit-save-btn.is-visible {
        display: block;
      }

      #edit-warning-toast {
        display: none;
        position: absolute;
        bottom: 64px;
        right: 18px;
        z-index: 6;
        max-width: 420px;
        background: rgba(255,255,255,0.97);
        border-left: 5px solid #f59e0b;
        border-radius: 12px;
        box-shadow: 0 9px 24px rgba(15,23,42,0.12);
        padding: 15px 21px 36px;
        font-size: 15px;
        line-height: 1.45;
        color: #475569;
        pointer-events: auto;
      }

      #edit-warning-hide-btn {
        position: absolute;
        right: 12px;
        bottom: 8px;
        border: none;
        background: transparent;
        color: #64748b;
        border-radius: 6px;
        padding: 3px 7px;
        font-size: 12px;
        font-weight: 700;
        line-height: 1.2;
        cursor: pointer;
      }

      #edit-warning-hide-btn:hover {
        background: rgba(148,163,184,0.16);
        color: #334155;
      }

      #edit-warning-toast.is-visible {
        display: block;
        animation: fadeInUp 0.3s ease;
      }

      #minimap-frame {
        display: none;
        position: absolute;
        z-index: 3;
        border: 1px solid rgba(15,23,42,0.16);
        border-radius: 12px;
        background: rgba(255,255,255,0.035);
        box-shadow: 0 8px 20px rgba(15,23,42,0.10);
        pointer-events: none;
      }

      #minimap-frame.is-visible {
        display: block;
      }

      #minimap-label-layer {
        display: none;
        position: absolute;
        z-index: 4;
        overflow: hidden;
        pointer-events: none;
      }

      #minimap-label-layer.is-visible {
        display: block;
      }

      #minimap-ruler-layer {
        display: none;
        position: absolute;
        z-index: 4;
        overflow: hidden;
        pointer-events: none;
      }

      #minimap-ruler-layer.is-visible {
        display: block;
      }

      .minimap-ruler-line {
        position: absolute;
        display: none;
        height: 2px;
        border-radius: 999px;
        background: rgba(15,23,42,0.84);
        box-shadow:
          0 0 0 1px rgba(255,255,255,0.88),
          0 1px 4px rgba(15,23,42,0.16);
        transform-origin: 0 50%;
      }

      .minimap-ruler-point {
        position: absolute;
        display: none;
        width: 8px;
        height: 8px;
        border: 2px solid rgba(15,23,42,0.82);
        border-radius: 999px;
        background: rgba(255,255,255,0.96);
        box-shadow: 0 1px 4px rgba(15,23,42,0.18);
        transform: translate(-50%, -50%);
      }

      .minimap-ruler-label {
        position: absolute;
        display: none;
        padding: 2px 6px;
        border: 1px solid rgba(148,163,184,0.34);
        border-radius: 999px;
        background: rgba(255,255,255,0.96);
        color: #0f172a;
        box-shadow: 0 4px 10px rgba(15,23,42,0.12);
        font-size: 10px;
        font-weight: 700;
        line-height: 1.2;
        white-space: nowrap;
        transform: translate(-50%, -50%);
      }

      .minimap-well-label {
        position: absolute;
        display: none;
        box-sizing: border-box;
        max-width: min(160px, calc(100% - 16px));
        overflow: visible;
        overflow-wrap: anywhere;
        color: #0f172a;
        font-size: 10px;
        line-height: 1.12;
        text-shadow:
          0 1px 0 rgba(255,255,255,0.98),
          0 0 7px rgba(255,255,255,0.95),
          0 1px 4px rgba(15,23,42,0.18);
        transform: translate(6px, -50%);
        white-space: normal;
        contain: layout paint;
      }

      .minimap-edit-delta-label {
        position: absolute;
        display: none;
        min-width: 108px;
        padding: 3px 5px;
        border: 1px solid rgba(148,163,184,0.24);
        border-radius: 6px;
        background: rgba(255,255,255,0.82);
        box-shadow: 0 4px 10px rgba(15,23,42,0.08);
        color: rgba(15,23,42,0.86);
        font-family:
          "SFMono-Regular",
          ui-monospace,
          Menlo,
          Consolas,
          monospace;
        font-size: 9px;
        line-height: 1.3;
        text-align: left;
        transform: translate(10px, -100%);
        text-shadow: 0 1px 2px rgba(255,255,255,0.95);
        backdrop-filter: blur(4px);
        white-space: nowrap;
        contain: layout paint;
      }

      .minimap-edit-delta-label .edit-delta-head {
        display: block;
        margin-bottom: 3px;
        color: rgba(15,23,42,0.88);
        font-family:
          Inter,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;
        font-size: 10px;
        font-weight: 700;
      }

      .minimap-edit-delta-label .edit-delta-row {
        display: flex;
        justify-content: space-between;
        gap: 8px;
      }

      .minimap-edit-delta-label .edit-delta-total {
        margin-top: 3px;
        padding-top: 3px;
        border-top: 1px solid rgba(15,23,42,0.12);
        color: rgba(15,23,42,0.94);
        font-weight: 700;
      }

      .minimap-edit-position-label {
        position: absolute;
        display: none;
        min-width: 94px;
        padding: 3px 5px;
        border: 1px solid rgba(59,130,246,0.24);
        border-radius: 6px;
        background: rgba(255,255,255,0.82);
        box-shadow: 0 4px 10px rgba(15,23,42,0.08);
        color: rgba(15,23,42,0.86);
        font-family:
          "SFMono-Regular",
          ui-monospace,
          Menlo,
          Consolas,
          monospace;
        font-size: 9px;
        line-height: 1.3;
        text-align: left;
        transform: translate(10px, -100%);
        text-shadow: 0 1px 2px rgba(255,255,255,0.95);
        backdrop-filter: blur(4px);
        white-space: nowrap;
        contain: layout paint;
      }

      .minimap-edit-position-label .edit-delta-head {
        display: block;
        margin-bottom: 3px;
        color: rgba(15,23,42,0.88);
        font-family:
          Inter,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;
        font-size: 10px;
        font-weight: 700;
      }

      .minimap-edit-position-label .edit-delta-row {
        display: flex;
        justify-content: space-between;
        gap: 8px;
      }

      .minimap-edit-lateral-label {
        position: absolute;
        display: none;
        padding: 4px 8px;
        border: 1px solid rgba(37,99,235,0.18);
        border-radius: 999px;
        background: rgba(255,255,255,0.80);
        box-shadow: 0 4px 10px rgba(15,23,42,0.08);
        color: #1d4ed8;
        font-family:
          "SFMono-Regular",
          ui-monospace,
          Menlo,
          Consolas,
          monospace;
        font-size: 10px;
        font-weight: 700;
        text-shadow: 0 1px 2px rgba(255,255,255,0.95);
        transform: translate(-50%, -50%);
        white-space: nowrap;
        contain: layout paint;
      }

      #minimap-axes {
        display: none;
        position: absolute;
        z-index: 4;
        width: 62px;
        height: 62px;
        color: #334155;
        opacity: 0.86;
        pointer-events: none;
      }

      #minimap-axes.is-visible {
        display: block;
      }

      .minimap-axis {
        position: absolute;
        background: currentColor;
        box-shadow: 0 1px 2px rgba(255,255,255,0.9);
      }

      .minimap-axis::after {
        content: "";
        position: absolute;
        width: 0;
        height: 0;
      }

      .minimap-axis-x {
        left: 13px;
        bottom: 14px;
        width: 34px;
        height: 2px;
        color: #16A34A;
      }

      .minimap-axis-x::after {
        right: -1px;
        top: -4px;
        border-left: 7px solid currentColor;
        border-top: 5px solid transparent;
        border-bottom: 5px solid transparent;
      }

      .minimap-axis-y {
        left: 13px;
        bottom: 14px;
        width: 2px;
        height: 34px;
        color: #2563EB;
      }

      .minimap-axis-y::after {
        left: -4px;
        top: -1px;
        border-bottom: 7px solid currentColor;
        border-left: 5px solid transparent;
        border-right: 5px solid transparent;
      }

      .minimap-axis-label {
        position: absolute;
        color: currentColor;
        font-size: 10px;
        font-weight: 800;
        line-height: 1;
        text-shadow: 0 1px 2px rgba(255,255,255,0.95);
        white-space: nowrap;
      }

      .minimap-axis-label-x {
        right: 2px;
        bottom: 1px;
        color: #16A34A;
      }

      .minimap-axis-label-y {
        left: 0;
        top: 0;
        color: #2563EB;
      }

      #minimap-control {
        position: absolute;
        right: 14px;
        bottom: 14px;
        z-index: 5;
        display: flex;
        align-items: center;
        gap: 8px;
        pointer-events: none;
      }

      #minimap-control.is-expanded {
        height: 28px;
        justify-content: center;
        overflow: hidden;
      }

      #minimap-label {
        padding: 0;
        border: none;
        border-radius: 0;
        background: transparent;
        color: #334155;
        box-shadow: none;
        font-size: 12px;
        font-weight: 700;
        line-height: 1.15;
        pointer-events: none;
        text-shadow: 0 1px 2px rgba(255,255,255,0.95);
        white-space: nowrap;
      }

      #minimap-label.is-expanded {
        position: absolute;
        left: 50%;
        top: 6px;
        max-width: calc(100% - 84px);
        overflow: hidden;
        text-overflow: ellipsis;
        transform: translateX(-50%);
        background: transparent;
        box-shadow: none;
      }

      #minimap-toggle-btn {
        width: 28px;
        height: 28px;
        border: none;
        border-radius: 0;
        background: transparent;
        color: #475569;
        box-shadow: none;
        cursor: pointer;
        font-size: 22px;
        font-weight: 800;
        line-height: 1;
        pointer-events: auto;
      }

      #minimap-control:not(.is-expanded) #minimap-label {
        display: none;
      }

      #minimap-control:not(.is-expanded) #minimap-toggle-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        width: auto;
        min-width: 94px;
        height: 30px;
        padding: 0 10px;
        border: 1px solid rgba(15,23,42,0.16);
        border-radius: 8px;
        background: rgba(255,255,255,0.88);
        box-shadow: 0 6px 16px rgba(15,23,42,0.10);
        color: #334155;
        font-size: 12px;
        font-weight: 500;
      }

      #minimap-control:not(.is-expanded) #minimap-toggle-btn::before {
        content: "‹";
        font-size: 16px;
        font-weight: 500;
        line-height: 1;
      }

      #minimap-control.is-expanded #minimap-toggle-btn {
        position: absolute;
        left: 0;
        top: 0;
        width: 28px;
        height: 28px;
        padding: 0;
        border: none;
        background: transparent;
        box-shadow: none;
        color: transparent;
        cursor: nwse-resize;
      }

      #minimap-control.is-expanded #minimap-toggle-btn::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0;
        width: 0;
        height: 0;
        border-top: 18px solid rgba(71,85,105,0.62);
        border-right: 18px solid transparent;
      }

      #minimap-control.is-expanded #minimap-toggle-btn::after {
        content: "";
        position: absolute;
        left: 5px;
        top: 5px;
        width: 7px;
        height: 7px;
        border-left: 2px solid rgba(255,255,255,0.88);
        border-top: 2px solid rgba(255,255,255,0.88);
      }

      #minimap-toggle-btn:hover {
        color: #0f172a;
      }

      #minimap-control.is-expanded #minimap-toggle-btn:hover::before {
        border-top-color: rgba(51,65,85,0.74);
      }

      #minimap-ruler-btn {
        display: none;
        pointer-events: auto;
      }

      #minimap-control.is-expanded #minimap-ruler-btn {
        position: absolute;
        right: 0;
        top: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        padding: 0;
        border: none;
        border-radius: 999px;
        background: rgba(255,255,255,0.76);
        color: #475569;
        box-shadow: 0 3px 10px rgba(15,23,42,0.12);
        cursor: pointer;
        line-height: 1;
        transition:
          background 0.16s ease,
          color 0.16s ease,
          box-shadow 0.16s ease,
          transform 0.16s ease;
      }

      .minimap-ruler-icon {
        width: 15px;
        height: 15px;
        stroke: currentColor;
        fill: none;
        stroke-width: 1.8;
        stroke-linecap: round;
        stroke-linejoin: round;
      }

      #minimap-ruler-btn:hover {
        background: rgba(255,255,255,0.92);
        color: #0f172a;
      }

      #minimap-control.is-expanded #minimap-ruler-btn.is-active {
        background: rgba(37,99,235,0.24);
        color: #1d4ed8;
        box-shadow:
          inset 0 0 0 1.6px rgba(37,99,235,0.62),
          0 4px 12px rgba(29,78,216,0.22);
        transform: translateY(-0.5px);
      }

      #minimap-control.is-expanded #minimap-ruler-btn.is-active:hover {
        background: rgba(37,99,235,0.28);
        color: #1d4ed8;
      }

      @keyframes fadeInUp {
        from { opacity: 0; transform: translateY(8px); }
        to { opacity: 1; transform: translateY(0); }
      }
    </style>
  </head>
  <body>
    <div id="root">
      <div id="toolbar-left">
        <button id="fit-camera-btn" class="toolbar-btn" type="button" title="Подогнать сцену под кадр">Сброс вида</button>
        <button id="edit-targets-btn" class="toolbar-btn" type="button" title="Изменить точки скважины" style="display:none">Редактировать точки</button>
        <div id="anti-collision-control-wrap">
        <button id="anti-collision-btn" class="toolbar-btn" type="button" title="Слои anti-collision">Anti-collision</button>
          <div id="anti-collision-controls">
            <label class="anti-collision-option">
              <input type="checkbox" data-ac-layer="cones" checked />
              <span>Конусы неопределенности</span>
            </label>
            <label class="anti-collision-option">
              <input type="checkbox" data-ac-layer="sidetrack_relative_cones" />
              <span>Относительные конуса боковых стволов</span>
            </label>
            <label class="anti-collision-option">
              <input type="checkbox" data-ac-layer="overlaps" checked />
              <span>Зоны пересечений</span>
            </label>
            <label class="anti-collision-option">
              <input type="checkbox" data-ac-layer="segments" checked />
              <span>Конфликтные участки ствола</span>
            </label>
          </div>
        </div>
        <div id="world-axis-control-wrap">
          <button
            id="world-axis-btn"
            class="toolbar-btn is-mini"
            type="button"
            title="Настроить координатную ось"
            aria-label="Настроить координатную ось"
          >⚙</button>
          <div id="world-axis-controls">
            <label class="anti-collision-option">
              <input id="world-axis-toggle" type="checkbox" />
              <span>Показать координатную ось</span>
            </label>
            <label class="anti-collision-option">
              <input id="reference-labels-toggle" type="checkbox" />
              <span>Показать имена всех скважин</span>
            </label>
            <div class="world-axis-scale-block">
              <div class="world-axis-scale-head">
                <span>Масштаб Z</span>
                <span id="world-axis-z-scale-value" class="world-axis-scale-value">1:1</span>
              </div>
              <input
                id="world-axis-z-scale-slider"
                class="world-axis-scale-slider"
                type="range"
                min="1"
                max="10"
                step="0.05"
                value="1"
              />
            </div>
          </div>
        </div>
      </div>
      <div id="toolbar-right">
        <button id="fullscreen-btn" class="toolbar-btn" type="button" title="Развернуть на весь экран">⛶</button>
      </div>
      <div id="edit-toolbox">
        <div class="edit-toolbox-header">
          <div class="edit-toolbox-title">Инструменты</div>
        </div>
        <div class="edit-toolbox-body">
          <div class="edit-toolbox-section">
            <div class="edit-toolbox-label">Смещение</div>
            <div id="edit-plane-selector">
              <button class="plane-btn is-active" data-plane="xy" type="button">Плоскость XY</button>
              <button class="plane-btn" data-plane="z" type="button">Ось Z</button>
            </div>
          </div>
          <div class="edit-toolbox-section">
            <div class="edit-toolbox-label">Точки</div>
            <div id="edit-scope-selector">
              <button class="scope-btn is-active" data-scope="point" type="button">Одна</button>
              <button class="scope-btn" data-scope="pair" type="button">Все</button>
            </div>
          </div>
          <div class="edit-toolbox-section">
            <div class="edit-toolbox-label">Активная</div>
            <div id="edit-point-selector">
              <button class="point-btn" data-point-role="t1" type="button" title="Сделать t1 активной точкой">t1</button>
              <button class="point-btn" data-point-role="t3" type="button" title="Сделать t3 активной точкой">t3</button>
            </div>
          </div>
          <div class="edit-toolbox-section">
            <div class="edit-toolbox-label">Действие</div>
            <div id="edit-operation-selector">
              <button class="operation-btn is-active" data-operation="move" type="button">Сдвиг</button>
              <button class="operation-btn" data-operation="rotate" type="button">Поворот XY</button>
            </div>
          </div>
          <div class="edit-toolbox-section">
            <div class="edit-toolbox-label">История</div>
            <div class="edit-toolbox-action-row">
              <button id="edit-undo-btn" class="edit-tool-btn" type="button" title="Отменить последнее изменение выбранной скважины">Назад</button>
              <button id="edit-redo-btn" class="edit-tool-btn" type="button" title="Повторить отменённое изменение выбранной скважины">Вперёд</button>
              <button id="edit-reset-btn" class="edit-tool-btn is-reset" type="button" title="Вернуть выбранную скважину к исходным точкам">Сброс</button>
            </div>
          </div>
        </div>
      </div>
      <button id="edit-save-btn" type="button">Сохранить изменения</button>
      <div id="edit-warning-toast">
        <span>⚠ Для скорректированных скважин показана предварительная траектория — для уточнения требуется пересчёт.</span>
        <button id="edit-warning-hide-btn" type="button">скрыть</button>
      </div>
      <div id="legend-toggle-wrap">
        <button id="legend-toggle-btn" class="toolbar-btn" type="button" title="Свернуть или развернуть легенду">Легенда</button>
      </div>
      <div id="axes-gizmo"></div>
      <div id="label-layer"></div>
      <button id="world-axis-drag-handle" class="world-axis-handle" type="button" title="Перетащить координатную сетку по XY">
        <svg
          class="world-axis-handle-icon"
          viewBox="0 0 24 24"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
