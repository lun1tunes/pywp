            "first_surface_y": f"wt_pad_cfg_first_surface_y_{selected_id}",
            "first_surface_z": f"wt_pad_cfg_first_surface_z_{selected_id}",
            "surface_anchor_center": f"wt_pad_cfg_surface_anchor_center_{selected_id}",
