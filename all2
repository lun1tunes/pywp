def test_min_kop_calculation() -> None:
    """Min KOP calculation should be reasonable."""
    surface = Point3D(x=0, y=0, z=0)
    t1 = Point3D(x=200, y=0, z=1000)
    
    # With low PI (gentle curve), need more vertical space
