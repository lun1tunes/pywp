    add_distance_row("Промах t1 по вертикали", "vertical_distance_t1_m")
    add_distance_row("Промах t3 по латерали", "lateral_distance_t3_m")
    add_distance_row("Промах t3 по вертикали", "vertical_distance_t3_m")
