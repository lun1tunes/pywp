        font-family:
          "SFMono-Regular",
          ui-monospace,
          Menlo,
          Consolas,
          monospace;
        font-size: 10px;
        font-weight: 700;
        pointer-events: none;
        transform: translate(-50%, -50%);
        backdrop-filter: blur(7px);
      }

      #edit-save-btn {
        display: none;
        position: absolute;
        bottom: 14px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 6;
        border: 1px solid #16a34a;
        background: #22c55e;
        color: #ffffff;
        border-radius: 10px;
        padding: 8px 20px;
        font-size: 12px;
        font-weight: 700;
        cursor: pointer;
        box-shadow: 0 6px 18px rgba(22,163,74,0.25);
        transition: all 0.15s ease;
