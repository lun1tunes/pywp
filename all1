def _point_distance(point_a: Point3D, point_b: Point3D) -> float:
    return float(
        np.linalg.norm(
            np.array(
                [
                    float(point_b.x) - float(point_a.x),
                    float(point_b.y) - float(point_a.y),
                    float(point_b.z) - float(point_a.z),
