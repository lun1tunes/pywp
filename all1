    ref: ImportedTrajectoryWell,
    model: PlanningUncertaintyModel,
    *,
    collision_name: str | None = None,
) -> AntiCollisionWell:
    return build_anti_collision_well(
        name=str(collision_name) if collision_name is not None else str(ref.name),
