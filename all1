        cm = 39.0

    return LocalCoordinateSystem(
        name="PNO-13",
        false_easting_m=0.0,  # Real value from field documentation
        false_northing_m=0.0,
        rotation_deg=0.0,
        scale_factor=1.0,
        base_system=base,
