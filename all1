# useful local improvement in about two minutes for one pad.
_MAX_CANDIDATE_EVALUATIONS = 24
_MAX_CANDIDATES_PER_ITERATION = 12
_MAX_CANDIDATES_PER_ZONE = 8
_MAX_RUNTIME_S = 120.0


