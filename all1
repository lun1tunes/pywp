def _distance_from_current(current: dict[str, float], target: Point3D) -> float:
    return float(
        np.linalg.norm(
            np.array(
                [
                    float(target.x) - float(current["x"]),
                    float(target.y) - float(current["y"]),
                    float(target.z) - float(current["z"]),
