    finally:
        if pool is not None:
            pool.shutdown(wait=True)

    elapsed_total = perf_counter() - optimization_started
    budget_text = (
        " Остановлено по лимиту времени/кандидатов."
        if stopped_by_budget
        else ""
    )
    progress_callback(
        100,
        (
