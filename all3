          syncMiniMapRulerButton();
        }

        function updateMiniMapRulerOverlay() {
          if (
            !miniMapRulerLayer ||
            !miniMapRulerLine ||
            !miniMapRulerStart ||
            !miniMapRulerEnd ||
            !miniMapRulerLabel
          ) {
            return;
          }
          const overlayVisible =
            miniMapState.expanded && Boolean(miniMapRulerState.enabled);
          miniMapRulerLayer.classList.toggle("is-visible", overlayVisible);
          if (!overlayVisible) {
            miniMapRulerLine.style.display = "none";
            miniMapRulerStart.style.display = "none";
            miniMapRulerEnd.style.display = "none";
            miniMapRulerLabel.style.display = "none";
            miniMapRulerLayer.style.left = "";
            miniMapRulerLayer.style.top = "";
            miniMapRulerLayer.style.width = "";
            miniMapRulerLayer.style.height = "";
            return;
          }
          const rect = miniMapState.rect.width > 0
            ? miniMapState.rect
            : miniMapCanvasRect();
          miniMapRulerLayer.style.left = `${Math.round(rect.x)}px`;
          miniMapRulerLayer.style.top = `${Math.round(rect.canvasHeight - rect.y - rect.height)}px`;
          miniMapRulerLayer.style.width = `${Math.round(rect.width)}px`;
          miniMapRulerLayer.style.height = `${Math.round(rect.height)}px`;
          const startRaw = miniMapRulerState.startRaw;
          const endRaw = miniMapRulerCurrentEndRaw();
          if (!startRaw || !endRaw) {
            miniMapRulerLine.style.display = "none";
            miniMapRulerStart.style.display = "none";
            miniMapRulerEnd.style.display = "none";
            miniMapRulerLabel.style.display = "none";
            return;
          }
          const startLocal = miniMapLocalFromDisplayPoint(
            miniMapRulerDisplayPoint(startRaw),
            rect,
          );
          const endLocal = miniMapLocalFromDisplayPoint(
            miniMapRulerDisplayPoint(endRaw),
            rect,
          );
          if (
            !Number.isFinite(startLocal.x) ||
            !Number.isFinite(startLocal.y) ||
            !Number.isFinite(endLocal.x) ||
            !Number.isFinite(endLocal.y)
          ) {
            miniMapRulerLine.style.display = "none";
            miniMapRulerStart.style.display = "none";
            miniMapRulerEnd.style.display = "none";
            miniMapRulerLabel.style.display = "none";
            return;
          }
          const dx = endLocal.x - startLocal.x;
          const dy = endLocal.y - startLocal.y;
          const length = Math.hypot(dx, dy);
          const angleDeg = Math.atan2(dy, dx) * 180.0 / Math.PI;
          const distanceMeters = miniMapRulerDistanceMeters(startRaw, endRaw);
          miniMapRulerStart.style.display = "block";
          miniMapRulerStart.style.left = `${startLocal.x}px`;
          miniMapRulerStart.style.top = `${startLocal.y}px`;
          miniMapRulerEnd.style.display = "block";
          miniMapRulerEnd.style.left = `${endLocal.x}px`;
          miniMapRulerEnd.style.top = `${endLocal.y}px`;
          miniMapRulerLine.style.display = "block";
          miniMapRulerLine.style.left = `${startLocal.x}px`;
          miniMapRulerLine.style.top = `${startLocal.y}px`;
          miniMapRulerLine.style.width = `${length}px`;
          miniMapRulerLine.style.transform =
            `translate(0, -50%) rotate(${angleDeg}deg)`;
          miniMapRulerLabel.textContent = formatMiniMapDistanceMeters(distanceMeters);
          miniMapRulerLabel.style.display = "block";
          const normalX = length > 0.000001 ? -dy / length : 0.0;
          const normalY = length > 0.000001 ? dx / length : -1.0;
          const labelWidth = Math.max(Number(miniMapRulerLabel.offsetWidth) || 0, 1);
          const labelHeight = Math.max(Number(miniMapRulerLabel.offsetHeight) || 0, 1);
          const labelCenterX = (startLocal.x + endLocal.x) * 0.5 + normalX * 16.0;
          const labelCenterY = (startLocal.y + endLocal.y) * 0.5 + normalY * 16.0;
          const labelLeft = clampValue(
            labelCenterX,
            labelWidth * 0.5 + 4.0,
            Math.max(rect.width - labelWidth * 0.5 - 4.0, labelWidth * 0.5 + 4.0),
          );
          const labelTop = clampValue(
            labelCenterY,
            labelHeight * 0.5 + 4.0,
            Math.max(rect.height - labelHeight * 0.5 - 4.0, labelHeight * 0.5 + 4.0),
          );
          miniMapRulerLabel.style.left = `${labelLeft}px`;
          miniMapRulerLabel.style.top = `${labelTop}px`;
        }

        let bounds = transformedBounds(payload.bounds || {});
        let minBound = bounds.min;
        let maxBound = bounds.max;
        let center = new THREE.Vector3()
          .addVectors(minBound, maxBound)
          .multiplyScalar(0.5);
        let span = new THREE.Vector3().subVectors(maxBound, minBound);
        let maxSpan = Math.max(span.x, span.y, span.z, 1);
        let worldMarkerSize = Math.max(maxSpan * 0.008, 9.0);
        let axisLength = Math.max(maxSpan * 0.18, 40.0);

        function recomputeSceneMetrics(options) {
          sceneOrigin = rawBoundsCenter(payload.bounds || {});
          bounds = transformedBounds(payload.bounds || {});
          minBound = bounds.min;
          maxBound = bounds.max;
          center = new THREE.Vector3()
            .addVectors(minBound, maxBound)
            .multiplyScalar(0.5);
          span = new THREE.Vector3().subVectors(maxBound, minBound);
          maxSpan = Math.max(span.x, span.y, span.z, 1);
          worldMarkerSize = Math.max(maxSpan * 0.008, 9.0);
          axisLength = Math.max(maxSpan * 0.18, 40.0);
          if (!options || options.resetMiniMap !== false) {
            fitMiniMapToRawBounds(payload.bounds || {});
          }
        }

        recomputeSceneMetrics();

        function addMiniMapLabel(text, position, extraClassName, options) {
          if (!miniMapLabelLayer) {
            return null;
          }
          const labelRole = String((options && options.role) || "label");
          const element = document.createElement("div");
