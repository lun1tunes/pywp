    <script id="scene-payload" type="application/json">
      __SCENE_PAYLOAD__
    </script>
    <script>
      (function () {
        const payloadElement = document.getElementById("scene-payload");
        if (!payloadElement) {
          return;
        }
        let payload = JSON.parse(payloadElement.textContent || "{}");
        const root = document.getElementById("root");
        const labelLayerElement = document.getElementById("label-layer");
        const worldAxisDragHandle = document.getElementById("world-axis-drag-handle");
        const legendElement = document.getElementById("legend");
        const tooltipElement = document.getElementById("tooltip");
        const miniMapFrame = document.getElementById("minimap-frame");
        const miniMapLabelLayer = document.getElementById("minimap-label-layer");
        const miniMapRulerLayer = document.getElementById("minimap-ruler-layer");
        const miniMapRulerLine = document.getElementById("minimap-ruler-line");
        const miniMapRulerStart = document.getElementById("minimap-ruler-start");
        const miniMapRulerEnd = document.getElementById("minimap-ruler-end");
        const miniMapRulerLabel = document.getElementById("minimap-ruler-label");
        const miniMapAxes = document.getElementById("minimap-axes");
        const miniMapControl = document.getElementById("minimap-control");
        const miniMapLabel = document.getElementById("minimap-label");
        const miniMapToggleBtn = document.getElementById("minimap-toggle-btn");
        const miniMapRulerBtn = document.getElementById("minimap-ruler-btn");
        const fitButton = document.getElementById("fit-camera-btn");
        const fullscreenButton = document.getElementById("fullscreen-btn");
        const axesGizmoElement = document.getElementById("axes-gizmo");
        const collisionsPanelElement = document.getElementById("collisions-panel");
        const antiCollisionControlWrap = document.getElementById("anti-collision-control-wrap");
        const antiCollisionButton = document.getElementById("anti-collision-btn");
        const antiCollisionControls = document.getElementById("anti-collision-controls");
        const worldAxisControlWrap = document.getElementById("world-axis-control-wrap");
        const worldAxisButton = document.getElementById("world-axis-btn");
        const worldAxisControls = document.getElementById("world-axis-controls");
        const worldAxisToggle = document.getElementById("world-axis-toggle");
        const referenceLabelsToggle = document.getElementById("reference-labels-toggle");
        const worldAxisZScaleSlider = document.getElementById("world-axis-z-scale-slider");
        const worldAxisZScaleValue = document.getElementById("world-axis-z-scale-value");
        const Z_DISPLAY_SIGN = -1.0;
        let payloadDigest = "";
        let optionalReferenceLabels = [];

        function payloadSceneComplexity(payloadValue) {
          const lineItems = Array.isArray(payloadValue && payloadValue.lines)
            ? payloadValue.lines
            : [];
          const pointItems = Array.isArray(payloadValue && payloadValue.points)
            ? payloadValue.points
            : [];
          const labelItems = Array.isArray(payloadValue && payloadValue.labels)
            ? payloadValue.labels
            : [];
          const meshItems = Array.isArray(payloadValue && payloadValue.meshes)
            ? payloadValue.meshes
            : [];
          return (
            lineItems.reduce(
              (acc, item) =>
                acc +
                (Array.isArray(item.segments)
                  ? item.segments.reduce(
                      (segmentAcc, segment) =>
                        segmentAcc +
                        (Array.isArray(segment) ? Math.max(segment.length - 1, 0) : 0),
                      0,
                    )
                  : 0),
              0,
            ) +
            pointItems.reduce(
              (acc, item) => acc + (Array.isArray(item.points) ? item.points.length : 0),
              0,
            ) +
            labelItems.length * 12 +
            meshItems.reduce(
              (acc, item) => {
                const vertexCount = Array.isArray(item.vertices) ? item.vertices.length : 0;
                const ringCount = Array.isArray(item.rings)
                  ? item.rings.reduce(
                      (ringAcc, ring) => ringAcc + (Array.isArray(ring) ? ring.length : 0),
                      0,
                    )
                  : 0;
                return acc + vertexCount + ringCount;
              },
              0,
            )
          );
        }

        function payloadMaxPixelRatio(nextSceneComplexity) {
          return nextSceneComplexity > 180000
            ? 0.95
            : nextSceneComplexity > 90000
              ? 1.0
              : nextSceneComplexity > 30000
                ? 1.25
                : 1.65;
        }

        let backgroundColor = String(payload.background || "#ffffff");
        let sceneComplexity = payloadSceneComplexity(payload);
        let maxPixelRatio = payloadMaxPixelRatio(sceneComplexity);
        const scene = new THREE.Scene();
        const miniMapOverlayScene = new THREE.Scene();
        scene.background = new THREE.Color(backgroundColor);
        const ambientLight = new THREE.AmbientLight(0xffffff, 0.72);
        scene.add(ambientLight);
        const surfaceShadeLight = new THREE.DirectionalLight(0xffffff, 0.58);
        surfaceShadeLight.position.set(0.35, -0.45, 0.82).normalize();
        scene.add(surfaceShadeLight);

        const renderer = new THREE.WebGLRenderer({
          antialias: sceneComplexity <= 25000,
          alpha: false,
          powerPreference: "high-performance",
        });
        renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, maxPixelRatio));
        renderer.setClearColor(backgroundColor, 1.0);
        renderer.domElement.style.background = backgroundColor;
        root.appendChild(renderer.domElement);

        const camera = new THREE.PerspectiveCamera(45, 1, 0.1, 1000000);
        camera.up.set(0, 0, 1);

        const miniMapCamera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0.1, 1000000);
        miniMapCamera.up.set(0, 1, 0);

        const controls = new THREE.OrbitControls(camera, renderer.domElement);
        controls.enableDamping = true;
        controls.dampingFactor = 0.12;
        controls.rotateSpeed = 0.72;
        controls.zoomSpeed = 0.95;
        controls.panSpeed = 0.47;
        controls.screenSpacePanning = true;
        controls.enableRotate = true;
        controls.enableZoom = true;
        controls.enablePan = true;

        const hoverTargets = [];
        const sceneLabels = [];
        const miniMapLabels = [];
        let animationFrameHandle = 0;
        let idleFrameCount = 0;
        let needsRender = true;
        let pointerScreen = { x: 0, y: 0, inside: false };
        let legendTreeExpanded = true;
        let interactionActive = false;
        const miniMapState = {
          expanded: false,
          dragging: false,
          zoom: 1.0,
          baseSpan: 1.0,
          maxSpan: 1.0,
          target: new THREE.Vector3(0, 0, 0),
          pointerStart: { x: 0, y: 0 },
          targetStart: new THREE.Vector3(0, 0, 0),
          customSize: null,
          resizing: false,
          resizeMoved: false,
          resizeStartRect: null,
          resizeStartWorldPerPixel: 1.0,
          rect: { x: 0, y: 0, width: 0, height: 0 },
        };
        const miniMapRulerState = {
          enabled: false,
          phase: "idle",
          startRaw: null,
          endRaw: null,
          previewRaw: null,
        };
        let miniMapOverlayBuilt = false;
        let hasTreeLegend =
          Array.isArray(payload.legend_tree) && payload.legend_tree.length > 0;
        let focusTargets =
          payload.focus_targets && typeof payload.focus_targets === "object"
            ? payload.focus_targets
            : {};
        let legendWellNameKeys = new Set();
        let selectedLegendWellNameKeys = new Set();
        let editPads = Array.isArray(payload.edit_pads) ? payload.edit_pads : [];
        let editWells = Array.isArray(payload.edit_wells) ? payload.edit_wells : [];
        let editChannelName = String(payload.edit_channel || "");
        let selectedEditPadIndex = null;
        let selectedEditWellIndex = editWells.length > 0 ? 0 : null;
        let selectedEditWellIndices = new Set(
          Number.isInteger(selectedEditWellIndex) ? [selectedEditWellIndex] : [],
        );
        let editLegendSelectionAnchorIndex = selectedEditWellIndex;
        const worldAxisFocusPadById = new Map();
        const worldAxisPadFocusIds = [];
        const editPadIndexById = new Map();
        const editPadIndexByWellKey = new Map();
        const editWellIndexByName = new Map();
        const editableWellColors = new Set(
          editWells
            .map((well) => String((well && well.color) || "").trim().toLowerCase())
            .filter(Boolean),
        );

        function syncPayloadCollections() {
          hasTreeLegend =
            Array.isArray(payload.legend_tree) && payload.legend_tree.length > 0;
          focusTargets =
            payload.focus_targets && typeof payload.focus_targets === "object"
              ? payload.focus_targets
              : {};
          legendWellNameKeys.clear();
          worldAxisFocusPadById.clear();
          worldAxisPadFocusIds.length = 0;
          (Array.isArray(payload.legend_tree) ? payload.legend_tree : []).forEach((group) => {
            const groupId = String((group && group.id) || "").trim();
            if (!groupId.startsWith("pad::")) {
              return;
            }
            if (Object.prototype.hasOwnProperty.call(focusTargets, groupId)) {
              worldAxisPadFocusIds.push(groupId);
            }
            worldAxisFocusPadById.set(groupId, groupId);
            (Array.isArray(group && group.children) ? group.children : []).forEach((child) => {
              const childId = String((child && child.id) || "").trim();
              if (childId.startsWith("well::")) {
                const childWellKey = normalizedWellNameKey(childId.slice(6));
                if (childWellKey) {
                  legendWellNameKeys.add(childWellKey);
                }
              }
              if (childId) {
                worldAxisFocusPadById.set(childId, groupId);
              }
            });
          });
          Object.keys(focusTargets).forEach((focusId) => {
            const normalizedFocusId = String(focusId);
            if (normalizedFocusId.startsWith("well::")) {
              const focusWellKey = normalizedWellNameKey(normalizedFocusId.slice(6));
              if (focusWellKey) {
                legendWellNameKeys.add(focusWellKey);
              }
            }
            if (!String(focusId).startsWith("pad::")) {
              return;
            }
            if (!worldAxisPadFocusIds.includes(String(focusId))) {
              worldAxisPadFocusIds.push(String(focusId));
            }
            if (!worldAxisFocusPadById.has(String(focusId))) {
              worldAxisFocusPadById.set(String(focusId), String(focusId));
            }
          });
          editPads = Array.isArray(payload.edit_pads) ? payload.edit_pads : [];
          editWells = Array.isArray(payload.edit_wells) ? payload.edit_wells : [];
          optionalReferenceLabels = Array.isArray(payload.optional_reference_labels)
            ? payload.optional_reference_labels
            : [];
          editChannelName = String(payload.edit_channel || "");
          editPadIndexById.clear();
          editPadIndexByWellKey.clear();
          editWellIndexByName.clear();
          editWells.forEach((well, index) => {
            const name = String((well && well.name) || "").trim();
            if (!name) {
              return;
            }
            const wellNameKey = normalizedWellNameKey(name);
            if (wellNameKey) {
              legendWellNameKeys.add(wellNameKey);
            }
            editWellIndexByName.set(name, index);
            editWellIndexByName.set(`well::${name}`, index);
          });
          editPads.forEach((pad, index) => {
            const padId = String((pad && pad.id) || "").trim();
            const focusId = String((pad && pad.focus_id) || "").trim();
            if (padId) {
              editPadIndexById.set(padId, index);
            }
            if (focusId) {
              editPadIndexById.set(focusId, index);
            }
            (Array.isArray(pad && pad.well_names) ? pad.well_names : []).forEach((name) => {
              const wellKey = normalizedWellNameKey(name);
              if (!wellKey) {
                return;
              }
              editPadIndexByWellKey.set(wellKey, index);
              legendWellNameKeys.add(wellKey);
            });
          });
          editableWellColors.clear();
          editWells
            .map((well) => String((well && well.color) || "").trim().toLowerCase())
            .filter(Boolean)
            .forEach((colorKey) => editableWellColors.add(colorKey));
          if (selectedLegendWellNameKeys.size > 0) {
            selectedLegendWellNameKeys = new Set(
              Array.from(selectedLegendWellNameKeys).filter((key) =>
                legendWellNameKeys.has(key),
              ),
            );
          }
          selectedEditWellIndices = new Set(
            normalizedEditWellSelection(
              Array.from(selectedEditWellIndices || []),
              editWells.length > 0 ? 0 : null,
            ),
          );
          if (selectedEditWellIndices.size > 0) {
            if (!selectedEditWellIndices.has(selectedEditWellIndex)) {
              selectedEditWellIndex = selectedEditWellIndexArray()[0];
            }
          } else {
            selectedEditWellIndex = null;
            editLegendSelectionAnchorIndex = null;
          }
          if (
            !Number.isInteger(selectedEditPadIndex) ||
            selectedEditPadIndex < 0 ||
            selectedEditPadIndex >= editPads.length
          ) {
            selectedEditPadIndex = null;
          }
        }

        syncPayloadCollections();
        const editableBaseMaterials = [];
        const viewerStateScope = String(
          payload.component_key || payload.title || "scene"
        );
        const WORLD_AXIS_STORAGE_KEY = `pywp:world-axis-overlay:${viewerStateScope}`;
        const WORLD_AXIS_Z_SCALE_STORAGE_KEY = `pywp:world-axis-z-scale:${viewerStateScope}`;
        const REFERENCE_LABELS_STORAGE_KEY = `pywp:reference-labels:${viewerStateScope}`;
        const WORLD_AXIS_PLANE_Z_ROUND_STEP = 100.0;
        const WORLD_AXIS_GRID_SQUARES_PER_SIDE = 4;
        const VIEWER_Z_SCALE_DEFAULT = 1.0;
        const VIEWER_Z_SCALE_MIN = 1.0;
        const VIEWER_Z_SCALE_MAX = 10.0;
        const VIEWER_Z_SCALE_STEP = 0.05;
        const worldAxisOverlay = {
          enabled: readStoredBoolean(WORLD_AXIS_STORAGE_KEY, false),
          group: new THREE.Group(),
          signature: "",
          activePadFocusId: "",
          activeBoundsRaw: null,
          baseAnchorRaw: { x: 0.0, y: 0.0 },
          dragOffsetRaw: { x: 0.0, y: 0.0 },
          anchorRaw: { x: 0.0, y: 0.0 },
          labelSpecs: [],
          labels: [],
          dragging: false,
          dragStartRaw: null,
          dragStartOffsetRaw: { x: 0.0, y: 0.0 },
          zScaleFactor: VIEWER_Z_SCALE_DEFAULT,
        };
        const antiCollisionVisualObjects = {
          cones: [],
          sidetrack_relative_cones: [],
          overlaps: [],
          segments: [],
        };
        const miniMapHiddenContourObjects = [];
        const antiCollisionLayerLabels = {
          cones: "Конусы неопределенности",
          sidetrack_relative_cones: "Относительные конуса боковых стволов",
          overlaps: "Зоны пересечений",
          segments: "Конфликтные участки ствола",
        };
        const payloadAntiCollisionLayerState =
          payload.anti_collision_layer_state &&
          typeof payload.anti_collision_layer_state === "object"
            ? payload.anti_collision_layer_state
            : {};
        const antiCollisionLayerState = {
          cones: Boolean(
            Object.prototype.hasOwnProperty.call(payloadAntiCollisionLayerState, "cones")
              ? payloadAntiCollisionLayerState.cones
              : true,
          ),
          sidetrack_relative_cones: Boolean(
            Object.prototype.hasOwnProperty.call(
              payloadAntiCollisionLayerState,
              "sidetrack_relative_cones",
            )
              ? payloadAntiCollisionLayerState.sidetrack_relative_cones
              : false,
          ),
          overlaps: Boolean(
            Object.prototype.hasOwnProperty.call(payloadAntiCollisionLayerState, "overlaps")
              ? payloadAntiCollisionLayerState.overlaps
              : true,
          ),
          segments: Boolean(
            Object.prototype.hasOwnProperty.call(payloadAntiCollisionLayerState, "segments")
              ? payloadAntiCollisionLayerState.segments
              : true,
          ),
        };
        let antiCollisionControlsInitialized = false;
        let worldAxisControlsInitialized = false;
        let showAllReferenceLabels = readStoredBoolean(REFERENCE_LABELS_STORAGE_KEY, false);

        function readStoredBoolean(key, fallback) {
          try {
            const rawValue = window.localStorage.getItem(String(key || ""));
            if (rawValue === null) {
              return Boolean(fallback);
            }
            return rawValue === "1" || rawValue === "true";
          } catch (e) {
            return Boolean(fallback);
          }
        }

        function readStoredInteger(key, fallback, minValue, maxValue) {
          try {
            const rawValue = window.localStorage.getItem(String(key || ""));
            if (rawValue === null) {
              return Number(fallback) || 0;
            }
            const parsed = Math.round(Number(rawValue));
            if (!Number.isFinite(parsed)) {
              return Number(fallback) || 0;
            }
            return Math.min(
              Math.max(parsed, Number(minValue) || 0),
              Number(maxValue) || parsed,
            );
          } catch (e) {
            return Number(fallback) || 0;
          }
        }

        function readStoredNumber(key, fallback, minValue, maxValue) {
          try {
            const rawValue = window.localStorage.getItem(String(key || ""));
            if (rawValue === null) {
              return Number(fallback) || 0;
            }
            const parsed = Number(rawValue);
            if (!Number.isFinite(parsed)) {
              return Number(fallback) || 0;
            }
            return Math.min(
              Math.max(parsed, Number(minValue) || 0),
              Number(maxValue) || parsed,
            );
          } catch (e) {
            return Number(fallback) || 0;
          }
        }

        function storeBoolean(key, value) {
          try {
            window.localStorage.setItem(
              String(key || ""),
              value ? "1" : "0",
            );
          } catch (e) { /* ignore */ }
        }

        function storeStringValue(key, value) {
          try {
            window.localStorage.setItem(String(key || ""), String(value || ""));
          } catch (e) { /* ignore */ }
        }

        function sanitizeViewerZScaleFactor(value) {
          const parsed = Number(value);
          if (!Number.isFinite(parsed)) {
            return VIEWER_Z_SCALE_DEFAULT;
          }
          const rounded =
            Math.round(parsed / VIEWER_Z_SCALE_STEP) * VIEWER_Z_SCALE_STEP;
          return Math.min(
            Math.max(Number(rounded.toFixed(3)), VIEWER_Z_SCALE_MIN),
            VIEWER_Z_SCALE_MAX,
          );
        }

        function worldAxisZScaleFactor() {
          return sanitizeViewerZScaleFactor(worldAxisOverlay.zScaleFactor);
        }

        function formatViewerZScaleFactor(value) {
          const factor = sanitizeViewerZScaleFactor(value);
          return String(Number(factor.toFixed(2)));
        }

        worldAxisOverlay.zScaleFactor = readStoredNumber(
          WORLD_AXIS_Z_SCALE_STORAGE_KEY,
          VIEWER_Z_SCALE_DEFAULT,
          VIEWER_Z_SCALE_MIN,
          VIEWER_Z_SCALE_MAX,
        );

        const hoverSphereGeometry = new THREE.SphereGeometry(1.0, 6, 6);
        const hoverSphereMaterial = new THREE.MeshBasicMaterial({
          color: "#64748b",
          transparent: true,
          opacity: 0.0,
          depthWrite: false,
          depthTest: false,
        });
        hoverSphereMaterial.colorWrite = false;
        worldAxisOverlay.group.visible = Boolean(worldAxisOverlay.enabled);
        scene.add(worldAxisOverlay.group);

        function requestRender() {
          needsRender = true;
          startAnimationLoop();
        }

        function dataNumber(value, fallback) {
          const parsed = Number(value);
          return Number.isFinite(parsed) ? parsed : Number(fallback || 0);
        }

        function rawBoundsCenter(rawBounds) {
          const rawMin = Array.isArray(rawBounds && rawBounds.min)
            ? rawBounds.min
            : [0, 0, 0];
          const rawMax = Array.isArray(rawBounds && rawBounds.max)
            ? rawBounds.max
            : [1000, 1000, 1000];
          return {
            x: (dataNumber(rawMin[0], 0) + dataNumber(rawMax[0], 0)) * 0.5,
            y: (dataNumber(rawMin[1], 0) + dataNumber(rawMax[1], 0)) * 0.5,
            z: (dataNumber(rawMin[2], 0) + dataNumber(rawMax[2], 0)) * 0.5,
          };
        }

        let sceneOrigin = rawBoundsCenter(payload.bounds || {});

        function displayPoint(value) {
          const zScaleFactor = Math.max(worldAxisZScaleFactor(), 1.0);
          return new THREE.Vector3(
            dataNumber(value && value[0], 0) - sceneOrigin.x,
            dataNumber(value && value[1], 0) - sceneOrigin.y,
            ((dataNumber(value && value[2], 0) - sceneOrigin.z) * Z_DISPLAY_SIGN) /
              zScaleFactor,
          );
        }

        function displayXYZ(xValue, yValue, zValue) {
          const zScaleFactor = Math.max(worldAxisZScaleFactor(), 1.0);
          return [
            dataNumber(xValue, 0) - sceneOrigin.x,
            dataNumber(yValue, 0) - sceneOrigin.y,
            ((dataNumber(zValue, 0) - sceneOrigin.z) * Z_DISPLAY_SIGN) /
              zScaleFactor,
          ];
        }

        function dataPointFromDisplay(displayPosition) {
          const zScaleFactor = Math.max(worldAxisZScaleFactor(), 1.0);
          return [
            dataNumber(displayPosition && displayPosition.x, 0) + sceneOrigin.x,
            dataNumber(displayPosition && displayPosition.y, 0) + sceneOrigin.y,
            (dataNumber(displayPosition && displayPosition.z, 0) * zScaleFactor) *
              Z_DISPLAY_SIGN +
              sceneOrigin.z,
          ];
        }

        function hexOrDefault(colorValue, fallback) {
          if (typeof colorValue !== "string" || colorValue.trim() === "") {
            return fallback;
          }
          return colorValue;
        }

        function numberOrDefault(value, fallback) {
          const result = Number(value);
          return Number.isFinite(result) ? result : fallback;
        }

        function editableIndexForBaseName(nameValue) {
          const rawName = String(nameValue || "").trim();
          if (!rawName) {
            return null;
          }
          if (editWellIndexByName.has(rawName)) {
            return editWellIndexByName.get(rawName);
          }
          const baseName = rawName.split(":")[0].trim();
          if (baseName && editWellIndexByName.has(baseName)) {
            return editWellIndexByName.get(baseName);
          }
          return null;
        }

        function registerEditableBaseMaterial(material, colorValue, nameValue) {
          const colorKey = String(colorValue || "").trim().toLowerCase();
          const wellIndex = editableIndexForBaseName(nameValue);
          if (
            !material ||
            (
              !Number.isInteger(wellIndex) &&
              (!colorKey || !editableWellColors.has(colorKey))
            )
          ) {
            return;
          }
          editableBaseMaterials.push({
            material: material,
            colorKey: colorKey,
            wellIndex: wellIndex,
            opacity: Number.isFinite(Number(material.opacity))
              ? Number(material.opacity)
              : 1.0,
            transparent: Boolean(material.transparent),
            depthTest: Boolean(material.depthTest),
            depthWrite: Boolean(material.depthWrite),
          });
        }

        function setEditableBaseDimmed(dimmed, selectedWellIndex) {
          const selectedIndices = new Set(
            Number.isInteger(selectedEditPadIndex)
              ? []
              : normalizedEditWellSelection(
                  selectedEditWellIndexArray(),
                  selectedWellIndex,
                ),
          );
          const selectedColorKeys = new Set();
          let hasDirtySelectedWell = false;
          selectedIndices.forEach((wellIndex) => {
            const selectedWell = editWells[wellIndex] || null;
            const colorKey = String((selectedWell && selectedWell.color) || "")
              .trim()
              .toLowerCase();
            if (colorKey) {
              selectedColorKeys.add(colorKey);
            }
            if (editDirtyFlags[wellIndex]) {
              hasDirtySelectedWell = true;
            }
          });
          editableBaseMaterials.forEach((item) => {
            const material = item.material;
            const baseOpacity = Number.isFinite(Number(item.opacity))
              ? Number(item.opacity)
              : 1.0;
            const itemWellIndex = Number(item.wellIndex);
            const applies =
              dimmed &&
              (
                (Number.isInteger(itemWellIndex) && selectedIndices.has(itemWellIndex)) ||
                (
                  !Number.isInteger(itemWellIndex) &&
                  (
                    selectedColorKeys.size === 0 ||
                    selectedColorKeys.has(String(item.colorKey))
                  )
                )
              );
            material.transparent = applies || item.transparent || baseOpacity < 0.999;
            material.opacity = applies
              ? Math.min(baseOpacity, hasDirtySelectedWell ? 0.36 : 0.18)
              : baseOpacity;
            material.depthTest = applies && hasDirtySelectedWell ? false : item.depthTest;
            material.depthWrite = applies ? false : item.depthWrite;
            material.needsUpdate = true;
          });
        }

        function antiCollisionLayerForRole(roleValue) {
          const role = String(roleValue || "");
          if (role === "cone" || role === "cone_tip") {
            return "cones";
          }
          if (
            role === "sidetrack_relative_cone" ||
            role === "sidetrack_relative_cone_tip"
          ) {
            return "sidetrack_relative_cones";
          }
          if (role === "overlap" || role === "overlap_volume") {
            return "overlaps";
          }
          if (role === "conflict_segment" || role === "conflict_hover") {
            return "segments";
          }
          return "";
        }

        function antiCollisionLayerForItem(itemOrRole) {
          if (typeof itemOrRole === "string") {
            return antiCollisionLayerForRole(itemOrRole);
          }
          const item = itemOrRole || {};
          const roleLayer = antiCollisionLayerForRole(item.role);
          if (roleLayer) {
            return roleLayer;
          }
          const name = String(item.name || "").toLowerCase();
          if (name.includes("конфликт") || name.includes("conflict")) {
            return "segments";
          }
          if (name.includes("зоны пересеч") || name.includes("overlap")) {
            return "overlaps";
          }
          if (name.includes("конус") || name.includes("cone")) {
            return "cones";
          }
          return "";
