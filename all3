        function formatCoordinateMeters(value) {
          const numericValue = Number(value) || 0;
          return `${numericValue.toFixed(1).replace(".", ",")} м`;
        }

        function normalizeAzimuthDeg(value) {
          const numericValue = Number(value) || 0;
          return ((numericValue % 360.0) + 360.0) % 360.0;
        }

        function signedAzimuthDeltaDeg(currentDeg, originalDeg) {
          let delta =
            normalizeAzimuthDeg(currentDeg) - normalizeAzimuthDeg(originalDeg);
          if (delta > 180.0) {
            delta -= 360.0;
          } else if (delta < -180.0) {
            delta += 360.0;
          }
          return delta;
        }

        function formatAzimuthDegrees(value) {
          return `${normalizeAzimuthDeg(value).toFixed(1).replace(".", ",")}°`;
        }

        function formatDeltaDegrees(value, signed = true) {
          const numericValue = Number(value) || 0;
          const absValue = Math.abs(numericValue);
          const sign =
            signed && numericValue > 0.05
              ? "+"
              : signed && numericValue < -0.05
                ? "-"
                : "";
          return `${sign}${absValue.toFixed(1).replace(".", ",")}°`;
