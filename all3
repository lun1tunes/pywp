        <button id="minimap-toggle-btn" type="button" title="Показать вид сверху">План E-N</button>
        <button id="minimap-ruler-btn" type="button" title="Измерить расстояние на плане E-N" aria-label="Измерить расстояние на плане E-N">
          <svg class="minimap-ruler-icon" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M3.25 11.25 11.25 3.25 12.75 4.75 4.75 12.75 3.25 12.75Z"></path>
