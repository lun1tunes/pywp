          const pad = editPads[index] || {};
          const indices = [];
          (Array.isArray(pad.well_names) ? pad.well_names : []).forEach((wellName) => {
            const mappedIndex = editWellIndexByName.get(String(wellName).trim());
            if (isValidEditWellIndex(mappedIndex) && !indices.includes(mappedIndex)) {
              indices.push(mappedIndex);
            }
          });
          return indices;
        }

        function editPadWellNameKeys(index) {
          const keys = new Set();
          if (!isValidEditPadIndex(index)) {
            return keys;
          }
          const pad = editPads[index] || {};
          (Array.isArray(pad.well_names) ? pad.well_names : []).forEach((wellName) => {
            const wellKey = normalizedWellNameKey(wellName);
            if (wellKey) {
              keys.add(wellKey);
            }
          });
          return keys;
        }

        function selectedEditPad() {
          return isValidEditPadIndex(selectedEditPadIndex)
            ? editPads[selectedEditPadIndex]
            : null;
        }

        function selectedEditPadAnchor() {
          return isValidEditPadIndex(selectedEditPadIndex)
            ? copyEditPoint(editPadCurrentAnchors[selectedEditPadIndex])
            : null;
        }

        function normalizedEditWellSelection(indices, fallbackIndex) {
          const unique = [];
          const seen = new Set();
          (Array.isArray(indices) ? indices : []).forEach((value) => {
            const index = Number(value);
            if (!isValidEditWellIndex(index) || seen.has(index)) {
              return;
            }
            seen.add(index);
            unique.push(index);
          });
          if (unique.length > 0) {
            return unique;
          }
          if (isValidEditWellIndex(fallbackIndex)) {
            return [Number(fallbackIndex)];
          }
          if (editWells.length > 0) {
            return [0];
          }
          return [];
        }

        function selectedEditWellIndexArray() {
          if (Number.isInteger(selectedEditPadIndex)) {
            return [];
          }
          return normalizedEditWellSelection(
            Array.from(selectedEditWellIndices || []),
            selectedEditWellIndex,
          );
        }

        function legendEditableIndicesInOrder() {
          if (!legendElement) {
            return selectedEditWellIndexArray();
          }
          const indices = [];
          legendElement.querySelectorAll("[data-edit-well-index]").forEach((node) => {
            const index = Number(node.getAttribute("data-edit-well-index"));
            if (isValidEditWellIndex(index) && !indices.includes(index)) {
              indices.push(index);
            }
          });
          return indices.length > 0 ? indices : selectedEditWellIndexArray();
        }

        function legendEditableRangeIndices(anchorIndex, targetIndex) {
          if (!isValidEditWellIndex(targetIndex)) {
            return [];
          }
          if (!isValidEditWellIndex(anchorIndex)) {
            return [targetIndex];
          }
          const ordered = legendEditableIndicesInOrder();
          const anchorPosition = ordered.indexOf(anchorIndex);
          const targetPosition = ordered.indexOf(targetIndex);
          if (anchorPosition < 0 || targetPosition < 0) {
            return [targetIndex];
          }
          const start = Math.min(anchorPosition, targetPosition);
          const end = Math.max(anchorPosition, targetPosition);
          return ordered.slice(start, end + 1);
        }

        function editSelectionWellNameKeys(indices) {
          const keys = new Set();
          normalizedEditWellSelection(indices, null).forEach((wellIndex) => {
            const well = editWells[wellIndex] || {};
            const wellKey = normalizedWellNameKey(well.name);
            if (wellKey) {
              keys.add(wellKey);
            }
          });
          return keys;
        }

        function currentCollisionHighlightWellNameKeys() {
          if (editModeActive) {
            const editKeys = editSelectionWellNameKeys(selectedEditWellIndexArray());
            if (editKeys.size > 0) {
              return editKeys;
            }
          }
          return selectedLegendWellNameKeys;
        }

        function setSelectedEditWellSelection(indices, options) {
          selectedEditPadIndex = null;
          const requestedPrimaryIndex = Number(options && options.primaryIndex);
          const fallbackIndex = isValidEditWellIndex(requestedPrimaryIndex)
            ? requestedPrimaryIndex
            : selectedEditWellIndex;
          const normalized = normalizedEditWellSelection(indices, fallbackIndex);
          selectedEditWellIndices = new Set(normalized);
          if (normalized.length === 0) {
            selectedEditWellIndex = null;
            editLegendSelectionAnchorIndex = null;
            selectedEditHandleIndex = null;
          } else {
            const nextPrimary = normalized.includes(requestedPrimaryIndex)
              ? requestedPrimaryIndex
              : normalized[normalized.length - 1];
            selectedEditWellIndex = nextPrimary;
            editLegendSelectionAnchorIndex = isValidEditWellIndex(
              Number(options && options.anchorIndex),
            )
              ? Number(options && options.anchorIndex)
              : nextPrimary;
          }
          syncSelectedEditHandle();
          syncEditVisibility();
          syncSelectedCollisionHighlights();
          if (!options || options.render !== false) {
            requestRender();
          }
        }

        function selectEditPad(index, options) {
          const nextIndex = Number(index);
          if (!isValidEditPadIndex(nextIndex)) {
            return false;
          }
          selectedEditPadIndex = nextIndex;
          selectedEditWellIndices = new Set();
          selectedEditWellIndex = null;
          editLegendSelectionAnchorIndex = null;
          selectedEditHandleIndex = null;
          if (editPlane !== "xy") {
            setEditPlane("xy");
          }
          setSelectedLegendWellNameKeys(new Set());
          syncEditVisibility();
          syncSelectedCollisionHighlights();
          if (options && options.focus) {
            const pad = editPads[nextIndex] || {};
            const focusId = String((pad && pad.focus_id) || `pad::${pad.id || ""}`);
            const targetBounds = focusTargets[focusId];
            if (targetBounds) {
              focusViewerTarget(targetBounds, focusId);
              return true;
            }
          }
          if (!options || options.render !== false) {
            requestRender();
          }
          return true;
        }

        function handleEditLegendSelection(editableIndex, event) {
          const index = Number(editableIndex);
          if (!isValidEditWellIndex(index)) {
            return;
          }
          const ctrlLike = Boolean(event && (event.ctrlKey || event.metaKey));
          const shiftLike = Boolean(event && event.shiftKey);
          if (!editModeActive || (!ctrlLike && !shiftLike)) {
            setSelectedEditWellSelection([index], {
              primaryIndex: index,
              anchorIndex: index,
              render: false,
            });
            return;
          }
          if (shiftLike) {
            const anchorIndex = isValidEditWellIndex(editLegendSelectionAnchorIndex)
              ? editLegendSelectionAnchorIndex
              : selectedEditWellIndex;
            const range = legendEditableRangeIndices(anchorIndex, index);
            const nextSelection = ctrlLike
              ? Array.from(new Set([...selectedEditWellIndexArray(), ...range]))
              : range;
            setSelectedEditWellSelection(nextSelection, {
              primaryIndex: index,
              anchorIndex: anchorIndex,
              render: false,
            });
            return;
          }
          const nextSelection = new Set(selectedEditWellIndexArray());
          if (nextSelection.has(index)) {
            nextSelection.delete(index);
          } else {
            nextSelection.add(index);
          }
          if (nextSelection.size === 0) {
            nextSelection.add(index);
          }
          const sortedSelection = Array.from(nextSelection).sort((left, right) => left - right);
          const nextPrimary = nextSelection.has(index)
            ? index
            : nextSelection.has(selectedEditWellIndex)
              ? selectedEditWellIndex
              : sortedSelection[sortedSelection.length - 1];
          setSelectedEditWellSelection(sortedSelection, {
            primaryIndex: nextPrimary,
            anchorIndex: index,
            render: false,
          });
        }

        function defaultEditHandleIndexForWell(wellIndex) {
          if (!Number.isInteger(wellIndex)) {
            return null;
          }
          let fallbackIndex = null;
          let t1Index = null;
          for (let index = 0; index < editHandles.length; index += 1) {
            const handle = editHandles[index];
            if (!handle || handle.wellIndex !== wellIndex) {
              continue;
            }
            if (handle.pointRole === "sidetrack_window") {
              continue;
            }
            if (fallbackIndex === null) {
              fallbackIndex = index;
            }
            if (handle.pointRole === "t1" && t1Index === null) {
              t1Index = index;
            }
            if (handle.pointRole === "t3") {
              return index;
            }
          }
          return t1Index !== null ? t1Index : fallbackIndex;
        }

        function selectedEditHandle() {
          if (!Number.isInteger(selectedEditHandleIndex)) {
            return null;
          }
          return editHandles[selectedEditHandleIndex] || null;
        }

        function syncSelectedEditHandle() {
          if (Number.isInteger(selectedEditPadIndex)) {
            selectedEditHandleIndex = null;
            return;
          }
          if (!Number.isInteger(selectedEditWellIndex)) {
            selectedEditHandleIndex = null;
            return;
          }
          const handle = selectedEditHandle();
          if (
            handle &&
            handle.wellIndex === selectedEditWellIndex &&
            handle.pointRole !== "sidetrack_window"
          ) {
            return;
          }
          selectedEditHandleIndex = defaultEditHandleIndexForWell(selectedEditWellIndex);
        }

        function handleIndexForWellPointRole(wellIndex, pointRole) {
          const normalizedRole = String(pointRole || "");
          if (
            !Number.isInteger(wellIndex) ||
            (normalizedRole !== "t1" && normalizedRole !== "t3")
          ) {
            return null;
          }
          for (let index = 0; index < editHandles.length; index += 1) {
            const handle = editHandles[index];
            if (
              handle &&
              handle.wellIndex === wellIndex &&
              handle.pointRole === normalizedRole
            ) {
              return index;
            }
          }
          return null;
        }

        function selectedEditPointRole() {
          const handle = selectedEditHandle();
          const pointRole = String((handle && handle.pointRole) || "");
          return pointRole === "t1" || pointRole === "t3" ? pointRole : "t3";
        }

        function setSelectedEditHandleByRole(pointRole) {
          if (Number.isInteger(selectedEditPadIndex)) {
            return false;
          }
          if (!Number.isInteger(selectedEditWellIndex)) {
            return false;
          }
          const nextHandleIndex = handleIndexForWellPointRole(
            selectedEditWellIndex,
            pointRole,
          );
          if (!Number.isInteger(nextHandleIndex)) {
            return false;
          }
          if (selectedEditHandleIndex === nextHandleIndex) {
            syncEditToolboxState();
            requestRender();
            return true;
          }
          selectedEditHandleIndex = nextHandleIndex;
          syncEditVisibility();
          syncEditToolboxState();
          requestRender();
          return true;
        }

        function toggleSelectedEditHandleRole() {
          const currentRole = selectedEditPointRole();
          return setSelectedEditHandleByRole(currentRole === "t1" ? "t3" : "t1");
        }

        function cloneEditState(wellIndex) {
          return {
            points: copyEditPointEntries(editCurrentPoints[wellIndex]),
            t1: copyEditPoint(editCurrentT1[wellIndex]),
            t3: copyEditPoint(editCurrentT3[wellIndex]),
          };
        }

        function originalEditState(wellIndex) {
          return {
            points: copyEditPointEntries(editOriginalPoints[wellIndex]),
            t1: copyEditPoint(editOriginalT1[wellIndex]),
            t3: copyEditPoint(editOriginalT3[wellIndex]),
          };
        }

        function pointsNearlyEqual(left, right) {
          if (!left || !right) {
            return false;
          }
          return (
            Math.abs(Number(left[0]) - Number(right[0])) <= EDIT_DELTA_EPS_M &&
            Math.abs(Number(left[1]) - Number(right[1])) <= EDIT_DELTA_EPS_M &&
            Math.abs(Number(left[2]) - Number(right[2])) <= EDIT_DELTA_EPS_M
          );
        }

        function editStatesEqual(left, right) {
          const leftPoints = Array.isArray(left && left.points) ? left.points : [];
          const rightPoints = Array.isArray(right && right.points) ? right.points : [];
          if (leftPoints.length || rightPoints.length) {
            if (leftPoints.length !== rightPoints.length) {
              return false;
            }
            return leftPoints.every((entry, index) =>
              pointsNearlyEqual(entry.position, rightPoints[index].position),
            );
          }
          return (
            Boolean(left) &&
            Boolean(right) &&
            pointsNearlyEqual(left.t1, right.t1) &&
            pointsNearlyEqual(left.t3, right.t3)
          );
        }

        function isEditWellDirty(wellIndex) {
          return !editStatesEqual(cloneEditState(wellIndex), originalEditState(wellIndex));
        }

        function cloneEditPadSurfacePoints(padIndex) {
          return (editPadCurrentPoints[padIndex] || []).map(copyEditPoint);
        }

        function originalEditPadSurfacePoints(padIndex) {
          return (editPadOriginalPoints[padIndex] || []).map(copyEditPoint);
        }

        function isEditPadDirty(padIndex) {
          if (!isValidEditPadIndex(padIndex)) {
            return false;
          }
          if (
            Math.abs(
              signedAzimuthDeltaDeg(
                editPadCurrentNds[padIndex],
                editPadOriginalNds[padIndex],
              ),
            ) > 0.05
          ) {
            return true;
          }
          if (
            !pointsNearlyEqual(
              editPadCurrentAnchors[padIndex],
              editPadOriginalAnchors[padIndex],
            )
          ) {
            return true;
          }
          const currentPoints = editPadCurrentPoints[padIndex] || [];
          const originalPoints = editPadOriginalPoints[padIndex] || [];
          if (currentPoints.length !== originalPoints.length) {
            return true;
          }
          return currentPoints.some((point, pointIndex) =>
            !pointsNearlyEqual(point, originalPoints[pointIndex]),
          );
        }

        function syncEditPadMarkerHover(marker) {
          if (!marker) {
            return;
          }
          const point = marker.dataPos || [0, 0, 0];
          const hoverData = {
            name: marker.padLabel || marker.wellName,
            point: marker.pointLabel || "S",
            x: Number(point[0]) || 0,
            y: Number(point[1]) || 0,
            z: Number(point[2]) || 0,
            color: EDIT_PAD_HANDLE_ACCENT,
          };
          [marker.pickMesh, marker.mesh].forEach((pickTarget) => {
            if (!pickTarget) {
              return;
            }
            pickTarget.userData.hover = hoverData;
          });
        }

        function editPadHandleLabelText(marker) {
          if (!marker) {
            return "Куст";
          }
          const padLabel = String(marker.padLabel || "").trim();
          const roleLabel =
            String(marker.pointLabel || "") === "Центр" ? "Центр" : "S";
          if (!padLabel) {
            return `Куст · ${roleLabel}`;
          }
          return `Куст ${padLabel} · ${roleLabel}`;
        }

        function syncEditPadHandleLabel(marker) {
          if (!marker || !marker.label) {
            return;
          }
          const selected =
            editModeActive &&
            Number.isInteger(selectedEditPadIndex) &&
            marker.padIndex === selectedEditPadIndex;
          marker.label.position.copy(displayPoint(marker.dataPos || [0, 0, 0]));
          marker.label.visible = selected;
          if (!selected) {
            return;
          }
          const current = copyEditPoint(marker.dataPos || [0, 0, 0]);
          const original = copyEditPoint(
            editPadOriginalAnchors[marker.padIndex] || current,
          );
          const dx = Number(current[0]) - Number(original[0]);
          const dy = Number(current[1]) - Number(original[1]);
          const total = Math.hypot(dx, dy);
          const currentNds = normalizeAzimuthDeg(
            editPadCurrentNds[marker.padIndex] ?? marker.ndsAzimuthDeg,
          );
          const originalNds = normalizeAzimuthDeg(
            editPadOriginalNds[marker.padIndex] ?? currentNds,
          );
          const deltaNds = signedAzimuthDeltaDeg(currentNds, originalNds);
          marker.label.element.innerHTML =
            `<span class="edit-delta-head">${escapeHtml(editPadHandleLabelText(marker))}</span>` +
            `<span class="edit-delta-row"><span>ΔX</span><span>${formatDeltaMeters(dx)}</span></span>` +
            `<span class="edit-delta-row"><span>ΔY</span><span>${formatDeltaMeters(dy)}</span></span>` +
            `<span class="edit-delta-row"><span>X</span><span>${formatCoordinateMeters(current[0])}</span></span>` +
            `<span class="edit-delta-row"><span>Y</span><span>${formatCoordinateMeters(current[1])}</span></span>` +
            `<span class="edit-delta-row"><span>НДС</span><span>${formatAzimuthDegrees(currentNds)}</span></span>` +
            `<span class="edit-delta-row"><span>НДС₀</span><span>${formatAzimuthDegrees(originalNds)}</span></span>` +
            `<span class="edit-delta-row"><span>ΔНДС</span><span>${formatDeltaDegrees(deltaNds)}</span></span>` +
            `<span class="edit-delta-row edit-delta-total"><span>Итого</span><span>${formatDeltaMeters(total, false)}</span></span>`;
        }

        function updateEditPadMarkerPosition(marker, point) {
          if (!marker) {
            return;
          }
          marker.dataPos = copyEditPoint(point);
          marker.visualPos = marker.dataPos.slice();
          const position = displayPoint(marker.dataPos);
          if (marker.mesh) {
            marker.mesh.position.copy(position);
          }
          if (marker.pickMesh) {
            marker.pickMesh.position.copy(position);
          }
          if (marker.selectionMesh) {
            marker.selectionMesh.position.copy(position);
          }
          syncEditPadMarkerHover(marker);
          syncEditPadHandleLabel(marker);
        }

        function rotateEditPadPointAroundAnchor(point, anchor, deltaRad) {
          const dx = Number((point && point[0]) || 0) - Number((anchor && anchor[0]) || 0);
          const dy = Number((point && point[1]) || 0) - Number((anchor && anchor[1]) || 0);
          const cosA = Math.cos(deltaRad);
          const sinA = Math.sin(deltaRad);
          return [
            Number((anchor && anchor[0]) || 0) + dx * cosA - dy * sinA,
            Number((anchor && anchor[1]) || 0) + dx * sinA + dy * cosA,
            Number((point && point[2]) || 0),
          ];
        }

        function applyEditPadState(padIndex, nextAnchor, nextSurfacePoints, nextNdsDeg) {
          if (!isValidEditPadIndex(padIndex)) {
            return;
          }
          const anchor = copyEditPoint(nextAnchor);
          const points = (Array.isArray(nextSurfacePoints) ? nextSurfacePoints : []).map(
            copyEditPoint,
          );
          editPadCurrentAnchors[padIndex] = anchor;
          editPadCurrentPoints[padIndex] = points;
          if (Number.isFinite(Number(nextNdsDeg))) {
            editPadCurrentNds[padIndex] = normalizeAzimuthDeg(nextNdsDeg);
          }
          editPadMarkers.forEach((marker) => {
            if (marker.padIndex !== padIndex) {
              return;
            }
            marker.ndsAzimuthDeg = Number(editPadCurrentNds[padIndex]) || 0;
            updateEditPadMarkerPosition(marker, anchor);
            updateEditPadNdsVisuals(marker);
          });
          editPadDirtyFlags[padIndex] = isEditPadDirty(padIndex);
          keepMiniMapOnActiveEditSelection();
        }

        function resetEditPad(padIndex) {
          if (!isValidEditPadIndex(padIndex)) {
            return;
          }
          applyEditPadState(
            padIndex,
            editPadOriginalAnchors[padIndex],
            originalEditPadSurfacePoints(padIndex),
            editPadOriginalNds[padIndex],
          );
        }

        function syncEditPadSummary() {
          if (
            !editPadSummary ||
            !editPadSummaryTitle ||
            !editPadSummaryMode ||
            !editPadDeltaX ||
            !editPadDeltaY ||
            !editPadFinalX ||
            !editPadFinalY
          ) {
            return;
          }
          const padIndex = selectedEditPadIndex;
          const pad = selectedEditPad();
          if (!editModeActive || !pad || !isValidEditPadIndex(padIndex)) {
            editPadSummary.classList.remove("is-visible");
            return;
          }
          const currentAnchor = editPadCurrentAnchors[padIndex] || [0, 0, 0];
          const originalAnchor = editPadOriginalAnchors[padIndex] || [0, 0, 0];
          editPadSummaryTitle.textContent = String(
            pad.title || pad.label || pad.id || "Куст",
          );
          editPadSummaryMode.textContent = String(pad.anchor_mode_label || "");
          editPadDeltaX.textContent = formatDeltaMeters(
            Number(currentAnchor[0]) - Number(originalAnchor[0]),
          );
          editPadDeltaY.textContent = formatDeltaMeters(
            Number(currentAnchor[1]) - Number(originalAnchor[1]),
          );
          editPadFinalX.textContent = formatCoordinateMeters(currentAnchor[0]);
          editPadFinalY.textContent = formatCoordinateMeters(currentAnchor[1]);
          editPadSummary.classList.add("is-visible");
        }

        function createUnitCircleGeometry(segments) {
          const positions = [];
          const safeSegments = Math.max(Number(segments) || 96, 16);
          for (let index = 0; index < safeSegments; index += 1) {
            const angle = (index / safeSegments) * Math.PI * 2.0;
            positions.push(Math.cos(angle), Math.sin(angle), 0);
          }
          const geometry = new THREE.BufferGeometry();
          geometry.setAttribute(
            "position",
            new THREE.Float32BufferAttribute(new Float32Array(positions), 3),
          );
          return geometry;
        }

        function createRotationArrowGeometry(angleRad, direction) {
          const radial = new THREE.Vector2(Math.cos(angleRad), Math.sin(angleRad));
          const turnDirection = Number(direction) < 0 ? -1.0 : 1.0;
          const tangent = new THREE.Vector2(
            -radial.y * turnDirection,
            radial.x * turnDirection,
          );
          const center = radial.clone().multiplyScalar(1.0);
          const tip = center.clone().add(tangent.clone().multiplyScalar(0.042));
          const baseCenter = center.clone().add(tangent.clone().multiplyScalar(-0.032));
          const wing = radial.clone().multiplyScalar(0.026);
          const positions = [
            tip.x,
            tip.y,
            0,
            baseCenter.x + wing.x,
            baseCenter.y + wing.y,
            0,
            baseCenter.x - wing.x,
            baseCenter.y - wing.y,
            0,
          ];
          const geometry = new THREE.BufferGeometry();
          geometry.setAttribute(
            "position",
            new THREE.Float32BufferAttribute(new Float32Array(positions), 3),
          );
          return geometry;
        }

        function editRotationControlLift() {
          return Math.max(maxSpan * 0.012, 10.0);
        }

        function editRotationModeEnabled() {
          return (
            editModeActive &&
            editMoveScope === "pair" &&
            editTransformMode === "rotate" &&
            Number.isInteger(selectedEditWellIndex) &&
            editWellSupportsRotation(selectedEditWellIndex)
          );
        }

        function editRotationCenterDisplay(wellIndex) {
          const t1 = editCurrentT1[wellIndex] || [0, 0, 0];
          const t3 = editCurrentT3[wellIndex] || [0, 0, 0];
          const center = displayPoint([t1[0], t1[1], t3[2]]);
          center.z += editRotationControlLift();
          return center;
        }

        function createEditRotationControl(wellIndex, color) {
          const group = new THREE.Group();
          group.visible = false;
          group.renderOrder = 13;
          const safeColor = hexOrDefault(color, "#2563eb");

          const ringMaterial = new THREE.LineBasicMaterial({
            color: safeColor,
            transparent: true,
            opacity: 0.52,
            depthTest: false,
            depthWrite: false,
          });
          const ring = new THREE.LineLoop(createUnitCircleGeometry(128), ringMaterial);
          ring.renderOrder = 13;
          group.add(ring);

          const arrowMaterial = new THREE.MeshBasicMaterial({
            color: safeColor,
            transparent: true,
            opacity: 0.68,
            side: THREE.DoubleSide,
            depthTest: false,
            depthWrite: false,
          });
          [
            [35, 1],
            [125, -1],
            [215, 1],
            [305, -1],
          ].forEach(([angleDeg, direction]) => {
            const arrow = new THREE.Mesh(
              createRotationArrowGeometry(
                (angleDeg * Math.PI) / 180.0,
                direction,
              ),
              arrowMaterial,
            );
            arrow.renderOrder = 14;
            group.add(arrow);
          });

          const pickMaterial = new THREE.MeshBasicMaterial({
            color: "#ffffff",
            transparent: true,
            opacity: 0.0,
            side: THREE.DoubleSide,
            depthTest: false,
            depthWrite: false,
          });
          pickMaterial.colorWrite = false;
          const pickMesh = new THREE.Mesh(
            new THREE.RingGeometry(0.90, 1.12, 128),
            pickMaterial,
          );
          pickMesh.userData.editRotationWellIndex = wellIndex;
          pickMesh.renderOrder = 15;
          group.add(pickMesh);
          scene.add(group);
          editRotationPickMeshes.push(pickMesh);
          return {
            group: group,
            ring: ring,
            arrows: group.children.filter((child) => child !== ring && child !== pickMesh),
            pickMesh: pickMesh,
          };
        }

        function updateEditRotationControl(wellIndex) {
          const control = editRotationControls[wellIndex];
          if (!control) {
            return;
          }
          const visible =
            editRotationModeEnabled() &&
            Number.isInteger(selectedEditWellIndex) &&
            wellIndex === selectedEditWellIndex &&
            horizontalT1T3Length(wellIndex) > EDIT_DELTA_EPS_M;
          control.group.visible = visible;
          if (!visible) {
            return;
          }
          const radius = Math.max(horizontalT1T3Length(wellIndex), EDIT_DELTA_EPS_M);
          control.group.position.copy(editRotationCenterDisplay(wellIndex));
          control.group.scale.set(radius, radius, 1.0);
          const isDragging = editRotateWellIndex === wellIndex;
          if (control.ring.material) {
            control.ring.material.opacity = isDragging ? 0.78 : 0.52;
            control.ring.material.needsUpdate = true;
          }
          control.arrows.forEach((arrow) => {
            if (arrow.material) {
              arrow.material.opacity = isDragging ? 0.86 : 0.68;
              arrow.material.needsUpdate = true;
            }
          });
        }

        function syncEditRotationControls() {
          editRotationControls.forEach((_, index) => updateEditRotationControl(index));
          editPadMarkers.forEach((marker) => updateEditPadNdsVisuals(marker));
        }

        function editPadRotationModeEnabled() {
          return (
            editModeActive &&
            editTransformMode === "rotate" &&
            Number.isInteger(selectedEditPadIndex)
          );
        }

        function editPadNdsDirectionData(ndsDeg) {
          const angleRad = (normalizeAzimuthDeg(ndsDeg) * Math.PI) / 180.0;
          return [Math.sin(angleRad), Math.cos(angleRad), 0.0];
        }

        function editPadNdsArrowLength(marker) {
          const spacingM = Math.max(Number((marker && marker.spacingM) || 0), 1.0);
          const wellCount = Math.max(
            (editPadCurrentPoints[(marker && marker.padIndex) || -1] || []).length,
            1,
          );
          return clampValue(spacingM * Math.max(wellCount * 1.35, 3.2), 48.0, 240.0);
        }

        function editPadRotationRadius(marker) {
          return Math.max(editPadNdsArrowLength(marker) * 0.72, 36.0);
        }

        function createEditPadNdsArrow(padIndex) {
          const group = new THREE.Group();
          group.visible = false;
          group.renderOrder = 15;
          const material = new THREE.MeshBasicMaterial({
            color: EDIT_PAD_HANDLE_ACCENT,
            transparent: true,
            opacity: 0.94,
            depthTest: false,
            depthWrite: false,
          });
          const shaft = new THREE.Mesh(
            new THREE.CylinderGeometry(0.07, 0.07, 1.0, 10),
            material,
          );
          shaft.position.y = 0.5;
          shaft.renderOrder = 15;
          group.add(shaft);
          const head = new THREE.Mesh(
            new THREE.ConeGeometry(0.22, 0.42, 12),
            material.clone(),
          );
          head.position.y = 1.12;
          head.renderOrder = 16;
          group.add(head);
          const pickMaterial = new THREE.MeshBasicMaterial({
            color: "#ffffff",
            transparent: true,
            opacity: 0.0,
            depthTest: false,
            depthWrite: false,
          });
          pickMaterial.colorWrite = false;
          const pickMesh = new THREE.Mesh(
            new THREE.CylinderGeometry(0.28, 0.28, 1.25, 10),
            pickMaterial,
          );
          pickMesh.position.y = 0.62;
          pickMesh.userData.editRotationPadIndex = padIndex;
          pickMesh.renderOrder = 17;
          group.add(pickMesh);
          scene.add(group);
          editPadRotationPickMeshes.push(pickMesh);
          return {
            group: group,
            shaft: shaft,
            head: head,
            pickMesh: pickMesh,
          };
        }

        function createEditPadRotationControl(padIndex) {
          const group = new THREE.Group();
          group.visible = false;
          group.renderOrder = 14;
          const ringMaterial = new THREE.LineBasicMaterial({
            color: EDIT_PAD_HANDLE_ACCENT,
            transparent: true,
            opacity: 0.48,
            depthTest: false,
            depthWrite: false,
          });
          const ring = new THREE.LineLoop(createUnitCircleGeometry(128), ringMaterial);
          ring.renderOrder = 14;
          group.add(ring);
          const pickMaterial = new THREE.MeshBasicMaterial({
            color: "#ffffff",
            transparent: true,
            opacity: 0.0,
            side: THREE.DoubleSide,
            depthTest: false,
            depthWrite: false,
          });
          pickMaterial.colorWrite = false;
          const pickMesh = new THREE.Mesh(
            new THREE.RingGeometry(0.9, 1.12, 128),
            pickMaterial,
          );
          pickMesh.userData.editRotationPadIndex = padIndex;
          pickMesh.renderOrder = 15;
          group.add(pickMesh);
          scene.add(group);
          editPadRotationPickMeshes.push(pickMesh);
          return {
            group: group,
            ring: ring,
            pickMesh: pickMesh,
          };
        }

        function updateEditPadNdsVisuals(marker) {
          if (!marker) {
            return;
          }
          const selected =
            editModeActive &&
            Number.isInteger(selectedEditPadIndex) &&
            marker.padIndex === selectedEditPadIndex;
          const rotateMode = selected && editPadRotationModeEnabled();
          const anchor = copyEditPoint(
            editPadCurrentAnchors[marker.padIndex] || marker.dataPos || [0, 0, 0],
          );
          const ndsDeg = normalizeAzimuthDeg(
            editPadCurrentNds[marker.padIndex] ?? marker.ndsAzimuthDeg,
          );
          const arrowLength = editPadNdsArrowLength(marker);
          const centerDisplay = displayPoint(anchor);
          if (marker.ndsArrow && marker.ndsArrow.group) {
            marker.ndsArrow.group.visible = selected;
            if (selected) {
              const directionData = editPadNdsDirectionData(ndsDeg);
              const tipData = [
                Number(anchor[0]) + directionData[0] * arrowLength,
                Number(anchor[1]) + directionData[1] * arrowLength,
                Number(anchor[2]),
              ];
              const tipDisplay = displayPoint(tipData);
              const direction = new THREE.Vector3().subVectors(tipDisplay, centerDisplay);
              const length = Math.max(direction.length(), 1e-6);
              direction.multiplyScalar(1.0 / length);
              marker.ndsArrow.group.position.copy(centerDisplay);
              marker.ndsArrow.group.scale.set(length, length, length);
              marker.ndsArrow.group.quaternion.setFromUnitVectors(
                new THREE.Vector3(0, 1, 0),
                direction,
              );
              const dragging = editPadRotateIndex === marker.padIndex;
              if (marker.ndsArrow.shaft && marker.ndsArrow.shaft.material) {
                marker.ndsArrow.shaft.material.opacity = dragging || rotateMode ? 1.0 : 0.82;
                marker.ndsArrow.shaft.material.needsUpdate = true;
              }
              if (marker.ndsArrow.head && marker.ndsArrow.head.material) {
                marker.ndsArrow.head.material.opacity = dragging || rotateMode ? 1.0 : 0.82;
                marker.ndsArrow.head.material.needsUpdate = true;
              }
            }
          }
          if (marker.rotationControl && marker.rotationControl.group) {
            marker.rotationControl.group.visible = rotateMode;
            if (rotateMode) {
              const radius = editPadRotationRadius(marker);
              marker.rotationControl.group.position.copy(centerDisplay);
              marker.rotationControl.group.scale.set(radius, radius, 1.0);
              const dragging = editPadRotateIndex === marker.padIndex;
              if (marker.rotationControl.ring && marker.rotationControl.ring.material) {
                marker.rotationControl.ring.material.opacity = dragging ? 0.82 : 0.48;
                marker.rotationControl.ring.material.needsUpdate = true;
              }
            }
          }
        }

        function createEditDeltaLine(color, opacity) {
          const material = new THREE.LineDashedMaterial({
            color: color,
            transparent: true,
            opacity: opacity,
            dashSize: Math.max(maxSpan * 0.005, 6.0),
            gapSize: Math.max(maxSpan * 0.0035, 4.0),
            depthTest: false,
            depthWrite: false,
          });
          const lineObject = new THREE.LineSegments(new THREE.BufferGeometry(), material);
          lineObject.visible = false;
          lineObject.renderOrder = 12;
          scene.add(lineObject);
          return lineObject;
        }

        function initEditDeltaLabelDrag(labelItem) {
          if (!labelItem || !labelItem.element) {
            return;
          }
          let dragging = false;
          let startX = 0;
          let startY = 0;
          let startOffsetX = 0;
          let startOffsetY = 0;
          const element = labelItem.element;
          element.title = "Перетащите, чтобы сместить плашку от точки";
          element.addEventListener("pointerdown", function (event) {
            dragging = true;
            interactionActive = true;
            hideTooltip();
            startX = Number(event.clientX || 0);
            startY = Number(event.clientY || 0);
            startOffsetX = Number(labelItem.offsetX || 0);
            startOffsetY = Number(labelItem.offsetY || 0);
            element.classList.add("is-dragging");
            try {
              element.setPointerCapture(event.pointerId);
            } catch (e) { /* ignore */ }
            event.preventDefault();
            event.stopPropagation();
          });
          element.addEventListener("pointermove", function (event) {
            if (!dragging) {
              return;
            }
            const dx = Number(event.clientX || 0) - startX;
            const dy = Number(event.clientY || 0) - startY;
            labelItem.offsetX = startOffsetX + dx;
            labelItem.offsetY = startOffsetY - dy;
            event.preventDefault();
            event.stopPropagation();
            requestRender();
          });
          const endDrag = function (event) {
            if (!dragging) {
              return;
            }
            dragging = false;
            interactionActive = false;
            element.classList.remove("is-dragging");
            try {
              element.releasePointerCapture(event.pointerId);
            } catch (e) { /* ignore */ }
            event.preventDefault();
            event.stopPropagation();
            requestRender();
          };
          element.addEventListener("pointerup", endDrag);
          element.addEventListener("pointercancel", endDrag);
        }

        function createEditDeltaGuide(pointType, color) {
          const label = addSceneLabel(
            "",
            new THREE.Vector3(0, 0, 0),
            color,
            "edit-delta-label",
            { offsetX: 14, offsetY: 18, role: "edit_delta_label" },
          );
          label.visible = false;
          initEditDeltaLabelDrag(label);
          return {
            pointType: pointType,
            lines: {
              x: createEditDeltaLine(EDIT_DELTA_AXIS_COLORS.x, 0.42),
              y: createEditDeltaLine(EDIT_DELTA_AXIS_COLORS.y, 0.42),
              z: createEditDeltaLine(EDIT_DELTA_AXIS_COLORS.z, 0.42),
              total: createEditDeltaLine(EDIT_DELTA_AXIS_COLORS.total, 0.32),
            },
            label: label,
          };
        }

        function updateDashedLineSegments(lineObject, segments, visible) {
          const positions = [];
          if (visible && Array.isArray(segments)) {
            segments.forEach((segment) => {
              if (!Array.isArray(segment) || segment.length !== 2) {
                return;
              }
              const start = displayPoint(segment[0]);
              const end = displayPoint(segment[1]);
              positions.push(start.x, start.y, start.z, end.x, end.y, end.z);
            });
          }
          lineObject.geometry.setAttribute(
            "position",
            new THREE.Float32BufferAttribute(new Float32Array(positions), 3),
          );
          if (typeof lineObject.computeLineDistances === "function") {
            lineObject.computeLineDistances();
          }
          lineObject.visible = Boolean(visible && positions.length > 0);
        }

        function hideEditDeltaGuide(guide) {
          if (!guide) {
            return;
          }
          guide.label.visible = false;
          Object.values(guide.lines).forEach((lineObject) => {
            lineObject.visible = false;
          });
        }

        function updateEditDeltaGuide(handle) {
          if (!handle || !handle.guide) {
            return;
          }
          const wellIndex = handle.wellIndex;
          const originalEntry = (editOriginalPoints[wellIndex] || [])[handle.pointIndex];
          const original = originalEntry
            ? originalEntry.position
            : handle.pointRole === "t1"
            ? editOriginalT1[wellIndex]
            : editOriginalT3[wellIndex];
          const current = handle.dataPos;
          const dx = current[0] - original[0];
          const dy = current[1] - original[1];
          const dz = current[2] - original[2];
          const total = Math.sqrt(dx * dx + dy * dy + dz * dz);
          const originalSidetrackMd = Number(
            originalEntry && originalEntry.sidetrackWindow
              ? originalEntry.sidetrackWindow.valueM
              : NaN,
          );
          const currentSidetrackMd = Number(
            handle.sidetrackWindow ? handle.sidetrackWindow.valueM : NaN,
          );
          const sidetrackMdDelta =
            handle.pointRole === "sidetrack_window" &&
            Number.isFinite(originalSidetrackMd) &&
            Number.isFinite(currentSidetrackMd)
              ? currentSidetrackMd - originalSidetrackMd
              : 0.0;
          const sidetrackMdDeltaRow =
            handle.pointRole === "sidetrack_window" &&
            Number.isFinite(originalSidetrackMd) &&
            Number.isFinite(currentSidetrackMd)
              ? `<span class="edit-delta-row"><span>ΔMD</span><span>${formatDeltaMeters(sidetrackMdDelta)}</span></span>`
              : "";
          const selected =
            editModeActive &&
            wellIndex === selectedEditWellIndex &&
            (total > EDIT_DELTA_EPS_M ||
              Math.abs(sidetrackMdDelta) > EDIT_DELTA_EPS_M);
          const guide = handle.guide;
          if (!selected) {
            hideEditDeltaGuide(guide);
            return;
          }
          const viaX = [current[0], original[1], original[2]];
          const viaY = [current[0], current[1], original[2]];

          updateDashedLineSegments(
            guide.lines.x,
            [[original, viaX]],
            selected && Math.abs(dx) > EDIT_DELTA_EPS_M,
          );
          updateDashedLineSegments(
            guide.lines.y,
            [[viaX, viaY]],
            selected && Math.abs(dy) > EDIT_DELTA_EPS_M,
          );
          updateDashedLineSegments(
            guide.lines.z,
            [[viaY, current]],
            selected && Math.abs(dz) > EDIT_DELTA_EPS_M,
          );
          updateDashedLineSegments(
            guide.lines.total,
            [[original, current]],
            selected,
          );

          guide.label.visible = selected;
          guide.label.position.copy(displayPoint(current));
          if (selected) {
            guide.label.element.innerHTML =
              `<span class="edit-delta-head">${escapeHtml(handle.pointType)}</span>` +
              `<span class="edit-delta-row"><span>ΔX</span><span>${formatDeltaMeters(dx)}</span></span>` +
              `<span class="edit-delta-row"><span>ΔY</span><span>${formatDeltaMeters(dy)}</span></span>` +
              `<span class="edit-delta-row"><span>ΔZ</span><span>${formatDeltaMeters(dz)}</span></span>` +
              sidetrackMdDeltaRow +
              `<span class="edit-delta-row edit-delta-total"><span>Итого</span><span>${formatDeltaMeters(total, false)}</span></span>`;
          }
        }

        function syncEditDeltaGuides() {
          editHandles.forEach(updateEditDeltaGuide);
        }

        function horizontalT1T3Length(wellIndex) {
          const t1 = editCurrentT1[wellIndex];
          const t3 = editCurrentT3[wellIndex];
          if (!t1 || !t3) {
            return 0.0;
          }
          return Math.hypot(t3[0] - t1[0], t3[1] - t1[1]);
        }

        function t1T3Length(wellIndex) {
          const t1 = editCurrentT1[wellIndex];
          const t3 = editCurrentT3[wellIndex];
          if (!t1 || !t3) {
            return 0.0;
          }
          return Math.hypot(t3[0] - t1[0], t3[1] - t1[1], t3[2] - t1[2]);
        }

        function t1T3Midpoint(wellIndex) {
          const t1 = editCurrentT1[wellIndex] || [0, 0, 0];
          const t3 = editCurrentT3[wellIndex] || [0, 0, 0];
          return [
            (Number(t1[0]) + Number(t3[0])) * 0.5,
            (Number(t1[1]) + Number(t3[1])) * 0.5,
            (Number(t1[2]) + Number(t3[2])) * 0.5,
          ];
        }

        function createEditLateralLabel(wellIndex) {
          const label = addSceneLabel(
            "",
            displayPoint(t1T3Midpoint(wellIndex)),
            "#1d4ed8",
            "edit-lateral-label",
            { offsetX: 0, offsetY: 0, role: "edit_lateral_label" },
          );
          label.visible = false;
          return label;
        }

        function editHandlePositionLabelHtml(handle) {
          const current = copyEditPoint((handle && handle.dataPos) || [0, 0, 0]);
          return (
            `<span class="edit-delta-head">${escapeHtml(String((handle && handle.pointType) || "Точка"))}</span>` +
            `<span class="edit-delta-row"><span>X</span><span>${formatCoordinateMeters(current[0])}</span></span>` +
            `<span class="edit-delta-row"><span>Y</span><span>${formatCoordinateMeters(current[1])}</span></span>` +
            `<span class="edit-delta-row"><span>Z</span><span>${formatCoordinateMeters(current[2])}</span></span>`
          );
        }

        function initMiniMapEditPositionLabel() {
          if (miniMapEditPositionLabel || !miniMapLabelLayer) {
            return;
          }
          miniMapEditPositionLabel = addMiniMapLabel(
            "",
            new THREE.Vector3(0, 0, 0),
            "minimap-edit-position-label",
            {
              role: "edit_position_label",
              offsetX: 12,
              offsetY: 18,
              useHtml: true,
            },
          );
          if (miniMapEditPositionLabel) {
            miniMapEditPositionLabel.visible = false;
          }
        }

        function syncMiniMapEditPositionLabel() {
          if (!miniMapEditPositionLabel) {
            return;
          }
          const handle = selectedEditHandle();
          const visible =
            editModeActive &&
            !Number.isInteger(selectedEditPadIndex) &&
            handle &&
            handle.mesh &&
            handle.mesh.visible;
          miniMapEditPositionLabel.visible = Boolean(visible);
          if (!visible) {
            return;
          }
          miniMapEditPositionLabel.position.copy(
            handle.mesh ? handle.mesh.position : displayPoint(handle.dataPos || [0, 0, 0]),
          );
          miniMapEditPositionLabel.element.innerHTML = editHandlePositionLabelHtml(handle);
        }

        function updateEditLateralLabel(wellIndex) {
          const label = editLateralLabels[wellIndex];
          if (!label) {
            return;
          }
          label.position.copy(displayPoint(t1T3Midpoint(wellIndex)));
          if (editWellHasExplicitPoints(wellIndex)) {
            const pointCount = (editCurrentPoints[wellIndex] || [])
              .filter((entry) => !isSidetrackWindowEntry(entry)).length;
            label.element.textContent = `Точек: ${pointCount}`;
          } else {
            label.element.textContent =
              `Длина ГС ${formatLengthMeters(t1T3Length(wellIndex))}`;
          }
          label.visible =
            editModeActive &&
            Number.isInteger(selectedEditWellIndex) &&
            wellIndex === selectedEditWellIndex;
        }

        function syncEditLateralLabels() {
          editLateralLabels.forEach((_, index) => updateEditLateralLabel(index));
        }

        function handleDeltaLength(handle) {
          if (!handle) {
            return 0.0;
          }
          const originalEntry =
            (editOriginalPoints[handle.wellIndex] || [])[handle.pointIndex];
          const original = originalEntry
            ? originalEntry.position
            : handle.pointRole === "t1"
            ? editOriginalT1[handle.wellIndex]
            : editOriginalT3[handle.wellIndex];
          const current = handle.dataPos;
          if (!original || !current) {
            return 0.0;
          }
          const dx = current[0] - original[0];
          const dy = current[1] - original[1];
          const dz = current[2] - original[2];
          return Math.sqrt(dx * dx + dy * dy + dz * dz);
        }

        function updateHandlePosition(handle, point) {
          const displayPosition = displayPoint(point);
          handle.dataPos = copyEditPoint(point);
          handle.mesh.position.copy(displayPosition);
          if (handle.pickMesh) {
            handle.pickMesh.position.copy(displayPosition);
          }
          if (handle.previewMesh) {
            handle.previewMesh.position.copy(displayPosition);
          }
        }

        function editWellLabelAnchorPoint(wellIndex) {
          const points = editCurrentPoints[wellIndex] || [];
          if (points.length > 0) {
            const targetPoints = points.filter((entry) => !isSidetrackWindowEntry(entry));
            if (targetPoints.length > 0) {
              return targetPoints[targetPoints.length - 1].position;
            }
            return points[points.length - 1].position;
          }
          return editCurrentT3[wellIndex];
        }

        function syncEditWellNameLabelPosition(wellIndex) {
          const well = editWells[wellIndex] || {};
          const wellName = String(well.name || "");
          const anchor = editWellLabelAnchorPoint(wellIndex);
          if (!wellName || !anchor) {
            return;
          }
          const displayPosition = displayPoint(anchor);
          sceneLabels.forEach((item) => {
            if (item.role === "well_label" && item.text === wellName) {
              item.position.copy(displayPosition);
            }
          });
          miniMapLabels.forEach((item) => {
            if (item.text === wellName) {
              item.position.copy(displayPosition);
            }
          });
        }

        function updateWellEditPoints(wellIndex, nextPoints) {
          editCurrentPoints[wellIndex] = copyEditPointEntries(nextPoints);
          syncPrimaryEditTargetsFromPoints(wellIndex);
          editHandles.forEach((handle) => {
            if (handle.wellIndex !== wellIndex) {
              return;
            }
            const pointEntry = editCurrentPoints[wellIndex][handle.pointIndex];
            if (!pointEntry) {
              return;
            }
            handle.sidetrackWindow = pointEntry.sidetrackWindow || null;
            updateHandlePosition(handle, pointEntry.position);
          });
          syncEditWellNameLabelPosition(wellIndex);
          keepMiniMapOnActiveEditSelection();
        }

        function updateWellEditTargets(wellIndex, t1, t3) {
          editCurrentT1[wellIndex] = copyEditPoint(t1);
          editCurrentT3[wellIndex] = copyEditPoint(t3);
          const currentPoints = editCurrentPoints[wellIndex] || [];
          const nextPoints = copyEditPointEntries(currentPoints);
          let firstT1Updated = false;
          let lastT3Index = -1;
          nextPoints.forEach((entry, index) => {
            if (entry.pointType === "t1" && !firstT1Updated) {
              entry.position = copyEditPoint(t1);
              firstT1Updated = true;
            }
            if (entry.pointType === "t3") {
              lastT3Index = index;
            }
          });
          if (lastT3Index >= 0) {
            nextPoints[lastT3Index].position = copyEditPoint(t3);
          }
          editCurrentPoints[wellIndex] = nextPoints;
          editHandles.forEach((handle) => {
            if (handle.wellIndex !== wellIndex) {
              return;
            }
            const pointEntry = editCurrentPoints[wellIndex][handle.pointIndex];
            if (pointEntry) {
              handle.sidetrackWindow = pointEntry.sidetrackWindow || null;
              updateHandlePosition(handle, pointEntry.position);
            }
          });
          syncEditWellNameLabelPosition(wellIndex);
          keepMiniMapOnActiveEditSelection();
        }

        function applyEditState(wellIndex, state) {
          if (!Number.isInteger(wellIndex) || !state) {
            return;
          }
          if (Array.isArray(state.points) && state.points.length > 0) {
            updateWellEditPoints(wellIndex, state.points);
          } else {
            updateWellEditTargets(wellIndex, state.t1, state.t3);
          }
          editDirtyFlags[wellIndex] = isEditWellDirty(wellIndex);
          rebuildPreviewTrajectory(wellIndex);
          resetEditSaveButtonState();
          showEditFeedback();
          syncEditToolboxState();
          requestRender();
        }

        function pushEditUndoState(wellIndex, previousState) {
          if (!Number.isInteger(wellIndex) || !previousState) {
            return;
          }
          const currentState = cloneEditState(wellIndex);
          if (editStatesEqual(previousState, currentState)) {
            return;
          }
          const undoStack = editUndoStacks[wellIndex];
          undoStack.push({
            points: copyEditPointEntries(previousState.points),
            t1: copyEditPoint(previousState.t1),
            t3: copyEditPoint(previousState.t3),
          });
          if (undoStack.length > 60) {
            undoStack.shift();
          }
          editRedoStacks[wellIndex] = [];
          syncEditToolboxState();
        }

        function collectEditStates(indices) {
          const states = new Map();
          normalizedEditWellSelection(indices, null).forEach((wellIndex) => {
            states.set(wellIndex, cloneEditState(wellIndex));
          });
          return states;
        }

        function pushEditUndoStates(previousStates) {
          if (!(previousStates instanceof Map)) {
            return;
          }
          previousStates.forEach((previousState, wellIndex) => {
            pushEditUndoState(wellIndex, previousState);
          });
        }

        function pointEntryIndicesForSync(entries, pointLabel, pointRole) {
          const safeEntries = Array.isArray(entries) ? entries : [];
          const normalizedLabel = String(pointLabel || "");
          const normalizedRole = String(pointRole || "");
          const exactMatches = safeEntries
            .map((entry, index) => ({ entry: entry, index: index }))
            .filter(({ entry }) =>
              String(entry && entry.pointType) === normalizedRole &&
              String(entry && entry.label) === normalizedLabel,
            )
            .map(({ index }) => index);
          if (exactMatches.length > 0) {
            return exactMatches;
          }
          if (normalizedRole === "t1") {
            const firstT1Index = safeEntries.findIndex(
              (entry) => String(entry && entry.pointType) === "t1",
            );
            return firstT1Index >= 0 ? [firstT1Index] : [];
          }
          if (normalizedRole === "t3") {
            for (let index = safeEntries.length - 1; index >= 0; index -= 1) {
              if (String(safeEntries[index] && safeEntries[index].pointType) === "t3") {
                return [index];
              }
            }
          }
          return [];
        }

        function applyPairDeltaFromState(wellIndex, baseState, delta) {
          if (!baseState) {
            return false;
          }
          if (Array.isArray(baseState.points) && baseState.points.length > 0) {
            const nextPoints = copyEditPointEntries(baseState.points).map((entry) => ({
              index: entry.index,
              label: entry.label,
              pointType: entry.pointType,
              position: editEntryMovesWithPairScope(entry)
                ? addDeltaToPoint(entry.position, delta)
                : copyEditPoint(entry.position),
              sidetrackWindow: entry.sidetrackWindow || null,
            }));
            updateWellEditPoints(wellIndex, nextPoints);
            return true;
          }
          updateWellEditTargets(
            wellIndex,
            addDeltaToPoint(baseState.t1, delta),
            addDeltaToPoint(baseState.t3, delta),
          );
          return true;
        }

        function applyPointDeltaFromState(wellIndex, baseState, pointLabel, pointRole, delta) {
          if (!baseState) {
            return false;
          }
          const normalizedRole = String(pointRole || "");
          if (normalizedRole !== "t1" && normalizedRole !== "t3") {
            return false;
          }
          if (Array.isArray(baseState.points) && baseState.points.length > 0) {
            const nextPoints = copyEditPointEntries(baseState.points);
            const pointIndices = pointEntryIndicesForSync(
              nextPoints,
              pointLabel,
              normalizedRole,
            );
            if (pointIndices.length === 0) {
              return false;
            }
            pointIndices.forEach((pointIndex) => {
              nextPoints[pointIndex].position = addDeltaToPoint(
                nextPoints[pointIndex].position,
                delta,
              );
            });
            updateWellEditPoints(wellIndex, nextPoints);
            return true;
          }
          const nextT1 = copyEditPoint(baseState.t1);
          const nextT3 = copyEditPoint(baseState.t3);
          if (normalizedRole === "t1") {
            nextT1[0] += Number(delta[0]) || 0.0;
            nextT1[1] += Number(delta[1]) || 0.0;
            nextT1[2] += Number(delta[2]) || 0.0;
          } else {
            nextT3[0] += Number(delta[0]) || 0.0;
            nextT3[1] += Number(delta[1]) || 0.0;
            nextT3[2] += Number(delta[2]) || 0.0;
          }
          updateWellEditTargets(wellIndex, nextT1, nextT3);
          return true;
        }

        function synchronizedEditWellIndices(primaryWellIndex, pointRole, moveScope) {
          if (!isValidEditWellIndex(primaryWellIndex)) {
            return [];
          }
          const normalizedRole = String(pointRole || "");
          const normalizedScope = String(moveScope || "");
          if (
            selectedEditWellIndices.size <= 1 ||
            !selectedEditWellIndices.has(primaryWellIndex) ||
            (
              normalizedScope !== "pair" &&
              normalizedRole !== "t1" &&
              normalizedRole !== "t3"
            )
          ) {
            return [primaryWellIndex];
          }
          return selectedEditWellIndexArray();
        }

        function applySynchronizedDeltaFromStates(baseStates, primaryWellIndex, handle, delta, moveScope) {
          const primaryHandle = handle || {};
          const affectedIndices = synchronizedEditWellIndices(
            primaryWellIndex,
            primaryHandle.pointRole,
            moveScope,
          );
          const normalizedScope = String(moveScope || "");
          const appliedIndices = [];
          affectedIndices.forEach((wellIndex) => {
            const baseState =
              baseStates instanceof Map && baseStates.has(wellIndex)
                ? baseStates.get(wellIndex)
                : cloneEditState(wellIndex);
            const applied =
              normalizedScope === "pair"
                ? applyPairDeltaFromState(wellIndex, baseState, delta)
                : applyPointDeltaFromState(
                    wellIndex,
                    baseState,
                    primaryHandle.pointType,
                    primaryHandle.pointRole,
                    delta,
                  );
            if (applied) {
              appliedIndices.push(wellIndex);
            }
          });
          return appliedIndices;
        }

