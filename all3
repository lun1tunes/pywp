        transform: translate(10px, -100%);
        text-shadow: 0 1px 2px rgba(255,255,255,0.95);
        backdrop-filter: blur(4px);
        white-space: nowrap;
        contain: layout paint;
      }

      .minimap-edit-delta-label .edit-delta-head {
        display: block;
        margin-bottom: 3px;
        color: rgba(15,23,42,0.88);
        font-family:
          Inter,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;
        font-size: 10px;
        font-weight: 700;
