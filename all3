def _legacy_overlap_volume_payloads(corridors: Iterable[object]) -> list[dict[str, object]]:
    volumes: list[dict[str, object]] = []
    for index, corridor in enumerate(corridors):
        rings = _overlap_volume_rings(corridor)
        if len(rings) < 2:
            continue
