      .minimap-edit-position-label .edit-delta-row {
        display: flex;
        justify-content: space-between;
        gap: 8px;
      }

      .minimap-edit-lateral-label {
        position: absolute;
        display: none;
        padding: 4px 8px;
        border: 1px solid rgba(37,99,235,0.18);
        border-radius: 999px;
        background: rgba(255,255,255,0.80);
        box-shadow: 0 4px 10px rgba(15,23,42,0.08);
        color: #1d4ed8;
        font-family:
          "SFMono-Regular",
          ui-monospace,
          Menlo,
          Consolas,
          monospace;
        font-size: 10px;
        font-weight: 700;
        text-shadow: 0 1px 2px rgba(255,255,255,0.95);
        transform: translate(-50%, -50%);
        white-space: nowrap;
        contain: layout paint;
      }

      #minimap-axes {
        display: none;
        position: absolute;
        z-index: 4;
        width: 62px;
        height: 62px;
        color: #334155;
        opacity: 0.86;
        pointer-events: none;
      }

      #minimap-axes.is-visible {
        display: block;
      }

      .minimap-axis {
        position: absolute;
        background: currentColor;
        box-shadow: 0 1px 2px rgba(255,255,255,0.9);
      }

      .minimap-axis::after {
        content: "";
        position: absolute;
        width: 0;
        height: 0;
      }

      .minimap-axis-x {
        left: 13px;
        bottom: 14px;
        width: 34px;
        height: 2px;
        color: #16A34A;
      }

      .minimap-axis-x::after {
        right: -1px;
        top: -4px;
        border-left: 7px solid currentColor;
        border-top: 5px solid transparent;
        border-bottom: 5px solid transparent;
      }

      .minimap-axis-y {
        left: 13px;
        bottom: 14px;
        width: 2px;
        height: 34px;
        color: #2563EB;
      }

      .minimap-axis-y::after {
        left: -4px;
        top: -1px;
        border-bottom: 7px solid currentColor;
        border-left: 5px solid transparent;
        border-right: 5px solid transparent;
      }

      .minimap-axis-label {
        position: absolute;
        color: currentColor;
        font-size: 10px;
        font-weight: 800;
        line-height: 1;
        text-shadow: 0 1px 2px rgba(255,255,255,0.95);
        white-space: nowrap;
      }

      .minimap-axis-label-x {
        right: 2px;
        bottom: 1px;
        color: #16A34A;
      }

      .minimap-axis-label-y {
        left: 0;
        top: 0;
        color: #2563EB;
      }

      #minimap-control {
        position: absolute;
        right: 14px;
        bottom: 14px;
        z-index: 5;
        display: flex;
        align-items: center;
        gap: 8px;
        pointer-events: none;
      }

      #minimap-control.is-expanded {
        height: 28px;
        justify-content: center;
        overflow: hidden;
      }

      #minimap-label {
        padding: 0;
        border: none;
        border-radius: 0;
        background: transparent;
        color: #334155;
        box-shadow: none;
        font-size: 12px;
        font-weight: 700;
        line-height: 1.15;
        pointer-events: none;
        text-shadow: 0 1px 2px rgba(255,255,255,0.95);
        white-space: nowrap;
      }

      #minimap-label.is-expanded {
        position: absolute;
        left: 50%;
        top: 6px;
        max-width: calc(100% - 84px);
        overflow: hidden;
        text-overflow: ellipsis;
        transform: translateX(-50%);
        background: transparent;
        box-shadow: none;
      }

      #minimap-toggle-btn {
        width: 28px;
        height: 28px;
        border: none;
        border-radius: 0;
        background: transparent;
        color: #475569;
        box-shadow: none;
        cursor: pointer;
        font-size: 22px;
        font-weight: 800;
        line-height: 1;
        pointer-events: auto;
      }

      #minimap-control:not(.is-expanded) #minimap-label {
        display: none;
      }

      #minimap-control:not(.is-expanded) #minimap-toggle-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        width: auto;
        min-width: 94px;
        height: 30px;
        padding: 0 10px;
        border: 1px solid rgba(15,23,42,0.16);
        border-radius: 8px;
        background: rgba(255,255,255,0.88);
        box-shadow: 0 6px 16px rgba(15,23,42,0.10);
        color: #334155;
        font-size: 12px;
        font-weight: 500;
      }

      #minimap-control:not(.is-expanded) #minimap-toggle-btn::before {
        content: "‹";
        font-size: 16px;
        font-weight: 500;
        line-height: 1;
      }

      #minimap-control.is-expanded #minimap-toggle-btn {
        position: absolute;
        left: 0;
        top: 0;
        width: 28px;
        height: 28px;
        padding: 0;
        border: none;
        background: transparent;
        box-shadow: none;
        color: transparent;
        cursor: nwse-resize;
      }

      #minimap-control.is-expanded #minimap-toggle-btn::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0;
        width: 0;
        height: 0;
        border-top: 18px solid rgba(71,85,105,0.62);
        border-right: 18px solid transparent;
      }

      #minimap-control.is-expanded #minimap-toggle-btn::after {
        content: "";
        position: absolute;
        left: 5px;
        top: 5px;
        width: 7px;
        height: 7px;
        border-left: 2px solid rgba(255,255,255,0.88);
        border-top: 2px solid rgba(255,255,255,0.88);
      }

      #minimap-toggle-btn:hover {
        color: #0f172a;
      }

      #minimap-control.is-expanded #minimap-toggle-btn:hover::before {
        border-top-color: rgba(51,65,85,0.74);
      }

      #minimap-ruler-btn {
        display: none;
        pointer-events: auto;
      }

      #minimap-control.is-expanded #minimap-ruler-btn {
        position: absolute;
        right: 0;
        top: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        padding: 0;
        border: none;
        border-radius: 999px;
        background: rgba(255,255,255,0.76);
        color: #475569;
        box-shadow: 0 3px 10px rgba(15,23,42,0.12);
        cursor: pointer;
        line-height: 1;
        transition:
          background 0.16s ease,
          color 0.16s ease,
          box-shadow 0.16s ease,
          transform 0.16s ease;
      }

      .minimap-ruler-icon {
        width: 15px;
        height: 15px;
        stroke: currentColor;
        fill: none;
        stroke-width: 1.8;
        stroke-linecap: round;
        stroke-linejoin: round;
      }

      #minimap-ruler-btn:hover {
        background: rgba(255,255,255,0.92);
        color: #0f172a;
      }

      #minimap-control.is-expanded #minimap-ruler-btn.is-active {
        background: rgba(37,99,235,0.24);
        color: #1d4ed8;
        box-shadow:
          inset 0 0 0 1.6px rgba(37,99,235,0.62),
          0 4px 12px rgba(29,78,216,0.22);
        transform: translateY(-0.5px);
      }

      #minimap-control.is-expanded #minimap-ruler-btn.is-active:hover {
        background: rgba(37,99,235,0.28);
        color: #1d4ed8;
      }

      @keyframes fadeInUp {
        from { opacity: 0; transform: translateY(8px); }
        to { opacity: 1; transform: translateY(0); }
      }
    </style>
  </head>
  <body>
    <div id="root">
      <div id="toolbar-left">
        <button id="fit-camera-btn" class="toolbar-btn" type="button" title="Подогнать сцену под кадр">Сброс вида</button>
        <button id="edit-targets-btn" class="toolbar-btn" type="button" title="Изменить точки скважины" style="display:none">Редактировать точки</button>
        <div id="anti-collision-control-wrap">
        <button id="anti-collision-btn" class="toolbar-btn" type="button" title="Слои anti-collision">Anti-collision</button>
          <div id="anti-collision-controls">
            <label class="anti-collision-option">
              <input type="checkbox" data-ac-layer="cones" checked />
              <span>Конусы неопределенности</span>
            </label>
            <label class="anti-collision-option">
              <input type="checkbox" data-ac-layer="sidetrack_relative_cones" />
              <span>Относительные конуса боковых стволов</span>
            </label>
            <label class="anti-collision-option">
              <input type="checkbox" data-ac-layer="overlaps" checked />
              <span>Зоны пересечений</span>
            </label>
            <label class="anti-collision-option">
              <input type="checkbox" data-ac-layer="segments" checked />
              <span>Конфликтные участки ствола</span>
            </label>
          </div>
        </div>
        <div id="world-axis-control-wrap">
          <button
            id="world-axis-btn"
            class="toolbar-btn is-mini"
            type="button"
            title="Настроить координатную ось"
            aria-label="Настроить координатную ось"
          >⚙</button>
          <div id="world-axis-controls">
            <label class="anti-collision-option">
              <input id="world-axis-toggle" type="checkbox" />
              <span>Показать координатную ось</span>
            </label>
            <label class="anti-collision-option">
              <input id="reference-labels-toggle" type="checkbox" />
