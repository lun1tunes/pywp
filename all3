        == planning_uncertainty_model_for_preset(
            UNCERTAINTY_PRESET_MWD_UNKNOWN_MAGNETIC
        ).iscwsa_tool_code
    )
    assert state[ptc_anticollision_params.ACTUAL_REFERENCE_MWD_UNKNOWN_NAMES_KEY] == [
        "FACT-2",
        "MISSING",
    ]


