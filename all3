        }

        const axisOverlayDefinitions = [
          {
            key: "x",
            label: "X / East",
            color: "#16A34A",
            vector: new THREE.Vector3(1, 0, 0),
          },
          {
            key: "y",
            label: "Y / North",
            color: "#2563EB",
            vector: new THREE.Vector3(0, 1, 0),
          },
          {
            key: "z",
            label: "Z",
            color: "#DC2626",
            vector: new THREE.Vector3(0, 0, -1),
          },
        ];

        function updateAxesGizmo() {
          if (!axesGizmoElement) {
            return;
          }
          const width = Math.max(axesGizmoElement.clientWidth || 136, 136);
          const height = Math.max(axesGizmoElement.clientHeight || 118, 118);
          const centerX = 58;
          const centerY = 42;
          const radius = Math.min(width, height) * 0.34;
          const inverseCameraQuaternion = camera.quaternion.clone().invert();
          const axisItems = axisOverlayDefinitions.map((item) => {
            const projected = item.vector
              .clone()
              .applyQuaternion(inverseCameraQuaternion)
              .normalize();
            return {
              label: item.label,
              color: item.color,
              x: centerX + projected.x * radius,
              y: centerY - projected.y * radius,
              z: projected.z,
            };
          });
          axisItems.sort((left, right) => left.z - right.z);
          const lines = axisItems
            .map(
              (item) =>
                `<line class="axes-gizmo-line" x1="${centerX.toFixed(1)}" y1="${centerY.toFixed(1)}" x2="${item.x.toFixed(1)}" y2="${item.y.toFixed(1)}" stroke="${item.color}" opacity="${(item.z > 0 ? 1.0 : 0.72).toFixed(2)}"></line>`,
            )
            .join("");
          const labels = axisItems
            .map((item) => {
              const dx = item.x - centerX;
              const dy = item.y - centerY;
              const labelX = item.x + (Math.abs(dx) < 4 ? 0 : Math.sign(dx) * 7);
              const labelY = item.y + (Math.abs(dy) < 4 ? 0 : Math.sign(dy) * 7);
              const textAnchor =
                Math.abs(dx) < 6 ? "middle" : dx > 0 ? "start" : "end";
              return `<text class="axes-gizmo-label" x="${labelX.toFixed(1)}" y="${labelY.toFixed(1)}" fill="${item.color}" text-anchor="${textAnchor}">${item.label}</text>`;
            })
            .join("");
          axesGizmoElement.innerHTML =
            `<svg viewBox="0 0 ${width} ${height}" aria-hidden="true">` +
            `<circle class="axes-gizmo-center" cx="${centerX.toFixed(1)}" cy="${centerY.toFixed(1)}" r="3.2"></circle>` +
            lines +
            labels +
            `</svg>`;
        }

        const worldAxisRaycaster = new THREE.Raycaster();
        const worldAxisPointer = new THREE.Vector2();
        const worldAxisPlane = new THREE.Plane(new THREE.Vector3(0, 0, 1), 0);
        const worldAxisHitPoint = new THREE.Vector3();

        function worldAxisPlaneIntersectionRaw(ndcX, ndcY, rawZ) {
          const planeDisplayZ =
            ((Number(rawZ) - Number(sceneOrigin.z || 0)) * Z_DISPLAY_SIGN) /
            Math.max(worldAxisZScaleFactor(), 1.0);
          worldAxisPlane.constant = -planeDisplayZ;
          worldAxisPointer.set(Number(ndcX) || 0, Number(ndcY) || 0);
          worldAxisRaycaster.setFromCamera(worldAxisPointer, camera);
          if (!worldAxisRaycaster.ray.intersectPlane(worldAxisPlane, worldAxisHitPoint)) {
            return null;
          }
          const rawPoint = dataPointFromDisplay(worldAxisHitPoint);
          return [Number(rawPoint[0]) || 0, Number(rawPoint[1]) || 0, Number(rawZ) || 0];
        }

        function worldAxisNiceStep(rawValue) {
          const safeValue = Math.max(Number(rawValue) || 0, 0.000001);
          const exponent = Math.floor(Math.log10(safeValue));
          const base = Math.pow(10, exponent);
          const scaled = safeValue / base;
          if (scaled <= 1.0) {
            return 1.0 * base;
          }
          if (scaled <= 2.0) {
            return 2.0 * base;
          }
          if (scaled <= 5.0) {
            return 5.0 * base;
          }
          return 10.0 * base;
        }

        function worldAxisZScaleLabel() {
          return `1:${formatViewerZScaleFactor(worldAxisZScaleFactor())}`;
        }

        function worldAxisDisplayZ(rawZValue) {
          return (
            (Number(rawZValue) || 0) *
            Z_DISPLAY_SIGN /
            Math.max(worldAxisZScaleFactor(), 1.0)
          );
        }

        function formatWorldAxisValue(value, step) {
          const safeStep = Math.max(Math.abs(Number(step) || 0), 0.000001);
          const decimals =
            safeStep >= 10.0 ? 0 :
            safeStep >= 1.0 ? 1 :
            safeStep >= 0.1 ? 2 :
            3;
          return Number(value || 0).toFixed(decimals);
        }

        function formatWorldAxisDistance(rawDistance) {
          const safeDistance = Math.abs(Number(rawDistance) || 0);
          const decimals =
            safeDistance >= 100.0 ? 0 :
            safeDistance >= 10.0 ? 1 :
            safeDistance >= 1.0 ? 2 :
            3;
          return `${String(Number(safeDistance.toFixed(decimals))).replace(".", ",")} м`;
        }

        function worldAxisSubdivisionForPixelSpan(pixelSpan) {
          const safeSpan = Math.max(Number(pixelSpan) || 0, 0);
          if (safeSpan >= 560.0) {
            return 10;
          }
          if (safeSpan >= 300.0) {
            return 5;
          }
          if (safeSpan >= 150.0) {
            return 2;
          }
          return 1;
        }

        function worldAxisAdaptiveMajorStep(
          unitsPerPixel,
          coverageStep,
          targetPixelSpan,
          minRawStep,
          scaleFactor,
        ) {
          const safeUnitsPerPixel = Math.max(Number(unitsPerPixel) || 0, 0.000001);
          const safeCoverageStep = Math.max(Number(coverageStep) || 0, 0.000001);
          const safePixelSpan = Math.max(Number(targetPixelSpan) || 0, 1.0);
          const safeMinRawStep = Math.max(Number(minRawStep) || 0, 0.000001);
          const safeScaleFactor = Math.max(Number(scaleFactor) || 1.0, 1.0);
          const desiredRawStep = Math.max(
            safeUnitsPerPixel * safePixelSpan * safeScaleFactor,
            safeMinRawStep,
          );
          return Math.min(safeCoverageStep, worldAxisNiceStep(desiredRawStep));
        }

        function worldAxisAdaptiveZMajorStep(
          unitsPerPixel,
          coverageStep,
          targetPixelSpan,
          minRawStep,
          scaleFactor,
        ) {
          const safeUnitsPerPixel = Math.max(Number(unitsPerPixel) || 0, 0.000001);
          const safeCoverageStep = Math.max(Number(coverageStep) || 0, 0.000001);
          const safePixelSpan = Math.max(Number(targetPixelSpan) || 0, 1.0);
          const safeMinRawStep = Math.max(Number(minRawStep) || 0, 0.000001);
          const safeScaleFactor = Math.max(Number(scaleFactor) || 1.0, 1.0);
          const desiredRawStep = Math.max(
            safeUnitsPerPixel * safePixelSpan * safeScaleFactor,
            safeMinRawStep,
          );
          const allowedSteps = [10000.0, 5000.0, 2000.0, 1000.0, 500.0, 100.0, 50.0];
          let coarsestWithinCoverage = 0.0;
          let selectedStep = 0.0;
          allowedSteps.forEach((step) => {
            if (step > safeCoverageStep + 1e-6) {
              return;
            }
            if (coarsestWithinCoverage <= 0.0) {
              coarsestWithinCoverage = step;
            }
            if (step + 1e-6 >= desiredRawStep) {
              selectedStep = step;
            }
          });
          if (selectedStep > 0.0) {
            return selectedStep;
          }
          if (coarsestWithinCoverage > 0.0) {
            return coarsestWithinCoverage;
          }
          return Math.min(safeCoverageStep, worldAxisNiceStep(desiredRawStep));
        }

        function clearWorldAxisGeometry() {
          while (worldAxisOverlay.group.children.length > 0) {
            const child =
              worldAxisOverlay.group.children[worldAxisOverlay.group.children.length - 1];
            if (!child) {
              continue;
            }
            worldAxisOverlay.group.remove(child);
            if (child.geometry && typeof child.geometry.dispose === "function") {
              child.geometry.dispose();
            }
            if (child.material) {
              if (Array.isArray(child.material)) {
                child.material.forEach((material) => {
                  if (material && typeof material.dispose === "function") {
                    material.dispose();
                  }
                });
              } else if (typeof child.material.dispose === "function") {
                child.material.dispose();
              }
            }
          }
        }

        function normalizedRawBounds(rawBounds) {
          if (!rawBounds || typeof rawBounds !== "object") {
            return null;
          }
          const rawMin = Array.isArray(rawBounds.min) ? rawBounds.min : null;
          const rawMax = Array.isArray(rawBounds.max) ? rawBounds.max : null;
          if (!rawMin || !rawMax || rawMin.length < 3 || rawMax.length < 3) {
            return null;
          }
          const minX = dataNumber(rawMin[0], 0);
          const minY = dataNumber(rawMin[1], 0);
          const minZ = dataNumber(rawMin[2], 0);
          const maxX = dataNumber(rawMax[0], minX);
          const maxY = dataNumber(rawMax[1], minY);
          const maxZ = dataNumber(rawMax[2], minZ);
          return {
            min: [
              Math.min(minX, maxX),
              Math.min(minY, maxY),
              Math.min(minZ, maxZ),
            ],
            max: [
              Math.max(minX, maxX),
              Math.max(minY, maxY),
              Math.max(minZ, maxZ),
            ],
          };
        }

        function worldAxisDefaultPadFocusId() {
          return worldAxisPadFocusIds.length > 0
            ? String(worldAxisPadFocusIds[0] || "")
            : "";
        }

        function worldAxisPadFocusIdForFocusId(focusId) {
          const normalizedId = String(focusId || "").trim();
          if (!normalizedId) {
            return "";
          }
          if (worldAxisFocusPadById.has(normalizedId)) {
            return String(worldAxisFocusPadById.get(normalizedId) || "");
          }
          return normalizedId.startsWith("pad::") ? normalizedId : "";
        }

        function worldAxisRawBoundsForPadFocusId(focusId) {
          const normalizedFocusId = String(focusId || "").trim();
          if (!normalizedFocusId) {
            return null;
          }
          return normalizedRawBounds(focusTargets[normalizedFocusId]);
        }

        function worldAxisCurrentRawBounds() {
          return (
            worldAxisRawBoundsForPadFocusId(worldAxisOverlay.activePadFocusId) ||
            normalizedRawBounds(payload.bounds) || {
              min: [0.0, 0.0, 0.0],
              max: [1000.0, 1000.0, 1000.0],
            }
          );
        }

        function worldAxisPlaneRawZ(rawBounds) {
          const bounds = normalizedRawBounds(rawBounds) || worldAxisCurrentRawBounds();
          const rawMax = Array.isArray(bounds.max) ? bounds.max : [0, 0, 0];
          const deepestRawZ = dataNumber(rawMax[2], 0);
          const roundStep = Math.max(Number(WORLD_AXIS_PLANE_Z_ROUND_STEP) || 100.0, 1.0);
          const roundedRawZ = Math.ceil(deepestRawZ / roundStep) * roundStep;
          if (!Number.isFinite(roundedRawZ)) {
            return 0.0;
          }
          return roundedRawZ <= deepestRawZ + 1e-6
            ? roundedRawZ + roundStep
            : roundedRawZ;
        }

        function worldAxisTopRawZ(rawBounds) {
          const bounds = normalizedRawBounds(rawBounds) || worldAxisCurrentRawBounds();
          const rawMin = Array.isArray(bounds.min) ? bounds.min : [0, 0, 0];
          const shallowestRawZ = dataNumber(rawMin[2], 0);
          const roundStep = Math.max(Number(WORLD_AXIS_PLANE_Z_ROUND_STEP) || 100.0, 1.0);
          const roundedRawZ = Math.floor(shallowestRawZ / roundStep) * roundStep;
          if (!Number.isFinite(roundedRawZ)) {
            return 0.0;
          }
          return Math.min(roundedRawZ, 0.0);
        }

        function worldAxisRawLevelMatches(leftRawZ, rightRawZ) {
          return Math.abs((Number(leftRawZ) || 0) - (Number(rightRawZ) || 0)) <= 1e-6;
        }

        function worldAxisMajorRawZValues(planeRawZ, topRawZ, zStep) {
          const values = [];
          const safeStep = Math.max(Number(zStep) || 0, 0.000001);
          const safeTopRawZ = Math.min(Number(topRawZ) || 0, 0.0);
          const bottomRawZ =
            Math.floor(Math.max(Number(planeRawZ) || 0, 0.0) / safeStep) * safeStep;
          for (let rawZ = bottomRawZ; rawZ >= safeTopRawZ; rawZ -= safeStep) {
            values.push(rawZ);
          }
          if (!values.some((rawZ) => worldAxisRawLevelMatches(rawZ, 0.0))) {
            values.push(0.0);
          }
          if (!values.some((rawZ) => worldAxisRawLevelMatches(rawZ, safeTopRawZ))) {
            values.push(safeTopRawZ);
          }
          values.sort((leftRawZ, rightRawZ) => rightRawZ - leftRawZ);
          return values;
        }

        function worldAxisMinorTickSpecs(planeRawZ, topRawZ, zStep, zMinorSubdivision) {
          const specs = [];
          const safeStep = Math.max(Number(zStep) || 0, 0.000001);
          const safeSubdivision = Math.max(Math.round(Number(zMinorSubdivision) || 1), 1);
          const tickStep = safeStep / safeSubdivision;
          const safeTopRawZ = Math.min(Number(topRawZ) || 0, 0.0);
          const bottomRawZ =
            Math.floor(Math.max(Number(planeRawZ) || 0, 0.0) / tickStep) * tickStep;
          for (let rawZ = bottomRawZ; rawZ >= safeTopRawZ; rawZ -= tickStep) {
            const major =
              Math.abs(
                rawZ - Math.round(rawZ / safeStep) * safeStep,
              ) <= 1e-6;
            specs.push({
              rawZ: rawZ,
              major: major,
            });
          }
          if (!specs.some((item) => worldAxisRawLevelMatches(item.rawZ, 0.0))) {
            specs.push({
              rawZ: 0.0,
              major: true,
            });
          }
          if (!specs.some((item) => worldAxisRawLevelMatches(item.rawZ, safeTopRawZ))) {
            specs.push({
              rawZ: safeTopRawZ,
              major:
                Math.abs(
                  safeTopRawZ - Math.round(safeTopRawZ / safeStep) * safeStep,
                ) <= 1e-6,
            });
          }
          specs.sort((leftItem, rightItem) => rightItem.rawZ - leftItem.rawZ);
          return specs;
        }

        function worldAxisBaseAnchorForBounds(rawBounds) {
          const bounds = normalizedRawBounds(rawBounds) || worldAxisCurrentRawBounds();
          return {
            x: (dataNumber(bounds.min[0], 0) + dataNumber(bounds.max[0], 0)) * 0.5,
            y: (dataNumber(bounds.min[1], 0) + dataNumber(bounds.max[1], 0)) * 0.5,
          };
        }

        function worldAxisResolvedAnchorRaw(xyStep, xTickCount, yTickCount) {
          const centeredX =
            dataNumber(worldAxisOverlay.baseAnchorRaw.x, 0) +
            dataNumber(worldAxisOverlay.dragOffsetRaw.x, 0);
          const centeredY =
            dataNumber(worldAxisOverlay.baseAnchorRaw.y, 0) +
            dataNumber(worldAxisOverlay.dragOffsetRaw.y, 0);
          if (
            !Number.isFinite(Number(xyStep)) ||
            !Number.isFinite(Number(xTickCount)) ||
            !Number.isFinite(Number(yTickCount))
          ) {
            return {
              x: centeredX,
              y: centeredY,
            };
          }
          return {
            x: centeredX - (Number(xyStep) * Number(xTickCount)) * 0.5,
            y: centeredY - (Number(xyStep) * Number(yTickCount)) * 0.5,
          };
        }

        function setWorldAxisActivePadFocus(focusId, options) {
          const padFocusId =
            worldAxisPadFocusIdForFocusId(focusId) || worldAxisDefaultPadFocusId();
          const activeBounds =
            worldAxisRawBoundsForPadFocusId(padFocusId) || normalizedRawBounds(payload.bounds);
          worldAxisOverlay.activePadFocusId = activeBounds ? padFocusId : "";
          worldAxisOverlay.activeBoundsRaw = activeBounds;
          worldAxisOverlay.baseAnchorRaw = worldAxisBaseAnchorForBounds(activeBounds);
          if (!options || options.resetOffset !== false) {
            worldAxisOverlay.dragOffsetRaw = { x: 0.0, y: 0.0 };
          }
          worldAxisOverlay.anchorRaw = worldAxisResolvedAnchorRaw();
          worldAxisOverlay.signature = "";
        }

        function syncWorldAxisActivePadFocus(options) {
          const currentBounds = worldAxisRawBoundsForPadFocusId(worldAxisOverlay.activePadFocusId);
          if (currentBounds && (!options || options.resetOffset !== true)) {
            worldAxisOverlay.activeBoundsRaw = currentBounds;
            worldAxisOverlay.baseAnchorRaw = worldAxisBaseAnchorForBounds(currentBounds);
            worldAxisOverlay.anchorRaw = worldAxisResolvedAnchorRaw();
            return;
          }
          setWorldAxisActivePadFocus(worldAxisOverlay.activePadFocusId, options);
        }

        function ensureWorldAxisLabels(count) {
          while (worldAxisOverlay.labels.length < count) {
            worldAxisOverlay.labels.push(
              addSceneLabel(
                "",
                new THREE.Vector3(0, 0, 0),
                "#5b6472",
                "world-axis-label",
                { role: "world_axis_overlay", offsetX: 0, offsetY: 0 },
              ),
            );
          }
          while (worldAxisOverlay.labels.length > count) {
            const item = worldAxisOverlay.labels.pop();
            if (!item) {
              continue;
            }
            item.visible = false;
            if (item.element && item.element.parentNode) {
              item.element.parentNode.removeChild(item.element);
            }
            const itemIndex = sceneLabels.indexOf(item);
            if (itemIndex >= 0) {
              sceneLabels.splice(itemIndex, 1);
            }
          }
        }

        function worldAxisDepthRangeRaw() {
          const rawBounds = worldAxisCurrentRawBounds();
          const planeZ = worldAxisPlaneRawZ(rawBounds);
          const topZ = worldAxisTopRawZ(rawBounds);
          return Math.max(planeZ - Math.min(topZ, planeZ), 0.0);
        }

        function worldAxisViewMetrics() {
          syncWorldAxisActivePadFocus({ resetOffset: false });
          const planeRawZ = worldAxisPlaneRawZ(worldAxisCurrentRawBounds());
          const anchorRaw = worldAxisResolvedAnchorRaw();
          worldAxisOverlay.anchorRaw = anchorRaw;
          const anchorDisplay = displayPoint([
            anchorRaw.x,
            anchorRaw.y,
            planeRawZ,
          ]);
          const unitsPerPixel = worldUnitsPerPixelAt(anchorDisplay);
          if (!Number.isFinite(unitsPerPixel) || unitsPerPixel <= 0.0) {
            const fallbackSpan = Math.max(maxSpan * 0.65, 100.0);
            return {
              anchorRaw: {
                x: anchorRaw.x,
                y: anchorRaw.y,
              },
              unitsPerPixel: fallbackSpan / Math.max(renderer.domElement.clientHeight || 1, 1),
            };
          }
          return {
            anchorRaw: {
              x: anchorRaw.x,
              y: anchorRaw.y,
            },
            unitsPerPixel: unitsPerPixel,
          };
        }

        function pushWorldAxisSegment(positions, start, end) {
          positions.push(
            Number(start[0]) || 0,
            Number(start[1]) || 0,
            Number(start[2]) || 0,
            Number(end[0]) || 0,
            Number(end[1]) || 0,
            Number(end[2]) || 0,
          );
        }

        function createWorldAxisLineSegments(positions, color, opacity, renderOrder) {
          const geometry = new THREE.BufferGeometry();
          geometry.setAttribute(
            "position",
            new THREE.Float32BufferAttribute(new Float32Array(positions), 3),
          );
          const material = new THREE.LineBasicMaterial({
            color: color,
            transparent: true,
            opacity: opacity,
            depthTest: false,
            depthWrite: false,
          });
          const lineSegments = new THREE.LineSegments(geometry, material);
          lineSegments.renderOrder = renderOrder;
          return lineSegments;
        }

        function buildWorldAxisLabelSpecs(
          planeRawZ,
          topRawZ,
          xyStep,
          zStep,
          xTickCount,
          yTickCount,
          zMajorRawValues,
          showXyStepLabels,
        ) {
          const xDirection = 1.0;
          const yDirection = 1.0;
          const xMax = xyStep * xTickCount * xDirection;
          const yMax = xyStep * yTickCount * yDirection;
          const zMax = Math.max(Number(planeRawZ) - Number(topRawZ), 0.0);
          const zScaleFactor = worldAxisZScaleFactor();
          const labelSpecs = [];
          for (let xIndex = 0; xIndex <= xTickCount; xIndex += 1) {
            const xValue = xyStep * xIndex * xDirection;
            labelSpecs.push({
              text: formatWorldAxisValue(
                worldAxisOverlay.anchorRaw.x + xValue,
                xyStep,
              ),
              color: "#5b6472",
              localPosition: new THREE.Vector3(xValue, yMax, 0),
              offsetX: 0,
              offsetY: -12,
            });
          }
          labelSpecs.push({
            text: formatWorldAxisValue(
              worldAxisOverlay.anchorRaw.y,
              xyStep,
            ),
            color: "#5b6472",
            localPosition: new THREE.Vector3(0, 0, 0),
            offsetX: -14,
            offsetY: 0,
          });
          labelSpecs.push({
            text: formatWorldAxisValue(
              planeRawZ,
              zStep,
            ),
            color: "#5b6472",
            localPosition: new THREE.Vector3(0, 0, 0),
            offsetX: 12,
            offsetY: 0,
          });
          for (let yIndex = 1; yIndex <= yTickCount; yIndex += 1) {
            const yValue = xyStep * yIndex * yDirection;
            labelSpecs.push({
              text: formatWorldAxisValue(
                worldAxisOverlay.anchorRaw.y + yValue,
                xyStep,
              ),
              color: "#5b6472",
              localPosition: new THREE.Vector3(0, yValue, 0),
              offsetX: -10,
              offsetY: 0,
            });
          }
          if (showXyStepLabels) {
            const xyStepLabel = formatWorldAxisDistance(xyStep);
            for (let xIndex = 0; xIndex < xTickCount; xIndex += 1) {
              const xMid = xyStep * (xIndex + 0.5) * xDirection;
              labelSpecs.push({
                text: xyStepLabel,
                color: "#6b7ea6",
                localPosition: new THREE.Vector3(xMid, yMax, 0),
                offsetX: 0,
                offsetY: 12,
              });
            }
            for (let yIndex = 0; yIndex < yTickCount; yIndex += 1) {
              const yMid = xyStep * (yIndex + 0.5) * yDirection;
              labelSpecs.push({
                text: xyStepLabel,
                color: "#6b7ea6",
                localPosition: new THREE.Vector3(0, yMid, 0),
                offsetX: 12,
                offsetY: 0,
              });
            }
          }
          const zLabelEvery = Math.max(
            1,
            Math.ceil(
              zMajorRawValues.length /
              Math.max(Math.floor(Math.abs(worldAxisDisplayZ(-zMax)) / 54.0), 3),
            ),
          );
          const pushZAxisCoordinateLabels = (
            axisLocalX,
            axisLocalY,
            coordinateOffsetX,
            coordinateOffsetY,
            includeBaseLabel,
          ) => {
            if (includeBaseLabel) {
              labelSpecs.push({
                text: formatWorldAxisValue(
                  planeRawZ,
                  zStep,
                ),
                color: "#5b6472",
                localPosition: new THREE.Vector3(axisLocalX, axisLocalY, 0),
                offsetX: coordinateOffsetX,
                offsetY: coordinateOffsetY,
              });
            }
            zMajorRawValues.forEach((rawZValue, zIndex) => {
              const isTop = worldAxisRawLevelMatches(rawZValue, topRawZ);
              const isZero = worldAxisRawLevelMatches(rawZValue, 0.0);
              if (
                !isTop &&
                !isZero &&
                zIndex !== zMajorRawValues.length - 1 &&
                zIndex % zLabelEvery !== 0
              ) {
                return;
              }
              const distanceFromPlane = Number(planeRawZ) - Number(rawZValue);
              if (distanceFromPlane <= 0.0) {
                return;
              }
              labelSpecs.push({
                text: formatWorldAxisValue(
                  rawZValue,
                  zStep,
                ),
                color: "#5b6472",
                localPosition: new THREE.Vector3(
                  axisLocalX,
                  axisLocalY,
                  worldAxisDisplayZ(-distanceFromPlane),
                ),
                offsetX: coordinateOffsetX,
                offsetY: coordinateOffsetY,
              });
            });
          };
          pushZAxisCoordinateLabels(0, 0, 10, 0, false);
          pushZAxisCoordinateLabels(xMax, yMax, 10, 0, true);
          pushZAxisCoordinateLabels(0, yMax, 14, 0, true);
          const pushZAxisTitleLabel = (axisLocalX, axisLocalY, offsetX, offsetY) => {
            labelSpecs.push({
              text: "Z",
              color: "#6b7280",
              localPosition: new THREE.Vector3(
                axisLocalX,
                axisLocalY,
                worldAxisDisplayZ(-zMax),
              ),
              offsetX: offsetX,
              offsetY: offsetY - 10,
            });
          };
          labelSpecs.push({
            text: "X",
            color: "#6b7280",
            localPosition: new THREE.Vector3(xMax, yMax, 0),
            offsetX: 10,
            offsetY: -2,
          });
          labelSpecs.push({
            text: "Y",
            color: "#6b7280",
            localPosition: new THREE.Vector3(0, yMax, 0),
            offsetX: -2,
            offsetY: 12,
          });
          pushZAxisTitleLabel(0, 0, 8, 0);
          pushZAxisTitleLabel(xMax, yMax, 8, 0);
          pushZAxisTitleLabel(0, yMax, 16, 0);
          return labelSpecs;
        }

        function rebuildWorldAxisGeometry() {
          const metrics = worldAxisViewMetrics();
          const activeBounds = worldAxisCurrentRawBounds();
          const planeRawZ = worldAxisPlaneRawZ(activeBounds);
          const topRawZ = worldAxisTopRawZ(activeBounds);
          const xDirection = 1.0;
          const yDirection = 1.0;
          const xSpanRaw = Math.max(
            dataNumber(activeBounds.max[0], 0) - dataNumber(activeBounds.min[0], 0),
            1.0,
          );
          const ySpanRaw = Math.max(
            dataNumber(activeBounds.max[1], 0) - dataNumber(activeBounds.min[1], 0),
            1.0,
          );
          const xyCoverageStep = worldAxisNiceStep(
            Math.max(xSpanRaw, ySpanRaw, 40.0) / WORLD_AXIS_GRID_SQUARES_PER_SIDE,
          );
          const xyCoverageExtentRaw =
            xyCoverageStep * WORLD_AXIS_GRID_SQUARES_PER_SIDE;
          const xyStep = worldAxisAdaptiveMajorStep(
            metrics.unitsPerPixel,
            xyCoverageStep,
            132.0,
            100.0,
            1.0,
          );
          const xTickCount = Math.max(
            1,
            Math.round(
              xyCoverageExtentRaw /
                Math.max(Number(xyStep) || 0.000001, 0.000001),
            ),
          );
          const yTickCount = Math.max(
            1,
            Math.round(
              xyCoverageExtentRaw /
                Math.max(Number(xyStep) || 0.000001, 0.000001),
            ),
          );
          const zCoverageStep = worldAxisNiceStep(
            Math.max(worldAxisDepthRangeRaw() / 5.0, 1000.0)
          );
          const zStep = worldAxisAdaptiveZMajorStep(
            metrics.unitsPerPixel,
            zCoverageStep,
            132.0,
            50.0,
            worldAxisZScaleFactor(),
          );
          const zLength = Math.max(Number(planeRawZ) - Number(topRawZ), 0.0);
          const zDisplayLength = Math.abs(worldAxisDisplayZ(-zLength));
          const approxZPixelLength =
            zDisplayLength / Math.max(Number(metrics.unitsPerPixel) || 0.000001, 0.000001);
          const xyMajorPixelSpan =
            xyStep / Math.max(Number(metrics.unitsPerPixel) || 0.000001, 0.000001);
          const zMajorPixelSpan =
            Math.abs(worldAxisDisplayZ(-zStep)) /
            Math.max(Number(metrics.unitsPerPixel) || 0.000001, 0.000001);
          const xyMinorSubdivision = worldAxisSubdivisionForPixelSpan(xyMajorPixelSpan);
          const zMinorSubdivision = worldAxisSubdivisionForPixelSpan(zMajorPixelSpan);
          const xyTickStep = xyStep / xyMinorSubdivision;
          const showXyStepLabels = xyMajorPixelSpan >= 86.0;
          const xMin = Math.min(0.0, xyStep * xTickCount * xDirection);
          const xMax = Math.max(0.0, xyStep * xTickCount * xDirection);
          const yMin = Math.min(0.0, xyStep * yTickCount * yDirection);
          const yMax = Math.max(0.0, xyStep * yTickCount * yDirection);
          const signature = [
            xyStep.toFixed(6),
            zStep.toFixed(6),
            xTickCount,
            yTickCount,
            xyMinorSubdivision,
            zMinorSubdivision,
            showXyStepLabels ? 1 : 0,
            worldAxisZScaleFactor().toFixed(3),
            planeRawZ.toFixed(3),
            topRawZ.toFixed(3),
            dataNumber(activeBounds.min[0], 0).toFixed(3),
            dataNumber(activeBounds.min[1], 0).toFixed(3),
            dataNumber(activeBounds.min[2], 0).toFixed(3),
            dataNumber(activeBounds.max[0], 0).toFixed(3),
            dataNumber(activeBounds.max[1], 0).toFixed(3),
            dataNumber(activeBounds.max[2], 0).toFixed(3),
          ].join("|");
          const gridAnchorRaw = worldAxisResolvedAnchorRaw(
            xyStep,
            xTickCount,
            yTickCount,
          );
          worldAxisOverlay.anchorRaw = {
            x: Number(gridAnchorRaw.x) || 0,
            y: Number(gridAnchorRaw.y) || 0,
          };
          if (worldAxisOverlay.signature === signature) {
            updateWorldAxisLabelsPosition();
            return;
          }
          const zMajorRawValues = worldAxisMajorRawZValues(planeRawZ, topRawZ, zStep);
          const zTickSpecs = worldAxisMinorTickSpecs(
            planeRawZ,
            topRawZ,
            zStep,
            zMinorSubdivision,
          );
          const labelSpecs = buildWorldAxisLabelSpecs(
            planeRawZ,
            topRawZ,
            xyStep,
            zStep,
            xTickCount,
            yTickCount,
            zMajorRawValues,
            showXyStepLabels,
          );
          worldAxisOverlay.signature = signature;
          clearWorldAxisGeometry();

          const gridPositions = [];
          const minorGridPositions = [];
          for (let xIndex = 0; xIndex <= xTickCount; xIndex += 1) {
            const xValue = xyStep * xIndex * xDirection;
            pushWorldAxisSegment(
              gridPositions,
              [xValue, yMin, 0],
              [xValue, yMax, 0],
            );
          }
          for (let yIndex = 0; yIndex <= yTickCount; yIndex += 1) {
            const yValue = xyStep * yIndex * yDirection;
            pushWorldAxisSegment(
              gridPositions,
              [xMin, yValue, 0],
              [xMax, yValue, 0],
            );
          }
          for (let xIndex = 0; xIndex <= xTickCount; xIndex += 1) {
            const xValue = xyStep * xIndex * xDirection;
            pushWorldAxisSegment(
              gridPositions,
              [xValue, yMax, 0],
              [xValue, yMax, worldAxisDisplayZ(-zLength)],
            );
          }
          for (let yIndex = 0; yIndex <= yTickCount; yIndex += 1) {
            const yValue = xyStep * yIndex * yDirection;
            pushWorldAxisSegment(
              gridPositions,
              [0, yValue, 0],
              [0, yValue, worldAxisDisplayZ(-zLength)],
            );
          }
          zTickSpecs.forEach((tickSpec) => {
            if (tickSpec.major) {
              return;
            }
            if (
              Number(tickSpec.rawZ) < 0.0 &&
              !worldAxisRawLevelMatches(tickSpec.rawZ, 0.0)
            ) {
              return;
            }
            const distanceFromPlane = Number(planeRawZ) - Number(tickSpec.rawZ);
            if (distanceFromPlane <= 0.0) {
              return;
            }
            const zValue = worldAxisDisplayZ(-distanceFromPlane);
            pushWorldAxisSegment(
              minorGridPositions,
              [xMin, yMax, zValue],
              [xMax, yMax, zValue],
            );
            pushWorldAxisSegment(
              minorGridPositions,
              [0, yMin, zValue],
              [0, yMax, zValue],
            );
          });
          zMajorRawValues.forEach((rawZValue) => {
            if (
              Number(rawZValue) < 0.0 &&
              !worldAxisRawLevelMatches(rawZValue, 0.0)
            ) {
              return;
            }
            const distanceFromPlane = Number(planeRawZ) - Number(rawZValue);
            if (distanceFromPlane <= 0.0) {
              return;
            }
            const zValue = worldAxisDisplayZ(-distanceFromPlane);
            pushWorldAxisSegment(
              gridPositions,
              [xMin, yMax, zValue],
              [xMax, yMax, zValue],
            );
            pushWorldAxisSegment(
              gridPositions,
              [0, yMin, zValue],
              [0, yMax, zValue],
            );
          });

          const axisPositions = [];
          pushWorldAxisSegment(axisPositions, [xMin, yMax, 0], [xMax, yMax, 0]);
          pushWorldAxisSegment(axisPositions, [0, yMin, 0], [0, yMax, 0]);
          pushWorldAxisSegment(
            axisPositions,
            [0, 0, 0],
            [0, 0, worldAxisDisplayZ(-zLength)],
          );
          pushWorldAxisSegment(
            axisPositions,
            [xMax, yMax, 0],
            [xMax, yMax, worldAxisDisplayZ(-zLength)],
          );
          pushWorldAxisSegment(
            axisPositions,
            [0, yMax, 0],
            [0, yMax, worldAxisDisplayZ(-zLength)],
          );
          const xyTickMinorHalf = Math.max(Math.min(xyStep * 0.03, 9.0), 3.0);
          const xyTickMajorHalf = xyTickMinorHalf * 1.6;
          for (
            let xTickIndex = 1;
            xTickIndex <= xTickCount * xyMinorSubdivision;
            xTickIndex += 1
          ) {
            const xValue = xyTickStep * xTickIndex * xDirection;
            const tickHalf =
              xTickIndex % xyMinorSubdivision === 0
                ? xyTickMajorHalf
                : xyTickMinorHalf;
            pushWorldAxisSegment(
              axisPositions,
              [xValue, yMax - tickHalf, 0],
              [xValue, yMax + tickHalf, 0],
            );
          }
          for (
            let yTickIndex = 1;
            yTickIndex <= yTickCount * xyMinorSubdivision;
            yTickIndex += 1
          ) {
