                    "MD": 510.0,
                },
                {
                    "Wellname": "FACT-2",
                    "Type": "actual",
                    "X": 0.0,
                    "Y": 100.0,
                    "Z": 0.0,
                    "MD": 0.0,
                },
                {
                    "Wellname": "FACT-2",
                    "Type": "actual",
                    "X": 100.0,
                    "Y": 100.0,
                    "Z": 500.0,
                    "MD": 510.0,
                },
            ]
        )
    )
    state = ReadOnlyWidgetState(
        {
            ptc_anticollision_params.ACTUAL_REFERENCE_MWD_UNKNOWN_NAMES_KEY: [
                "FACT-2",
                "MISSING",
            ]
        }
    )

    model_by_name = ptc_anticollision_params.reference_uncertainty_models_from_state(
        reference_wells,
