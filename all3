            offsetY: Number((options && options.offsetY) || 0),
            role: labelRole,
            text: String(text || ""),
            visible: true,
          };
          miniMapLabels.push(labelItem);
          return labelItem;
        }

        function addSceneLabel(text, position, color, extraClassName, options) {
          const labelRole = String((options && options.role) || "label");
          const roleClassNames = [];
          if (
            labelRole === "well_label" ||
            labelRole === "pilot_point_label" ||
