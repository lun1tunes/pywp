      .minimap-edit-delta-label .edit-delta-row {
        display: flex;
        justify-content: space-between;
        gap: 8px;
      }

      .minimap-edit-delta-label .edit-delta-total {
        margin-top: 3px;
        padding-top: 3px;
        border-top: 1px solid rgba(15,23,42,0.12);
        color: rgba(15,23,42,0.94);
        font-weight: 700;
      }

      .minimap-edit-position-label {
        position: absolute;
        display: none;
        min-width: 94px;
        padding: 3px 5px;
        border: 1px solid rgba(59,130,246,0.24);
        border-radius: 6px;
        background: rgba(255,255,255,0.82);
        box-shadow: 0 4px 10px rgba(15,23,42,0.08);
        color: rgba(15,23,42,0.86);
        font-family:
          "SFMono-Regular",
          ui-monospace,
          Menlo,
          Consolas,
          monospace;
        font-size: 9px;
        line-height: 1.3;
        text-align: left;
        transform: translate(10px, -100%);
